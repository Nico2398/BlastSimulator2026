{
  "name": "blastsimulator2026",
  "version": "0.1.0",
  "description": "A satirical open-pit mine management game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "console": "tsx src/console.ts",
    "validate": "tsc --noEmit && npm run test:coverage && npm run test:integration && npm run test:scenarios && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit --project scripts/tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "vitest run tests/unit/scenario-defs.test.ts",
    "test:playthrough": "vitest run tests/scenarios/level-playthroughs.test.ts --reporter=verbose",
    "test:integration": "vitest run tests/integration",
    "verify:env": "tsx scripts/verify-env.ts",
    "ci:await": "tsx scripts/await-pr-ci.ts",
    "validate:context": "tsx scripts/validate-context.ts",
    "check:i18n": "tsx scripts/check-i18n-parity.ts",
    "scenario": "tsx scripts/scenario-test.ts",
    "scenarios": "tsx scripts/run-all-scenarios.ts",
    "scenarios:interaction": "tsx scripts/run-all-scenarios.ts --mode interaction",
    "screenshot": "tsx scripts/screenshot.ts",
    "a11y": "tsx scripts/a11y-check.ts",
    "ui:diagnostic": "tsx scripts/ui-diagnostic.ts",
    "validate:state": "tsx scripts/validate-state-schema.ts"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.165.0"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/three": "^0.165.0",
    "@vitest/coverage-v8": "^1.6.1",
    "jscpd": "^4.2.4",
    "jsdom": "^29.0.0",
    "puppeteer": "^22.10.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^1.6.1"
  }
}
