{
  "name": "tutorial",
  "description": "Plays Tutorial Pit start to finish using only controls a player can click. No console command stands in for a player action — if a step cannot be completed by clicking, this fails and names the control that blocked.",
  "beats": [
    {
      "goal": "start the tutorial from a fresh Tutorial Pit",
      "setup": [
        "new_game seed:42 size:24",
        "campaign start level:tutorial_pit",
        "tutorial_start"
      ],
      "expect": {
        "tutorialStep": "time-speed"
      }
    },
    {
      "goal": "raise the game speed with the speed button",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-hud-top .bs-speed-btn"
        }
      ],
      "expect": {
        "tutorialStep": "hire-surveyor"
      }
    },
    {
      "goal": "open the Crew panel and hire a surveyor",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "do": "click",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ],
      "expect": {
        "tutorialStep": "survey",
        "increased": [
          "employeeCount"
        ],
        "blocked": ".bs-return-map",
        "note": "The tutorial is on rails: leaving for the world map mid-step is how a player loses it, so that button must be inert while the tutorial is up."
      }
    },
    {
      "goal": "the hired surveyor can actually be sent to survey",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"survey\"]"
        }
      ],
      "expect": {
        "usable": "#bs-survey-run",
        "note": "A surveyor who cannot survey is not a surveyor. If Run is disabled here, hiring grants no geology qualification and no button in the game grants one."
      }
    },
    {
      "goal": "run a survey and let the surveyor complete it",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-survey-panel [data-method=\"seismic\"]"
        },
        {
          "do": "click",
          "selector": "#bs-survey-run"
        },
        {
          "do": "pickTile",
          "x": 23,
          "z": 23
        },
        {
          "do": "click",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "do": "letTimePass",
          "ticks": 15
        }
      ],
      "expect": {
        "tutorialStep": "hire-driller"
      }
    },
    {
      "goal": "hire a driller",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "do": "click",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "expect": {
        "tutorialStep": "drill-plan"
      }
    },
    {
      "goal": "the grid tool refuses a rectangle that is not the one asked for",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "do": "click",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "do": "dragTiles",
          "x1": 22,
          "z1": 22,
          "x2": 26,
          "z2": 26
        }
      ],
      "expect": {
        "blocked": "#bs-tile-select-confirm",
        "note": "Inside the outlined square but not equal to it. The tutorial asks for exact coordinates, so Confirm must stay dead — otherwise the step teaches one layout and accepts another."
      }
    },
    {
      "goal": "lay out the drill grid on the exact coordinates asked for",
      "actions": [
        {
          "do": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 30,
          "z2": 30
        },
        {
          "do": "click",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "tutorialStep": "charge",
        "increased": [
          "holeCount"
        ]
      }
    },
    {
      "goal": "charge every hole",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "tutorialStep": "sequence",
        "increased": [
          "chargedCount"
        ]
      }
    },
    {
      "goal": "sequence the detonation delays",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "expect": {
        "tutorialStep": "blast",
        "increased": [
          "sequencedCount"
        ]
      }
    },
    {
      "goal": "fire the blast and confirm it",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "do": "clickLabel",
          "label": "Blast",
          "region": "confirm"
        }
      ],
      "expect": {
        "note": "scores step auto-advances, so the tutorial step is checked in the next beat"
      }
    },
    {
      "goal": "answer the scripted consultant event",
      "actions": [
        {
          "do": "letTimePass",
          "ticks": 2
        },
        {
          "do": "awaitUsable",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "do": "click",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "do": "click",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        }
      ],
      "expect": {
        "tutorialStep": "hire-manager"
      }
    },
    {
      "goal": "hire a manager",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "do": "click",
          "selector": "#bs-employee-panel [data-role=\"manager\"]"
        }
      ],
      "expect": {
        "tutorialStep": "contract-accept"
      }
    },
    {
      "goal": "accept a contract",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "do": "clickLabel",
          "label": "Accept",
          "region": "contracts"
        }
      ],
      "expect": {
        "tutorialStep": "hire-driver"
      }
    },
    {
      "goal": "hire a driver",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "do": "click",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "expect": {
        "tutorialStep": "vehicle-buy-assign"
      }
    },
    {
      "goal": "buy a hauler and put the hired driver in it",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "do": "click",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"]"
        },
        {
          "do": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        },
        {
          "do": "click",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        },
        {
          "do": "awaitTutorialStep",
          "stepId": "build-storage",
          "timeoutMs": 30000
        }
      ],
      "expect": {
        "tutorialStep": "build-storage",
        "note": "Deliberately does NOT force ticks. Assigning a driver only sends them walking to the vehicle; the tutorial must let its own clock run for them to arrive and board. A `tick` here would pass over exactly the deadlock that stranded players on this card, because the console can advance a clock the player's held HUD cannot."
      }
    },
    {
      "goal": "place a freight warehouse",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "do": "click",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "do": "zoomOut",
          "note": "the camera is still framed on the blast site from the earlier steps — the warehouse region sits on the opposite side of the map, so it needs to actually be on screen before it can be clicked"
        },
        {
          "do": "pickTile",
          "x": 4,
          "z": 4
        },
        {
          "do": "click",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "tutorialStep": "haul-debris",
        "increased": [
          "buildingCount"
        ]
      }
    },
    {
      "goal": "haul the blasted debris into the warehouse with the Vehicles panel's Haul button",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "do": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn"
        },
        {
          "do": "click",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn"
        },
        {
          "do": "letTimePass",
          "ticks": 20
        }
      ],
      "expect": {
        "tutorialStep": "contract-deliver",
        "note": "The reported bug: no UI control anywhere could trigger `vehicle haul`, so this is where a real player got stuck forever."
      }
    },
    {
      "goal": "deliver against the contract accepted earlier",
      "actions": [
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "do": "awaitUsable",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        },
        {
          "do": "click",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        }
      ],
      "expect": {
        "note": "finances step auto-advances; the ramp step is asserted next"
      }
    },
    {
      "goal": "carve a ramp",
      "actions": [
        {
          "do": "awaitTutorialStep",
          "stepId": "build-ramp"
        },
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "do": "click",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "do": "dragTiles",
          "x1": 4,
          "z1": 4,
          "x2": 4,
          "z2": 18
        },
        {
          "do": "click",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "do": "letTimePass",
          "ticks": 2
        }
      ],
      "expect": {
        "note": "the needs card auto-advances, so the next beat waits for set-policy rather than asserting a step here"
      }
    },
    {
      "goal": "change the site policy from Settings",
      "actions": [
        {
          "do": "awaitTutorialStep",
          "stepId": "set-policy"
        },
        {
          "do": "click",
          "selector": "#bs-toolbar [data-panel=\"settings\"]"
        },
        {
          "do": "click",
          "selector": "#bs-policy-apply"
        }
      ],
      "expect": {
        "tutorialStep": "tick-advance",
        "note": "Deliberately presses Apply without touching a control first. The form mirrors the policy already in force, so this is the path a player takes — and it used to leave the step stuck while the panel said the policy had been updated."
      }
    },
    {
      "goal": "let time run so production ticks over",
      "actions": [
        {
          "do": "letTimePass",
          "ticks": 8
        },
        {
          "do": "awaitTutorialStep",
          "stepId": [
            "victory",
            "congratulations"
          ]
        }
      ],
      "expect": {
        "increased": [
          "tickCount"
        ],
        "note": "The last thing the tutorial asks of the player is to let time run, so reaching the closing cards is the end of the guided path. Either is a correct outcome: victory hands off to the completion card as soon as the level's profit target is met, and whether that happens within these ticks is campaign economy rather than playability."
      }
    }
  ]
}
