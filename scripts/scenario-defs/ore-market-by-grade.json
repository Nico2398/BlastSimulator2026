{
  "name": "ore-market-by-grade",
  "description": "Ore grade market (#2278): at grade 0 rustite waits for a contract (no automatic sale) and the player can send it to the spoil heap from the Contracts stock view after a confirmation; on a grade 1 site rustite sells automatically and a blingite contract appears. No console command in a player step. Seed 42 yields no ore above grade 1 in its first shots, so the spoil send is shown on the stored G0 rustite; sending an above-grade ore is covered by tests/unit/console/contract-spoil.test.ts.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Grade 0 site: automatic sale takes no ore at all (#2278).",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "tier": 1,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:6 start:36,30",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 36,
          "z1": 30,
          "x2": 45,
          "z2": 39
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "G0 blast: order the pattern.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "G0 blast: the driller lands every ordered hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite stemming:2",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "G0 blast: order the charges (paid from cash as each hole is loaded).",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "role": "player"
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "G0 blast: the blaster loads every charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "blast detonate",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "description": "G0 blast: arm the sequence; the crew evacuates the pattern before it fires, so nobody is lost.",
      "timeout": 90,
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "G0 blast: the sequence evacuates the pattern and fires; the holes are consumed.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 60,
      "description": "G0 blast: Dismiss the blast report once the sequence has fired.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ]
    },
    {
      "command": "build_ramp start:12,34 end:33,34 depth:6",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "focusTile",
          "x": 23,
          "z": 34,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 12,
          "z1": 34,
          "x2": 33,
          "z2": 34
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "G0 blast: the filled 6 m holes floor the crater flat from x=34, so its foot meets the floor there.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedRampSegmentCount equals:0 max_ticks:800",
      "role": "setup",
      "description": "G0 blast: holes ordered while the ramp is open are unreachable ghosts for the driller.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedRampSegmentCount",
          "equals": 0,
          "maxTicks": 800,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "wait_until field:fillableRustiteSaleOffered equals:true max_ticks:1200",
      "role": "setup",
      "description": "Rustite is in the warehouse and a contract for it is on offer.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "fillableRustiteSaleOffered",
          "equals": true,
          "maxTicks": 1200,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "fillableRustiteSaleOffered": true,
          "blingiteSaleOffered": false
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 60,
      "description": "G0: the Contracts stock view lists rustite as waiting for a contract (automatic sale is on but takes nothing at grade 0), and the stock is still there.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-ore-stock-row=\"rustite\"][data-status=\"waiting\"]"
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "command": "contract spoil rustite confirm",
      "role": "player",
      "timeout": 60,
      "description": "G0: the player sends the rustite to the spoil heap from the stock view; the confirmation states the kg and the value lost, and confirming empties the warehouse of it. No sale is booked.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-spoil-ore=\"rustite\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "expect": {
        "decreased": [
          "collectedOreTotal"
        ],
        "increased": [
          "storedSpoilKg"
        ]
      }
    },
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42 grade:1",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42 grade:1"
        }
      ],
      "description": "Grade 1 site, same seed: rustite is now below the grade, so automatic sale takes it at once.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 1,
            "tier": 1,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:6 start:36,30",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
