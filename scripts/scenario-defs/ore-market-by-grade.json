          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "description": "G1 blast: arm the sequence; the crew evacuates the pattern before it fires, so nobody is lost.",
      "timeout": 90,
      "role": "player"
    },
