          "equals": 0,
          "maxTicks": 800,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "wait_until field:blingiteSaleOffered equals:true max_ticks:1200",
      "role": "setup",
      "description": "At grade 1 blingite is the current grade: a blingite contract is on the board, and the rustite the hauler brings in sells automatically instead of waiting.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "blingiteSaleOffered",
          "equals": true,
          "maxTicks": 1200,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "blingiteSaleOffered": true,
          "fillableRustiteSaleOffered": false
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 60,
      "description": "G1: the Contracts panel holds no rustite stock row, the ore was sold on arrival.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "screenshot"
        }
      ]
    }
  ]
