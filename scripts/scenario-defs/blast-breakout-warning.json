{
  "name": "blast-breakout-warning",
  "description": "Breakout warning (#2003): a 12 m x 10 kg Krackle hole would never break out of the ground. The Blast step's Pre-Flight list and the Pre-Flight Check modal both carry the breakout warning row, and DETONATE stays usable (a warning, not a gate).",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42 staffed:true",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42 staffed:true"
        }
      ],
      "description": "Setup: a staffed progression sandbox site with the full kit (rig that reaches 12 m).",
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan add x:36 z:32 depth:12 diameter:89",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 12
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 32
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 32
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Order the deepest hole the starting rig allows.",
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:3000",
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "description": "Drain the drill orders.",
      "expect": {
        "equals": {
          "holeCount": 1,
          "orderedHoleCount": 0
        }
      },
      "timeout": 330
    },
    {
      "command": "charge hole:* explosive:krackle amount:10 stemming:2.5",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"krackle\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 10
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2.5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "Load the most Krackle a hole accepts.",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:4500",
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 4500,
          "timeoutMs": 300000
        }
      ],
      "description": "Drain the charge orders (delivery wait included).",
      "expect": {
        "equals": {
          "chargedCount": 1,
          "orderedChargeCount": 0
        }
      },
      "timeout": 330
    },
    {
      "command": "state",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"breakout-check\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "description": "The Fire step's Pre-Flight list warns that the rock will stay in the ground, and FIRE is still usable.",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"execute\"]"
      }
    },
    {
      "command": "state",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-role=\"preflight-breakout-warning\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "description": "FIRE opens the Pre-Flight Check, which carries the same warning; DETONATE is not gated by it.",
      "expect": {
        "usable": "[data-action=\"preflight-detonate\"]"
      }
    },
    {
      "command": "blast",
      "timeout": 120,
      "role": "player",
      "description": "DETONATE fires despite the warning; the Blast Report shows the broken-out Ore Value and a separate Sealed underground figure.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "clickIfPresent",
          "selector": "[data-action=\"preflight-fire-anyway\"]",
          "timeoutMs": 8000
        },
        {
          "type": "awaitUsable",
          "selector": "[data-action=\"report-close\"]",
          "timeoutMs": 90000
        },
        {
          "type": "waitForSelector",
          "selector": "[data-info=\"report-sealed\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "[data-action=\"report-close\"]",
        "equals": {
          "holeCount": 0
        }
      }
    }
  ]
}
