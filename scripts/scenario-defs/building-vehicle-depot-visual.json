{
  "name": "building-vehicle-depot-visual",
  "description": "Visual check of vehicle depot building at all three tiers with fleet management",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build vehicle_depot at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"vehicle_depot\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -18000
        },
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build vehicle_depot at:15,5 tier:2",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"vehicle_depot\"] .bs-build-tier-sel",
          "value": "2"
        }
      ],
      "description": "role: guard (issue #515): selecting tier 2 in the catalog row's own tier dropdown is a real interaction; the Buy button is then genuinely disabled — `refreshCatalogButtons`'s `locked` check (BuildMenu.ts) is true since tier 2 is not researched — so `expect.blocked` proves the same rejection command mode shows.",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 1
        },
        "blocked": "#bs-build-panel [data-build-type=\"vehicle_depot\"] .bs-build-buy-btn",
        "note": "rejected: tier 2 not researched"
      },
      "role": "guard",
      "commandOutcome": "refused"
    },
    {
      "command": "build vehicle_depot at:25,5 tier:3",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"vehicle_depot\"] .bs-build-tier-sel",
          "value": "3"
        }
      ],
      "description": "role: guard (issue #515) — same reasoning as the tier:2 attempt above, for tier 3.",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 1
        },
        "blocked": "#bs-build-panel [data-build-type=\"vehicle_depot\"] .bs-build-buy-btn",
        "note": "rejected: tier 3 not researched"
      },
      "role": "guard",
      "commandOutcome": "refused"
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle list",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "depot-area",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "closeup",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
