{
  "name": "building-warehouse-visual",
  "description": "Visual check of warehouse buildings: explosive and freight warehouses at multiple tiers",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build explosive_warehouse at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -20000
        },
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build freight_warehouse at:10,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -15000
        },
        "equals": {
          "buildingCount": 2
        }
      }
    },
    {
      "command": "build explosive_warehouse at:20,5 tier:2",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-tier-sel",
          "value": "2"
        }
      ],
      "description": "role: guard (issue #515): selecting tier 2 in the catalog row's own tier dropdown is a real interaction; the Buy button is then genuinely disabled — `refreshCatalogButtons`'s `locked` check (BuildMenu.ts) is true since tier 2 is not researched.",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 2
        },
        "blocked": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn",
        "note": "rejected: tier 2 not researched"
      },
      "role": "guard"
    },
    {
      "command": "build freight_warehouse at:25,5 tier:2",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-tier-sel",
          "value": "2"
        }
      ],
      "description": "role: guard (issue #515) — same reasoning as the explosive_warehouse tier:2 attempt above.",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 2
        },
        "blocked": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn",
        "note": "rejected: tier 2 not researched"
      },
      "role": "guard"
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "warehouse-area",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "closeup",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
