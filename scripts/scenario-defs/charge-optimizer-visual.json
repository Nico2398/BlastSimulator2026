{
  "name": "charge-optimizer-visual",
  "description": "#2204: the Charge Optimizer. Locked hint without software; after buying tier 4 the player optimizes the pattern, reads the proposal and applies it to all holes. Player clicks only.",
  "steps": [
    {
      "command": "new_game seed:42 staffed:true cash:190000",
      "timeout": 30,
      "description": "Staffed opening (#551): a driller with blasting + drill_rig licence, a blaster, plus a charging truck (#1649: charge_hole is worked from a truck by a blasting + truck-licensed driver), plus an unmanned drill_rig, are hired/purchased for free at game-open — #553's automatic drill dispatch needs both to ever land an ordered hole.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 staffed:true cash:190000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:2 cols:3 spacing:4 depth:6 start:15,15",
      "description": "The grid tool's spacing stepper defaults to 3m (DEFAULT_SPACING_M, Drill.ts); one increment click on the strip's spacing stepper (data-field=\"spacing\") raises it to 4 before dragging, so the (15,15)-(23,19) rectangle (8x4) computes the declared 3 cols x 2 rows instead of the default-spacing 4x2 (issue #479 follow-up, Finding #4). #553: confirming the grid queues 6 drill_hole PendingActions and pushes 6 PlannedHoles into plannedDrillHoles — none are drilled yet, so holeCount stays 0 right after confirm.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 23,
          "z2": 19
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 6,
          "holeCount": 0
        },
        "note": "2 rows x 3 cols = 6 holes ordered (ghosts), none drilled yet (#553)"
      }
    },
    {
      "command": "wait_until field:holeCount equals:6 max_ticks:300",
      "description": "#553: drain the ordered plan -- the staffed driller/drill_rig lands all 6 holes. #1339: wait on the 6th hole landing instead of a fixed 130-tick pad: payroll runs every tick, and the extra licences now held by the staffed drivers raise it enough that the idle pad left too little cash for the later 8 kg recharge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 6,
          "maxTicks": 300,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 6
        },
        "note": "All 6 holes have landed — none lost, none left ordered forever."
      },
      "timeout": 125
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "player",
      "description": "#2204: without the Charge Optimizer software the Charge step offers no Optimize button; it names the software instead.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"optimizer-locked\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"select-explosive\"]"
      }
    },
    {
      "command": "buy_software tier:1",
      "role": "player",
      "description": "#2204: the player buys software tier 1 by clicking its Buy button in the Preview step.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"1\"] [data-action=\"buy-tier\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "buy_software tier:2",
      "role": "player",
      "description": "#2204: the player buys software tier 2 by clicking its Buy button in the Preview step.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"2\"] [data-action=\"buy-tier\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "buy_software tier:3",
      "role": "player",
      "description": "#2204: the player buys software tier 3 by clicking its Buy button in the Preview step.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"3\"] [data-action=\"buy-tier\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "buy_software tier:4",
      "role": "player",
      "description": "#2204: the player buys software tier 4 by clicking its Buy button in the Preview step.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"4\"] [data-action=\"buy-tier\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "player",
      "description": "#2204: with the optimizer owned, the Charge step shows Optimize charges; the player clicks it and reads the proposal (band mix, cost, permit kg) before anything is ordered.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"optimize-charges\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"charge-proposal\"] [data-role=\"proposal-band-mix\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"proposal-cost\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"proposal-permit-kg\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"proposal-hole\"] [data-action=\"apply-proposal-hole\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 0
        }
      }
    },
    {
      "command": "optimize_charges apply:true",
      "role": "player",
      "description": "#2204: the player applies the proposal to every hole with one click.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"apply-proposal\"]"
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 0
        }
      }
    },
    {
      "command": "wait_until field:chargedCount equals:6 max_ticks:3000",
      "timeout": 125,
      "role": "setup",
      "description": "Drain the six charge orders the proposal placed.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 6,
          "maxTicks": 3000,
          "timeoutMs": 120000
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 6
        }
      }
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "player",
      "description": "#2204: every hole now carries the proposed charge; its row shows the powder factor and band mix.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-hole][data-charged=\"true\"] [data-role=\"hole-band-mix\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 6
        }
      }
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
