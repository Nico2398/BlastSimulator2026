{
  "name": "charge-needs-truck",
  "description": "#1649: a charge order is worked from a charging truck driven by an employee holding blasting + the truck licence. On a bare site without a truck the order stays blocked with no_vehicle_in_fleet and nothing is charged; buying a charging truck lets the same order land.",
  "steps": [
    {
      "command": "new_game seed:42 cash:200000",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:200000"
        }
      ],
      "description": "Bare new site (#1649): no staffed roster and no fleet, so charging has to find a truck and a dual-qualified employee on its own.",
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 200000,
          "vehicleCount": 0,
          "employeeCount": 0
        }
      }
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1
        }
      },
      "description": "Hire the one employee who will drill and charge."
    },
    {
      "command": "employee assign_skill 1 skill:blasting level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:blasting level:5"
        }
      ],
      "description": "Blasting proficiency for the hire.",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "vehicle buy drill_rig",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy the drill rig (the only vehicle for now - no charging truck).",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:driving.drill_rig level:1",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.drill_rig level:1"
        }
      ],
      "description": "Drill-rig licence so the hire can drill.",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:driving.truck level:1",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.truck level:1"
        }
      ],
      "description": "Truck licence: with blasting, the hire is dual-qualified for the charging truck (#1649).",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:6 start:18,10 diameter:0.089",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 3
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 18,
          "z1": 10,
          "x2": 18,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 1,
          "holeCount": 0
        }
      },
      "description": "Order one hole."
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:600",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 120000
        }
      ],
      "description": "Wait for the driller to drill the ordered hole.",
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 1
        }
      },
      "timeout": 125
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Defensive: a `tick N` step silently completes fewer ticks than requested if a random event fires mid-wait, and every subsequent tick then refuses until the event is resolved. No-op when nothing is pending.",
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "charge hole:* explosive:boomite amount:3 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 3
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"][data-selected=\"true\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "3 kg"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "2.0 m"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "Order the charge. It queues (cash paid, planned charge recorded) but needs a charging truck (#1649).",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "role": "player"
    },
    {
      "command": "tick 30",
      "interaction": [
        {
          "type": "command",
          "command": "tick 30"
        }
      ],
      "description": "With no charging truck in the fleet the order stays blocked for good: no_vehicle_in_fleet, nothing charged, nobody walks to the hole (#1649).",
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 0,
          "orderedChargeCount": 1,
          "chargeOrderBlockedReason": "no_vehicle_in_fleet"
        }
      }
    },
    {
      "command": "vehicle buy charging_truck",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"charging_truck\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"charging_truck\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy a charging truck (tier 1) from the vehicle panel; the blocked charge order can now be worked.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "changedBy": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 120000
        }
      ],
      "description": "The dual-qualified employee boards the charging truck, drives to the hole and charges it.",
      "role": "setup",
      "expect": {
        "increased": [
          "chargedCount"
        ],
        "equals": {
          "chargedCount": 1,
          "orderedChargeCount": 0,
          "chargeOrderBlockedReason": null
        }
      },
      "timeout": 125
    }
  ]
}
