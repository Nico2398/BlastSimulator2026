{
  "name": "needs-cost-visual",
  "description": "Visual check of need costs: after draining gauges and building living_quarters, advance ticks to trigger rest visits; verify finances output shows cash deductions for rest costs (hunger rest costs $50, break need rest costs $20, fatigue rest is free) and cash decreases accordingly",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "employeeCount": 0
        }
      }
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 49000,
          "employeeCount": 1
        }
      }
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 100",
      "interaction": [
        {
          "type": "command",
          "command": "tick 100"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash", "minFatigue"]
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "command",
          "command": "event choose 0"
        }
      ],
      "description": "event choose 0 -- follows a bare tick, so whether an event is pending is a random roll; there may be no dialog on screen. Deliberately left unmarked: a player step must name a control that is actually there, and forcing a click here would fail on the roll rather than on a defect."
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build living_quarters at:10,10",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "tick 20",
      "interaction": [
        {
          "type": "command",
          "command": "tick 20"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash", "minFatigue"]
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "command",
          "command": "event choose 0"
        }
      ],
      "description": "event choose 0 -- follows a bare tick, so whether an event is pending is a random roll; there may be no dialog on screen. Deliberately left unmarked: a player step must name a control that is actually there, and forcing a click here would fail on the roll rather than on a defect."
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "note": "by 170 total ticks, minFatigue has dropped low enough that rest visits begin — finances shows a real 'needs' expense category (Rest: hunger, $50 each) confirming this file's own claimed premise"
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "command",
          "command": "event choose 0"
        }
      ],
      "description": "event choose 0 -- follows a bare tick, so whether an event is pending is a random roll; there may be no dialog on screen. Deliberately left unmarked: a player step must name a control that is actually there, and forcing a click here would fail on the roll rather than on a defect."
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "finances-panel",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "cost-details",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
