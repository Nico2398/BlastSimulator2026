{
  "name": "building-tier-system-visual",
  "description": "Visual check of building tier upgrade system from T1 to T3 and demolition, driven by clicking the real Build panel controls — placement, Queue Research, Upgrade, and Demolish — not console shortcuts",
  "steps": [
    {
      "command": "new_game seed:42 cash:200000",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:200000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 200000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build research_center at:25,15",
      "description": "Placed first — a research_center is a hard prerequisite (#442) to queue any research task below.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 25,
          "z": 15
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 175000,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build living_quarters at:5,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for living_quarters and picking the tile. The Build panel is already open from the research_center step above — re-clicking the toolbar toggle here would close it (UIManager.togglePanel), so this step goes straight to the catalog row.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 165000,
          "buildingCount": 2
        }
      }
    },
    {
      "command": "research queue type:living_quarters tier:2",
      "description": "Queued by clicking the placed building's real 'Queue Research' button — the only in-game path to unlock tier 2, not a console shortcut. Building #2 (research_center placed above is #1).",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-research-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 160000
        }
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build upgrade 2",
      "description": "Upgraded by clicking the placed building's Upgrade button, now enabled because tier 2 finished researching.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-upgrade-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 2
        },
        "note": "upgrade replaces the building (new id #3), it doesn't add one — buildingCount stays 2. cash uses decreased not equals since this follows a tick step (Finding #12)"
      }
    },
    {
      "command": "research queue type:living_quarters tier:3",
      "description": "Queued by clicking the upgraded building's (now #3) real 'Queue Research' button.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-research-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"]
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build upgrade 3",
      "description": "Upgraded to tier 3 by clicking the Upgrade button on building #3, now enabled because tier 3 finished researching.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-upgrade-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 2
        },
        "note": "upgrade replaces the building again (new id #4) — buildingCount stays 2"
      }
    },
    {
      "command": "build management_office at:15,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for management_office and picking the tile.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 3
        }
      }
    },
    {
      "command": "build destroy 5",
      "description": "Demolished by clicking building #5's (management_office) Demolish button.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"5\"] .bs-build-demolish-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"5\"] .bs-build-demolish-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 2
        },
        "note": "demolishing has a $2,000 cost of its own"
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "tier-comparison",
      "yaw": 90,
      "pitch": 15
    },
    {
      "name": "closeup-t3",
      "yaw": 45,
      "pitch": 30
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
