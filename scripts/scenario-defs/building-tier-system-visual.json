{
  "name": "building-tier-system-visual",
  "description": "Visual check of building tier upgrade system from T1 to T3 and demolition, driven by clicking the real Build panel controls — placement, Upgrade, and Demolish — not console shortcuts. Upgrades are in-place construction needing no vehicle (#1875); only demolition needs a Building Destroyer (#1392).",
  "steps": [
    {
      "command": "new_game seed:42 cash:330000 staffed:true",
      "timeout": 40,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:330000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 330000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build living_quarters at:2,8 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for living_quarters and picking the tile. #1008: relocated from (2,6) to (2,8) -- (2,6)'s tier 1 (3x3) footprint is flat, but the tier 2 (4x3) and tier 3 (5x4) footprints it grows into downstream are not, which fails the tier-3 upgrade step below with 'Uneven surface' (a grown-cells edge case, since a tier upgrade never moves the building). (2,8) is flat for the base footprint and every upgraded tier's larger footprint.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 8
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -10000
        },
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for it to actually land before referring to its building id."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:300",
      "description": "Drive the living_quarters site to completion (#556) before anything below depends on a real, numbered building (it lands as #1). Speeds up via a real click on the HUD's 8x button before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build upgrade 1",
      "description": "Upgraded by clicking the placed building's (living_quarters, #1) Upgrade button; plain sites have no quests, so every tier is purchasable at once. No Building Destroyer exists yet (#1875).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row:nth-child(1) .bs-build-row-name"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 1
        },
        "note": "An upgrade is in-place construction (#1875): charged now, no Building Destroyer, no demolition. The building keeps standing under the SAME id, so buildingCount stays 1."
      }
    },
    {
      "command": "wait_until field:maxBuildingTier equals:2 max_ticks:900",
      "description": "Wait for the crew to upgrade living_quarters #1 in place to tier 2 under the same id (#1875).",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "maxBuildingTier",
          "equals": 2,
          "maxTicks": 900,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "maxBuildingTier": 2
        }
      }
    },
    {
      "command": "build upgrade 1",
      "description": "Upgraded by clicking the placed building's (living_quarters, #1) Upgrade button; plain sites have no quests, so every tier is purchasable at once. No Building Destroyer exists yet (#1875).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row:nth-child(1) .bs-build-row-name"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 1
        },
        "note": "An upgrade is in-place construction (#1875): charged now, no Building Destroyer, no demolition. The building keeps standing under the SAME id, so buildingCount stays 1."
      }
    },
    {
      "command": "wait_until field:maxBuildingTier equals:3 max_ticks:1200",
      "description": "Wait for the second in-place upgrade to land living_quarters #1 at tier 3 (#1875).",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "maxBuildingTier",
          "equals": 3,
          "maxTicks": 1200,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "maxBuildingTier": 3
        }
      }
    },
    {
      "command": "build management_office at:14,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for management_office and picking the tile.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 14,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for it to actually land before referring to its building id."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:2 max_ticks:300",
      "description": "Drive the management_office site to completion (#556) before demolishing it by id. Speeds up via a real click on the HUD's 8x button before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 2,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 2,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "vehicle buy building_destroyer tier:1",
      "description": "Demolition is Building Destroyer work (#1392); upgrades are not (#1875). Bought only now, just before the demolish step, through the Fleet panel's real dealership button. The staffed roster already holds a truck-licensed driver to crew it.",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "vehicles"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        }
      ],
      "expect": {
        "increased": [
          "vehicleCount"
        ],
        "changedBy": {
          "cash": -30000
        }
      }
    },
    {
      "command": "build destroy 2",
      "description": "Demolished by clicking building #2's (management_office) Demolish button; the Building Destroyer carries it out.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row:nth-child(2) .bs-build-row-name"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector [data-action=\"demolish\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector [data-action=\"demolish\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "demolishing has a $2,000 cost of its own, charged now; the building goes only when the Wrecking Rascal finishes"
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:900",
      "description": "Wait for the Wrecking Rascal to finish demolishing management_office #2.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 900,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
