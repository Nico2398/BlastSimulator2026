{
  "name": "building-tier-system-visual",
  "description": "Visual check of building tier upgrade system from T1 to T3 and demolition, driven by clicking the real Build panel controls \u2014 placement, Queue Research, Upgrade, and Demolish \u2014 not console shortcuts",
  "steps": [
    {
      "command": "new_game seed:42 cash:260000 staffed:true",
      "timeout": 40,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:260000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 260000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build research_center at:25,15",
      "description": "Placed first \u2014 a research_center is a hard prerequisite (#442) to queue any research task below.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 25,
          "z": 15
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -25000
        },
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for both orders (this one and the living_quarters order below) to actually land before referring to their building ids."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:300",
      "description": "Drive the research_center site to completion (#556) before the living_quarters order below is even placed. Building ids are assigned in construction-completion order, not order-placed order (#556-followup) — without this wait, closest-hire-wins dispatch can let living_quarters finish first and take id #1, which would make every hardcoded `data-building-id`/`build upgrade N` reference below (assuming living_quarters is #2) point at the wrong building. This synthetic wait forces research_center to land as #1 deterministically.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build living_quarters at:5,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for living_quarters and picking the tile. The Build panel is already open from the research_center step above \u2014 re-clicking the toolbar toggle here would close it (UIManager.togglePanel), so this step goes straight to the catalog row.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -10000
        },
        "note": "Confirming placement only queues a construction site (#556) \u2014 the next step waits for both orders above to actually land before referring to their building ids."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:2 max_ticks:300",
      "description": "Drive both the research_center and living_quarters sites to completion (#556) before anything below depends on a real, numbered building. Speeds up via a real click on the HUD's 8x button (same real control the wait leans on, not a bare tick) before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 2,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 2,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "research queue type:living_quarters tier:2",
      "description": "Queued by clicking the placed building's real 'Queue Research' button \u2014 the only in-game path to unlock tier 2, not a console shortcut. Building #2 (#556-followup: ids are assigned in construction-completion order, not order-placed order \u2014 but this test file's own `driveConstructionOrders` harness forces the research_center order above to finish and be waited on (a synthetic `wait_until buildingCount:1`) before the living_quarters order is even placed, so research_center always lands as #1 and living_quarters as #2, not the closest-hire-wins ordering a real, concurrently-staffed run would produce).",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-research-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -5000
        }
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build upgrade 2",
      "description": "Upgraded by clicking the placed building's (living_quarters, #2 \u2014 see the research-queue step above) Upgrade button, now enabled because tier 2 finished researching.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"2\"] .bs-build-upgrade-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "upgrade replaces the building (new id #3), it doesn't add one \u2014 buildingCount stays 2. cash uses decreased not equals since this follows a tick step (Finding #12)"
      }
    },
    {
      "command": "research queue type:living_quarters tier:3",
      "description": "Queued by clicking the upgraded building's (now #3) real 'Queue Research' button.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-research-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build upgrade 3",
      "description": "Upgraded to tier 3 by clicking the Upgrade button on building #3, now enabled because tier 3 finished researching.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"3\"] .bs-build-upgrade-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "upgrade replaces the building again (new id #4) \u2014 buildingCount stays 2"
      }
    },
    {
      "command": "build management_office at:15,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for management_office and picking the tile.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "note": "Confirming placement only queues a construction site (#556) \u2014 the next step waits for it to actually land before referring to its building id."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:3 max_ticks:300",
      "description": "Drive the management_office site to completion (#556) before demolishing it by id. Speeds up via a real click on the HUD's 8x button before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 3,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 3,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build destroy 5",
      "description": "Demolished by clicking building #5's (management_office) Demolish button.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-building-id=\"5\"] .bs-build-demolish-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-building-id=\"5\"] .bs-build-demolish-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "demolishing has a $2,000 cost of its own"
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "tier-comparison",
      "yaw": 90,
      "pitch": 15
    },
    {
      "name": "closeup-t3",
      "yaw": 45,
