{
  "name": "blast-voxel-fragmentation",
  "description": "Visual verification of voxel fragmentation: before/after terrain, crater formation, bench levels, isolated islands",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "drill_plan grid rows:4 cols:4 spacing:4 depth:8 start:14,14",
      "description": "One increment click on the spacing stepper (data-field=\"spacing\") raises it 3->4m (DEFAULT_SPACING_M, Drill.ts) before dragging, so the (14,14)-(26,26) rectangle computes the declared 4x4 instead of the default-spacing 5x5 (issue #479 follow-up, Finding #4).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 14,
          "z1": 14,
          "x2": 26,
          "z2": 26
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 16
        },
        "note": "4 rows x 4 cols = 16"
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 16
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 16
        }
      }
    },
    {
      "command": "blast",
      "timeout": 20,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"5\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        },
        "note": "a fired blast clears the plan back to zero"
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 14,14,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 14,14,0"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 14,14,1",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 14,14,1"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 14,14,2",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 14,14,2"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "crater-top",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "crater-side",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "crater-diagonal",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
