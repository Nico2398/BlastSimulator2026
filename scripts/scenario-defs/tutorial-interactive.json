{
  "name": "tutorial-interactive",
  "description": "Plays the Tutorial Pit the way a first-time player does: every step is driven by a real click on the control the tutorial card points at — speed button, toolbar, hire buttons, blast panel, event choices — so each screenshot shows the coach mark, the highlighted target and the panel together. Steps that wait on the simulation (survey run, box cut dug, driver walking, debris hauled) advance the clock with an explicit `tick`, because `?scenarioMode=1` turns off the real-time auto-tick and a wall-clock `wait` never moves the sim.",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 size:24",
      "timeout": 30,
      "description": "Setup: the Tutorial menu button creates a 24-wide game before starting the level",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:24"
        }
      ]
    },
    {
      "command": "campaign start level:tutorial_pit",
      "timeout": 30,
      "description": "Setup: load Tutorial Pit — camera must re-frame onto the smaller grid",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:tutorial_pit"
        }
      ]
    },
    {
      "command": "tutorial_start",
      "timeout": 30,
      "description": "Step 0 (Game Speed): coach mark docked bottom-centre, speed button glowing, mine still visible",
      "interaction": [
        {
          "type": "command",
          "command": "tutorial_start"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tutorial-overlay"
        }
      ]
    },
    {
      "command": "time speed:2",
      "timeout": 30,
      "description": "Step 0 complete: real click on the speed button cycles 1x to 2x, card advances to Hire Surveyor",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "employee hire role:surveyor",
      "timeout": 30,
      "description": "Step 1 (Hire Surveyor): follow the glowing Crew button, then Hire in the crew panel — the card must not swallow the click",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Step 2 (Survey Terrain): Survey toolbar button glowing, survey panel opens",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"survey\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "survey seismic x:23 z:23",
      "timeout": 60,
      "description": "Step 2 complete: pick seismic (the method the card names), pick a target inside the survey region with the tile picker, dispatch — then advance the clock so the surveyor walks out and completes it",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-survey-panel [data-method=\"seismic\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-run"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 23,
          "z": 23
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "command",
          "command": "tick 15"
        },
        {
          "type": "wait",
          "durationMs": 600
        }
      ]
    },
    {
      "command": "employee hire role:driller",
      "timeout": 30,
      "description": "Step 3 (Hire Driller): driller hired through the crew panel",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "build_ramp start:16,19 end:16,31 depth:8",
      "timeout": 60,
      "description": "Step 4 (Box Cut): open Build, pick the ramp tool, drag the starter cut down the west side of the pattern, confirm — then let the cut get dug. Real pits dig this void before the first shot so the blasted rock has somewhere to fall.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 16,
          "z1": 19,
          "x2": 16,
          "z2": 31
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "command",
          "command": "tick 3"
        },
        {
          "type": "wait",
          "durationMs": 400
        }
      ]
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:5 depth:8 start:20,20",
      "timeout": 30,
      "description": "Step 5 (Drill Plan): open Blast, pick the grid tool, drag the exact 20,20→30,30 rectangle the card asks for, confirm — 9 holes with X-ray shafts on the bench",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 30,
          "z2": 30
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 400
        }
      ]
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "timeout": 30,
      "description": "Step 6 (Charge): Charge All Holes clicked — the panel applies its own form defaults and hole rows turn green",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "sequence auto delay_step:25",
      "timeout": 30,
      "description": "Step 7 (Sequence): Auto Sequence clicked, delay labels appear on every hole",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "blast",
      "timeout": 60,
      "description": "Step 8 (Blast): Execute clicked, confirm dialog answered, crater and fragments appear — rock breaking toward the box cut",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay:not(#bs-event-dialog) .bs-btn-danger"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay:not(#bs-event-dialog) .bs-btn-danger"
        },
        {
          "type": "wait",
          "durationMs": 900
        }
      ]
    },
    {
      "command": "scores",
      "timeout": 30,
      "description": "Step 9 (Scores Overview): score bars moved by the blast, card auto-advances",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        },
        {
          "type": "wait",
          "durationMs": 2500
        }
      ]
    },
    {
      "command": "tick 1",
      "timeout": 60,
      "description": "Step 10 (Events): the tutorial fires the scripted consultant event itself when the step opens; wait for the dialog to appear",
      "interaction": [
        {
          "type": "command",
          "command": "tick 1"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-event-dialog .bs-event-choice"
        }
      ]
    },
    {
      "command": "event choose 0",
      "timeout": 30,
      "description": "Answer the consultant through the dialog, read the outcome line, then dismiss so the site is playable again",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ]
    },
    {
      "command": "employee hire role:manager",
      "timeout": 30,
      "description": "Step 11 (Hire Manager): manager hired now that the event is resolved",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"manager\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "contract accept 1",
      "timeout": 30,
      "description": "Step 12 (Accept Contract): Accept clicked on the first offer in the Contracts panel",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "employee hire role:driver",
      "timeout": 30,
      "description": "Step 13 (Hire Driver): driver hired through the crew panel",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "vehicle buy debris_hauler",
      "timeout": 30,
      "description": "Step 14a (Buy Hauler): Vehicles panel open, hauler bought and placed on the terrain surface",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "vehicle driver 1 4",
      "timeout": 60,
      "description": "Step 14b (Assign Driver): driver assigned from the Vehicles panel, then the clock advances so the driver walks to the hauler and boards it",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        },
        {
          "type": "command",
          "command": "tick 30"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ]
    },
    {
      "command": "build freight_warehouse at:4,4",
      "timeout": 30,
      "description": "Step 15 (Build Storage): warehouse placed by picking a tile inside the build region in the Build panel picker",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 4,
          "z": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ]
    },
    {
      "command": "vehicle haul 1 fragment:1",
      "timeout": 90,
      "description": "Step 16 (Haul Debris): the Vehicles panel's Haul button dispatches the hauler at the blasted rock; advance the clock so it drives out, loads, and returns to the depot — stored mass rising is what advances the card",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn"
        },
        {
          "type": "command",
          "command": "tick 40"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ]
    },
    {
      "command": "contract deliver 1 amount:5000",
      "timeout": 60,
      "description": "Step 17 (Deliver Contract): deliver the hauled stock against the contract accepted at step 12",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        },
        {
          "type": "command",
          "command": "tick 5"
        },
        {
          "type": "wait",
          "durationMs": 800
        }
      ]
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Steps 18-19 (Finances, Needs): both cards auto-advance on their own timer once delivery lands — give them wall-clock time to pass before the next click",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "wait",
          "durationMs": 8000
        }
      ]
    },
    {
      "command": "set_policy mode:shift_8h",
      "timeout": 30,
      "description": "Step 20 (Set Policy): shift schedule changed from the Settings panel",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"settings\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-policy-apply"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-policy-apply"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ]
    },
    {
      "command": "tick 6",
      "timeout": 60,
      "description": "Step 21 (Let Time Run): advance the clock more than 5 ticks so production ticks over",
      "interaction": [
        {
          "type": "command",
          "command": "tick 6"
        },
        {
          "type": "wait",
          "durationMs": 400
        }
      ]
    },
    {
      "command": "campaign complete",
      "timeout": 30,
      "description": "Step 22 complete: level ends, card shows Tutorial Complete",
      "interaction": [
        {
          "type": "command",
          "command": "campaign complete"
        },
        {
          "type": "wait",
          "durationMs": 600
        }
      ]
    },
    {
      "command": "campaign status",
      "timeout": 30,
      "description": "Final: the congratulations card dismisses itself and the game is unpaused",
      "interaction": [
        {
          "type": "command",
          "command": "campaign status"
        },
        {
          "type": "wait",
          "durationMs": 2000
        }
      ]
    }
  ]
}
