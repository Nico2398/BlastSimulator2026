{
  "name": "tutorial-interactive",
  "description": "Plays the Tutorial Pit the way a first-time player does: every step is driven by a real click on the control the tutorial card points at — speed button, toolbar, hire buttons, blast panel, event choices — and each beat waits for the tutorial's own rails to advance (waitForTutorialStep) before the next click, mirroring the playtest definition's click path (seismic survey at 23,23; the box cut dug down the west face before the drill grid; drill grid on the exact 20,20-30,30 rectangle; haul before deliver). Every tutorial-facing step is role-marked 'player' or 'setup' (issue #479): a player step's interaction may not fall back to a console command, so a step that cannot actually be clicked fails the scenario instead of passing on a typed shortcut.",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 size:24",
      "timeout": 30,
      "description": "Setup: the Tutorial menu button creates this exact game before starting the level (main.ts setOnTutorial)",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:24"
        }
      ]
    },
    {
      "command": "campaign start level:tutorial_pit",
      "timeout": 30,
      "description": "Setup: load Tutorial Pit — the level regenerates the terrain at its own size and re-frames the camera",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:tutorial_pit"
        }
      ]
    },
    {
      "command": "tutorial_start",
      "timeout": 30,
      "description": "Step time-speed: coach mark docked bottom-centre, speed button glowing, mine still visible",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "tutorial_start"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tutorial-overlay"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "time-speed"
        }
      ]
    },
    {
      "command": "time speed:2",
      "timeout": 30,
      "description": "time-speed complete: real click on the speed button cycles 1x to 2x, card advances to Hire Surveyor",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "hire-surveyor"
        }
      ]
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Player follows the glowing Crew button — the tutorial card must not swallow the click",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ]
    },
    {
      "command": "employee hire role:surveyor",
      "timeout": 30,
      "description": "hire-surveyor complete: Hire clicked in the crew panel, surveyor appears on site",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "survey"
        }
      ]
    },
    {
      "command": "employee assign_skill 1 skill:geology level:3",
      "timeout": 30,
      "description": "Test-only bootstrap, not a tutorial stage: hiring already grants Rookie geology (ROLE_STARTING_QUALIFICATION in Employee.ts, same for the UI hire button and this console command), so this only raises the level for tighter survey estimates. No role tag — there is no UI control for this and none should exist; the player-facing way to raise a skill is `employee train` at a training building, which this scenario does not need. Command mode keeps running it unchanged; interaction mode keeps it as an unmarked (legacy) command step.",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:geology level:3"
        }
      ]
    },
    {
      "command": "survey seismic x:23 z:23",
      "timeout": 90,
      "description": "survey complete: seismic (the method the card names), target picked inside the step's outlined region (18..28), dispatched, and the surveyor walks out and works it. waitForTutorialStep drives the real clock for the walk — no scripted `tick` needed once a click starts it.",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"survey\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-panel [data-method=\"seismic\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-run"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 23,
          "z": 23
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "hire-driller",
          "timeout": 60000
        }
      ]
    },
    {
      "command": "employee hire role:driller",
      "timeout": 30,
      "description": "hire-driller complete: driller hired through the crew panel",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "box-cut"
        }
      ]
    },
    {
      "command": "build_ramp start:16,19 end:16,31 depth:8",
      "timeout": 90,
      "description": "box-cut complete: dig the starter cut down the west face of the drill pattern before the first shot, so the blasted rock has a free face and a void to fall into (real open pits pioneer this access cut first). waitForTutorialStep drives the real clock — no scripted `tick` needed.",
      "role": "player",
      "interaction": [
        {
          "type": "waitForTutorialStep",
          "stepId": "box-cut",
          "timeout": 30000
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 16,
          "z1": 19,
          "x2": 16,
          "z2": 31
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "drill-plan",
          "timeout": 30000
        }
      ]
    },
    {
      "command": "employee assign_skill 2 skill:blasting level:3",
      "timeout": 30,
      "description": "Test-only bootstrap, not a tutorial stage — see the geology assign_skill step above for why this stays an unmarked (legacy) command step in interaction mode too.",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 2 skill:blasting level:3"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:5 depth:6 start:20,20",
      "timeout": 60,
      "description": "drill-plan complete: grid tool dragged over the exact 20,20-30,30 rectangle the card asks for (spacing 5 makes 3x3 holes), confirmed",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 30,
          "z2": 30
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "charge"
        }
      ]
    },
    {
      "command": "charge hole:* explosive:pop_rock amount:3 stemming:2",
      "timeout": 30,
      "description": "charge complete: Charge All Holes clicked — the panel applies its own form defaults and hole rows turn green",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "sequence"
        }
      ]
    },
    {
      "command": "sequence auto",
      "timeout": 30,
      "description": "sequence complete: Auto Sequence clicked, delay labels appear on every hole",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "blast"
        }
      ]
    },
    {
      "command": "blast",
      "timeout": 90,
      "description": "blast complete: Execute clicked, confirm dialog answered, crater and fragments appear, Blast Report closed; the scores card then auto-advances into the scripted consultant event",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": [
            "scores",
            "event-fire-resolve",
            "hire-manager"
          ],
          "timeout": 60000
        }
      ]
    },
    {
      "command": "event choose 0",
      "timeout": 60,
      "description": "event-fire-resolve complete: the consultant dialog is answered through its own buttons, outcome read, then dismissed",
      "role": "player",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-event-dialog .bs-event-choice",
          "timeout": 30000
        },
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "hire-manager"
        }
      ]
    },
    {
      "command": "employee hire role:manager",
      "timeout": 30,
      "description": "hire-manager complete: manager hired now that the event is resolved",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"manager\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "contract-accept"
        }
      ]
    },
    {
      "command": "contract accept 1",
      "timeout": 30,
      "description": "contract-accept complete: Accept clicked on the first offer in the Contracts panel",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "hire-driver"
        }
      ]
    },
    {
      "command": "employee hire role:driver",
      "timeout": 30,
      "description": "hire-driver complete: driver hired through the crew panel",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "vehicle-buy-assign"
        }
      ]
    },
    {
      "command": "employee assign_skill 4 skill:driving.truck level:3",
      "timeout": 30,
      "description": "Test-only bootstrap, not a tutorial stage — see the geology assign_skill step above; hiring already grants Rookie driving.truck, this only raises the level. Kept for command mode, which needs it for its own explicit `vehicle driver 1 4` to succeed identically.",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 4 skill:driving.truck level:3"
        }
      ]
    },
    {
      "command": "vehicle buy debris_hauler",
      "timeout": 30,
      "description": "vehicle-buy-assign, first half: Vehicles panel open, tier-1 hauler bought and placed on the terrain surface",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        }
      ]
    },
    {
      "command": "vehicle driver 1 4",
      "timeout": 90,
      "description": "vehicle-buy-assign complete: Assign clicked, then the tutorial's own clock runs while the driver walks to the vehicle and boards — the #478 deadlock path, exercised for real",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-assign-btn"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "build-storage",
          "timeout": 60000
        }
      ]
    },
    {
      "command": "build freight_warehouse at:4,4",
      "timeout": 60,
      "description": "build-storage complete: warehouse placed by clicking a tile inside the step's region (2..9) in the Build panel picker",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 4,
          "z": 4
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "haul-debris"
        }
      ]
    },
    {
      "command": "vehicle haul 1 fragment:1",
      "timeout": 90,
      "description": "haul-debris complete: the Vehicles panel's Haul button sends the hauler to a reachable fragment, and stored mass grows once it unloads at the warehouse. waitForTutorialStep drives the real clock for the haul — no scripted `tick` needed.",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn",
          "timeout": 30000
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-vehicle-haul-btn"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "contract-deliver",
          "timeout": 60000
        }
      ]
    },
    {
      "command": "contract deliver 1 amount:5000",
      "timeout": 90,
      "description": "contract-deliver complete: Deliver clicked with the panel's own pre-filled remaining amount, finishing the contract accepted earlier; the finances card then auto-advances",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-contract-panel .bs-contract-deliver",
          "timeout": 30000
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": [
            "finances",
            "needs",
            "set-policy"
          ],
          "timeout": 60000
        }
      ]
    },
    {
      "command": "set_policy mode:shift_8h",
      "timeout": 60,
      "description": "set-policy complete: Apply pressed in the Operations panel (redesign P5 moved site policy out of Settings) — the form mirrors the policy in force, and applying it unchanged still counts",
      "role": "player",
      "interaction": [
        {
          "type": "waitForTutorialStep",
          "stepId": "set-policy",
          "timeout": 30000
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"ops\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-policy-apply"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-policy-apply"
        },
        {
          "type": "waitForTutorialStep",
          "stepId": "tick-advance"
        }
      ]
    },
    {
      "command": "tick 6",
      "timeout": 60,
      "description": "tick-advance complete: the tutorial's own clock runs — the whole point of this step — until tickCount has advanced more than 5, reaching the closing victory card. No click and no scripted `tick`: mirrors the playtest's own beat, which is `letTimePass` only.",
      "role": "player",
      "interaction": [
        {
          "type": "waitForTutorialStep",
          "stepId": [
            "victory",
            "congratulations"
          ],
          "timeout": 30000
        }
      ]
    },
    {
      "command": "campaign complete",
      "timeout": 30,
      "description": "victory complete: level ends, card shows Tutorial Complete. Forces the transition so the scenario ends deterministically rather than waiting out the profit-threshold win check; not a player action — `campaign` is on the reused setup allowlist.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "campaign complete"
        },
        {
          "type": "wait",
          "durationMs": 600
        }
      ]
    },
    {
      "command": "campaign status",
      "timeout": 30,
      "description": "Final: the congratulations card dismisses itself and the game is unpaused",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "campaign status"
        },
        {
          "type": "wait",
          "durationMs": 4500
        }
      ]
    }
  ]
}
