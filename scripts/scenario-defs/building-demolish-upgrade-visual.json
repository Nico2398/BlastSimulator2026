{
  "name": "building-demolish-upgrade-visual",
  "description": "Tier upgrades are in-place construction (#1875) and demolition is Building Destroyer work (#1392): a player upgrades a building with no destroyer in the fleet, then buys a Wrecking Rascal and demolishes another, by clicking the real Build and Fleet panel controls, waiting on state (buildingCount, maxBuildingTier) rather than tick pads. The upgraded building keeps its id.",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "tier-comparison",
      "yaw": 90,
      "pitch": 15
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 cash:330000 staffed:true",
      "timeout": 40,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:330000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 330000,
          "buildingCount": 0
        }
      },
      "description": "Staffed site: the roster already includes a truck-licensed driver who can crew a Building Destroyer."
    },
    {
      "command": "build living_quarters at:2,8 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for living_quarters and picking the tile. #1008: relocated from (2,6) to (2,8) -- (2,6)'s tier 1 (3x3) footprint is flat, but the tier 2 (4x3) footprint it grows into downstream is not (a grown-cells edge case, since a tier upgrade never moves the building). (2,8) is flat for the base footprint and every upgraded tier's larger footprint.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 8
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -10000
        },
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for it to actually land before referring to its building id."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:300",
      "description": "Drive the living_quarters site to completion (#556) before anything below depends on a real, numbered building (it lands as #1). Speeds up via a real click on the HUD's 8x button before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build management_office at:14,5 tier:1",
      "description": "Placed by clicking the Build panel's catalog row for management_office and picking the tile.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 14,
          "z": 5
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 500
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for it to actually land before referring to its building id."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:2 max_ticks:300",
      "description": "Drive the management_office site to completion (#556) before demolishing it by id. Speeds up via a real click on the HUD's 8x button before waiting.",
      "timeout": 95,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 2,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 2,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build upgrade 1",
      "description": "Click living_quarters #1's Upgrade button with no Building Destroyer in the fleet (#1875). The building keeps operating and is upgraded in place by whoever is free, under the SAME id.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row:nth-child(1) .bs-build-row-name"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector [data-action=\"upgrade\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "An upgrade is ordinary construction (#1875): charged the discounted upgrade price now (next tier's construction cost minus half the current tier's), no demolition, no vehicle. The building keeps standing, so buildingCount stays 2."
      }
    },
    {
      "command": "wait_until field:maxBuildingTier equals:2 max_ticks:900",
      "description": "waitUntil the same id (#1) reaches tier 2: the in-place construction finished.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "maxBuildingTier",
          "equals": 2,
          "maxTicks": 900,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "maxBuildingTier": 2
        }
      }
    },
    {
      "command": "vehicle buy building_destroyer tier:1",
      "description": "Buy the Wrecking Rascal (Building Destroyer) through the Fleet panel dealership button; only the demolition below needs it (#1392) - the upgrade above did not.",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "vehicles"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        }
      ],
      "expect": {
        "increased": [
          "vehicleCount"
        ],
        "changedBy": {
          "cash": -30000
        }
      }
    },
    {
      "command": "build destroy 2",
      "description": "Click building #2 (management_office) in the Build panel, press Demolish, and confirm. The order is charged now; the building stays until the Wrecking Rascal finishes.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row:nth-child(2) .bs-build-row-name"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector [data-action=\"demolish\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector [data-action=\"demolish\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        },
        "note": "demolishing has a $2,000 cost of its own, charged now; the building goes only when the Wrecking Rascal finishes"
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:900",
      "description": "waitUntil the Building Destroyer has finished: buildingCount drops from 2 to 1.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 900,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build list",
      "description": "Building #1 is still living_quarters, now T2, with its original id; no building with a new id appeared.",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    }
  ]
}
