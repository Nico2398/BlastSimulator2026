{
  "name": "sandbox-permit-preflight-warning",
  "description": "Permit preview (#1925): a player plans a 3x3 filled with krackle up to 2 m of stemming (128.7 kg, over the 40 kg grade-0 limit) in the workshop, sees the permit usage and warning in the footer and the fee, strikes and warning in the preflight, and fires anyway (the limit is soft).",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site at grade 0: the Backyard Dig Permit allows 40 kg of charge and 144 m\u00b2 of pattern per blast.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "permit status",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "permit status"
        }
      ],
      "description": "Grade 0 permit: limits 40 kg / 144 m\u00b2 and the $250 notification fee are listed."
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "No building order is pending.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:3 depth:7 start:36,30",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 3
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 7
        },
        {
          "type": "dragTiles",
          "x1": 36,
          "z1": 30,
          "x2": 42,
          "z2": 36
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Plan a 3x3 pattern in the Blast Workshop.",
      "role": "player"
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "the driller lands every ordered hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:krackle stemming:2",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"krackle\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "Charge every hole with 10 kg: 90 kg in all against the 40 kg limit.",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "role": "player"
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "the blaster loads every charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 90,
      "description": "Footer shows 128.7 / 40 kg (nine 7 m holes filled with krackle up to 2 m of stemming) in the warning style and 81 / 144 m\u00b2 within the permit with the satirical warning line; FIRE stays usable.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 3
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"permit-usage\"][data-over=\"true\"]"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-role=\"permit-usage\"] [data-role=\"permit-kg\"]",
          "property": "textContent",
          "expectedValue": "128.7 / 40 kg"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-role=\"permit-usage\"] [data-role=\"permit-area\"]",
          "property": "textContent",
          "expectedValue": "81 / 144 m\u00b2"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"permit-warning\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"execute\"]"
      }
    },
    {
      "command": "blast detonate",
      "role": "player",
      "timeout": 90,
      "description": "Open the preflight: the notification fee and strikes lines and the over-limit warning are listed.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-role=\"preflight-permit-fee\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-role=\"preflight-permit-strikes\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-role=\"preflight-permit-warning\"]"
        },
        {
          "type": "awaitUsable",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "expect": {
        "usable": "[data-action=\"preflight-cancel\"], [data-action=\"preflight-cancel-detonation\"]"
      }
    },
    {
      "command": "blast",
      "role": "player",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": ".bs-confirm-overlay [data-action=\"preflight-detonate\"]",
          "timeoutMs": 3000
        },
        {
          "type": "clickIfPresent",
          "selector": ".bs-confirm-overlay [data-action=\"preflight-fire-anyway\"]",
          "timeoutMs": 3000
        }
      ],
      "description": "Fire from the preflight (DETONATE, or Blast anyway when crew is still inside): the limit is soft, the sequence fires."
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "[data-action=\"report-close\"]",
          "timeoutMs": 20000
        },
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (the starter survey makes the first blast fire an ore event); the blast report defers the event dialog, so the player closes the report first.",
      "commandOutcome": "either",
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "The sequence fires anyway: holes consumed, notification fee booked.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "holeCount": 0,
          "blastBanned": false
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 60,
      "description": "Dismiss the blast report (already closed when an ore event had to be answered first).",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "[data-action=\"report-close\"]",
          "timeoutMs": 20000
        }
      ]
    },
    {
      "command": "permit status",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "permit status"
        }
      ],
      "description": "Status lists the strikes, never a chance."
    }
  ]
}
