{
  "name": "sandbox-permit-panel-apply",
  "description": "Permits panel (#1924): on a sandbox site the player opens Permits from the tool rail and finds Apply disabled while the grade-1 targets are unmet, then after 5 t of ore delivered and 2 blasts fired, clicks Apply in the panel (no `permit apply` console command in any player step); the $20,000 fee is booked, and 48 ticks later the site is a Hobby Quarry (grade 1).",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site: the sandbox opens with a permit ladder at grade 0.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "permit status",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "permit status"
        }
      ],
      "description": "Backyard Dig Permit with the grade-1 targets (5 t ore, 2 blasts) unmet."
    },
    {
      "command": "permit status",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"permits\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-action=\"permit-apply\"]"
        }
      ],
      "description": "Open the Permits panel from the tool rail (the entry is revealed on a progression site).",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "permit apply",
      "role": "guard",
      "commandOutcome": "refused",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-action=\"permit-apply\"]"
        }
      ],
      "description": "Grade-1 targets unmet: the panel's Apply button is present but disabled, so a player cannot apply (the console refuses the same application).",
      "expect": {
        "blocked": "#bs-permit-panel [data-action=\"permit-apply\"]",
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
