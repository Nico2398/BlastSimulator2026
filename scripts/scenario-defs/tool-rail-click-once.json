{
  "name": "tool-rail-click-once",
  "description": "#1750: one real mouse click on each tool rail button (blast, survey, contracts, ops, build, vehicles, employees, settings) opens its panel and leaves it open; a second click closes it. Interaction mode, real clicks, condition waits only.",
  "steps": [
    {
      "command": "new_game seed:42 staffed:true",
      "timeout": 30,
      "description": "Setup: a staffed site so every rail panel has content; nothing is open yet.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 staffed:true"
        }
      ]
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1750: one real mouse click on the blast rail button opens its panel and the panel stays open -- the click is handled once, not toggled shut by a repeat. Waits on the pressed state and the panel's own close control, never a fixed delay.",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-toolbar [data-panel=\"blast\"]",
          "property": "ariaPressed",
          "expectedValue": "true",
          "timeoutMs": 10000
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-panel-close]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel [data-panel-close]",
        "note": "blast panel visible after a single real click"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1750: a second, separate click on the blast rail button closes the panel.",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-toolbar [data-panel=\"blast\"]",
          "property": "ariaPressed",
          "expectedValue": "false",
          "timeoutMs": 10000
        }
      ],
      "expect": {
        "blocked": "#bs-blast-panel [data-panel-close]",
        "note": "blast panel closed by the second click"
      }
    },
    {
      "command": "state",
