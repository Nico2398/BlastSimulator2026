{
  "name": "explosive-pay-on-fill-visual",
  "description": "Pay on fill (#2143), observed: with no warehouse stock a charge order costs nothing when ordered and is loaded without any delivery wait; the Charge step shows the explosive cost as an estimate paid as each hole is loaded, and the cash is booked only once the hole is loaded.",
  "steps": [
    {
      "command": "new_game seed:42 staffed:true cash:150000",
      "description": "Staffed opening, no warehouse.",
      "timeout": 30,
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 staffed:true cash:150000"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:8 diameter:0.089 start:15,15",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:8 diameter:0.089 start:15,15"
        }
      ]
    },
    {
      "command": "wait_until field:holeCount equals:1 max_ticks:300",
      "timeout": 130,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "description": "Order a charge: nothing is paid at ordering, the order only queues. Explicit 5 kg partial charge: this is console-only bootstrap scaffolding, and BOOTSTRAP_COMMAND_ALLOWLIST admits this exact command (the fill form without `amount:` is not on it).",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:* explosive:boomite amount:5 stemming:2"
        }
      ],
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "orderedChargeCount": 1,
          "chargedCount": 0
        }
      }
    },
    {
      "command": "state",
      "description": "The Charge step shows the pattern's explosive cost as an estimate paid as each hole is loaded, and no delivery wait.",
      "role": "observe",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-info=\"paid-on-fill\"]"
        },
        {
          "type": "mousemove",
          "x": 200,
          "y": 520
        },
        {
          "type": "wheel",
          "deltaX": 0,
          "deltaY": 600
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "command": "wait_until field:chargedCount equals:1 max_ticks:300",
      "description": "The hole is loaded without a delivery wait (the old wait was 400 ticks) and the cost is booked on loading.",
      "timeout": 130,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 120000
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedChargeCount": 0,
          "chargedCount": 1
        }
      }
    }
  ]
}
