{
  "name": "building-menu-visual",
  "description": "Visual check of building selection menu: open build types, place multiple buildings, list placed buildings, inspect scores and state",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build types",
      "interaction": [
        {
          "type": "command",
          "command": "build types"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build living_quarters at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 40000,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build management_office at:10,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 32000,
          "buildingCount": 2
        }
      }
    },
    {
      "command": "build driving_center at:15,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"driving_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 20000,
          "buildingCount": 3
        }
      }
    },
    {
      "command": "build explosive_warehouse at:20,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 20,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 0,
          "buildingCount": 4
        }
      }
    },
    {
      "command": "build freight_warehouse at:5,10",
      "interaction": [
        {
          "type": "command",
          "command": "build freight_warehouse at:5,10"
        }
      ],
      "description": "Left unmarked: cash is already at or below this building's cost at this point in the scenario, so the Build panel's buy button is disabled (BuildMenu.ts: `btn.disabled = cash < def.constructionCost || locked`) and a real player could not click it -- but the console `build` command has no funds guard and drives cash negative anyway (Finding #1's class, previously only confirmed for `vehicle buy`; this generalizes it to plain `build` too). Found by the interaction channel: command mode passes this step silently by overdrawing, something no click can do.",
      "expect": {
        "equals": {
          "cash": -15000,
          "buildingCount": 5
        },
        "note": "confirms the overdraw for real: cash goes negative, a state no click could ever reach"
      }
    },
    {
      "command": "build vehicle_depot at:10,10",
      "interaction": [
        {
          "type": "command",
          "command": "build vehicle_depot at:10,10"
        }
      ],
      "description": "Left unmarked: cash is already at or below this building's cost at this point in the scenario, so the Build panel's buy button is disabled (BuildMenu.ts: `btn.disabled = cash < def.constructionCost || locked`) and a real player could not click it -- but the console `build` command has no funds guard and drives cash negative anyway (Finding #1's class, previously only confirmed for `vehicle buy`; this generalizes it to plain `build` too). Found by the interaction channel: command mode passes this step silently by overdrawing, something no click can do.",
      "expect": {
        "equals": {
          "cash": -33000,
          "buildingCount": 6
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "menu-panel",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
