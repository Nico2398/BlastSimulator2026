{
  "name": "economy-full-loop",
  "description": "Full economy pipeline: blast spawns fragments without instant payout, a debris_hauler hauls them into a freight_warehouse, and contract delivery pays out only from that stored inventory (issue #456).",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "campaign start level:tutorial_pit",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:tutorial_pit"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 80000
        }
      }
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee hire role:surveyor",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1,
          "qualificationCount": 1,
          "proficiencyTotal": 1
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:geology level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:geology level:5"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`.",
      "expect": {
        "equals": {
          "cash": 78800,
          "proficiencyTotal": 5
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "survey seismic x:12 z:12",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"survey\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-panel [data-method=\"seismic\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-run"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 12,
          "z": 12
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "surveyCount": 0
        },
        "note": "the seismic survey cost ($3000, SURVEY_COSTS.seismic) is charged up front when queued, not on completion -- Finding #32: this used to silently diverge state.finances.cash from the flat cash field this assertion reads, fixed at the root"
      }
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "surveyCount": 0
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons. Decides whether an event is pending from authoritative game state, not from whether the modal has rendered -- a DOM-only probe silently missed events on a no-GPU runner where a frame costs ~6s, leaving them pending so later ticks halted and the run diverged while still passing command mode.",
      "role": "player"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 2,
          "qualificationCount": 2,
          "proficiencyTotal": 6
        }
      }
    },
    {
      "command": "employee assign_skill 2 skill:blasting level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 2 skill:blasting level:5"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`.",
      "expect": {
        "equals": {
          "cash": 73700,
          "proficiencyTotal": 10
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:4 depth:6 start:10,10",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 10,
          "z1": 10,
          "x2": 14,
          "z2": 14
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 4
        }
      },
      "description": "depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged."
    },
    {
      "command": "charge hole:* explosive:boomite amount:3 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"][data-selected=\"true\"]"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "3 kg"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "2.0 m"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "role: player (issue #515): the Charge step's amount/stemming steppers and product-card explosive selector are real controls \u2014 this reaches the declared explosive/amount/stemming via clicks instead of Charge All using whatever the panel's fields already showed.",
      "expect": {
        "equals": {
          "chargedCount": 4
        }
      },
      "role": "player"
    },
    {
      "command": "sequence auto",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 4
        }
      },
      "description": "role: player: explicit [data-step=\"3\"] click before Sequence controls -- relying on the panel's own autoAdvance to have already landed there is unreliable in a real interaction-mode run (element present but zero-size, i.e. a hidden inactive tab), same finding as level1-win-efficient.json/level1-playthrough-win.json/tutorial-playthrough.json."
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "fragments status",
      "interaction": [
        {
          "type": "command",
          "command": "fragments status"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "fragments status",
      "interaction": [
        {
          "type": "command",
          "command": "fragments status"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 3,
          "qualificationCount": 3,
          "proficiencyTotal": 11
        }
      }
    },
    {
      "command": "employee assign_skill 3 skill:driving.truck level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 3 skill:driving.truck level:5"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`.",
      "expect": {
        "equals": {
          "cash": 72900,
          "proficiencyTotal": 15
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "build freight_warehouse at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle driver 1 3",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vehicle-id=\"1\"] .bs-vehicle-assign-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vehicle-id=\"1\"] .bs-vehicle-assign-btn"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 32900
        }
      }
    },
    {
      "command": "tick 10",
      "description": "Long enough for the surveyor to reach (12,12) and complete the seismic survey queued at the very start.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "surveyCount": 1
        }
      }
    },
    {
      "command": "vehicle haul 1 fragment:138",
      "description": "The Haul button always picks the vehicle's nearest reachable, non-oversized, storage-fitting fragment (findReachableGroundFragment, HaulingTask.ts) -- not a fixed index. #138 is what that function itself returns for this exact seed/command sequence. Re-derived from a previously-hardcoded #0 during the depth-mismatch audit (Ground rule #15/Finding #42): correcting this file's drill_plan depth from 8 to 6 (the grid tool's real default, since this step never clicks the depth stepper) changes the whole blast/fragment population, and fragment #0 was no longer haul-eligible in the corrected population -- storedMassKg silently stayed 0 through the following tick and the contract delivery step never paid out. Confirmed by calling findReachableGroundFragment directly against the corrected blast.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vehicle-id=\"1\"] .bs-vehicle-haul-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vehicle-id=\"1\"] .bs-vehicle-haul-btn"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 29770
        }
      }
    },
    {
      "command": "tick 10",
      "description": "Long enough for the driver to haul fragment #0 all the way to the freight_warehouse.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "storedMassKg"
        ]
      }
    },
    {
      "command": "fragments status",
      "interaction": [
        {
          "type": "command",
          "command": "fragments status"
        }
      ],
      "role": "observe"
    },
    {
      "command": "contract accept 1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "activeContractCount": 1
        }
      }
    },
    {
      "command": "contract deliver 1 amount:200",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-contract-panel .bs-contract-amount"
        },
        {
          "type": "set",
          "selector": "#bs-contract-panel .bs-contract-amount",
          "value": "200"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-deliver"
        }
      ],
      "role": "player",
      "description": "Real click path: type 200 into the ACTIVE card's amount box and press DELIVER, so the kilograms the click sends are the same 200 the `command` field declares. The panel is already open from the accept step above, and contract #1 is the only active card, so the unqualified `.bs-contract-amount`/`.bs-contract-deliver` selectors are unambiguous here. awaitUsable is the real assertion: ContractsPanel disables the input, MAX and DELIVER together whenever min(remaining, stored) is 0, so a run that hauled nothing fails here instead of quietly delivering nothing. Traced maxDeliverable at this step: 262.5 kg of rubble against 430 kg remaining, so 200 is genuinely deliverable.",
      "expect": {
        "increased": [
          "cash"
        ],
        "note": "delivery genuinely pays out here (unlike contract-negotiation.json, which never hauls anything into storage) -- confirmed via direct trace: Payment $234.49"
      }
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "employeeCount": 3,
          "buildingCount": 1,
          "vehicleCount": 1,
          "activeContractCount": 1,
          "surveyCount": 1
        }
      }
    }
  ]
}
