{
  "name": "blast-preview-software-tiers",
  "description": "Visual verification of blast preview overlays at each software tier: energy heatmap, fragment distribution, projection arcs, vibration waves",
  "steps": [
    {
      "command": "new_game seed:42 cash:80000 staffed:true",
      "timeout": 10,
      "description": "Staffed opening (#551): a driller with blasting + drill_rig licence, plus an unmanned drill_rig, are hired/purchased for free at game-open -- #553's automatic drill dispatch needs both to ever land an ordered hole.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:80000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 80000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:2 depth:6 start:15,15",
      "description": "One decrement click on the spacing stepper (data-field=\"spacing\") lowers it 3->2m (DEFAULT_SPACING_M, Drill.ts) before dragging, so the (15,15)-(19,19) rectangle computes the declared 3x3. #553: spacing tightened from 5m to 2m to keep this 9-hole grid's total drilling time inside the site's own bankruptcy-grace window (no income anywhere in this file) -- sandbox-measured: 9 holes at spacing 5 go bankrupt around tick 259, at spacing 2 they land around tick 130 with over $12,000 still in hand.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 19,
          "z2": 19
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 9,
          "holeCount": 0
        },
        "note": "3 rows x 3 cols = 9 holes ordered (ghosts), none drilled yet (#553)"
      }
    },
    {
      "command": "tick 130",
      "description": "#553: drain the ordered plan -- the staffed driller/drill_rig lands all 9 holes well inside this pad (sandbox-measured landing at tick 130 for this tight spacing:2 pattern).",
      "interaction": [
        {
          "type": "command",
          "command": "tick 130"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 9
        },
        "note": "All 9 holes have landed -- none lost, none left ordered forever."
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "timeout": 125,
      "description": "#554: drain the charge order(s) queued by the step above (charging is real work, not instant) before continuing.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 9,
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      }
    },
    {
      "command": "preview energy",
      "interaction": [
        {
          "type": "command",
          "command": "preview energy"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"1\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "preview energy",
      "interaction": [
        {
          "type": "command",
          "command": "preview energy"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"2\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "preview fragments",
      "interaction": [
        {
          "type": "command",
          "command": "preview fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:3",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"3\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "preview projections",
      "interaction": [
        {
          "type": "command",
          "command": "preview projections"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:4",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"4\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "preview vibrations",
      "interaction": [
        {
          "type": "command",
          "command": "preview vibrations"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
