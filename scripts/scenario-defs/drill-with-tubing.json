{
  "name": "drill-with-tubing",
  "description": "#2269: from the Drill step the player switches on tubing as holes are drilled, orders a two-hole pattern, buys the tubing the Drill step says is short, and the driller lands both holes. A storm then falls on holes that are never touched again, and none takes on water, although hole (15,15) sits in porous rock that floods within a few ticks when untubed (see wet-warning-fix).",
  "steps": [
    {
      "command": "new_game seed:42 size:31 staffed:true cash:150000",
      "description": "Staffed opening on a 31-cell desert site: a driller with blasting + drill_rig licence and an unmanned drill_rig come free at game-open. Seed 42 puts hole (15,15) on porous rock.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:31 staffed:true cash:150000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 150000,
          "holeCount": 0
        }
      },
      "timeout": 30
    },
    {
      "command": "tube_on_drill on",
      "description": "Drill step: the player clicks the tube-as-drilled toggle. The toggle reads on afterwards.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"tube-on-drill\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"tube-on-drill\"][data-on=\"true\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "usable": "#bs-blast-panel [data-action=\"tube-on-drill\"][data-on=\"true\"]",
        "note": "#2269 -- the toggle runs the console command and reads on."
      },
      "timeout": 60
    },
    {
      "command": "drill_plan grid rows:1 cols:2 spacing:5 depth:6 start:15,15",
      "description": "Two holes by real clicks: a drag from (15,15) to (20,15) at 5 m spacing is a 1x2 grid.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 15
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 2,
          "holeCount": 0
        }
      },
      "timeout": 60
    },
    {
      "command": "buy amount:10",
      "description": "Drill step: no tubing in stock against two planned holes, so the stock line offers a buy action. One click buys ten units ($500), the same purchase as the Charge step's tubing card, and the buy action goes away.",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"tubing-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"tubing-buy\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"tube-stock\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -500
        },
        "note": "#2269 -- the stock shortfall is bought from the Drill step."
      },
      "timeout": 60
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "description": "The staffed driller lands both holes; each is tubed at the moment its drilling completes.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 300000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "holeCount": 2,
          "orderedHoleCount": 0
        }
      },
      "timeout": 305
    },
    {
      "command": "event choose 0",
      "description": "Dismiss an event that may have fired during the drilling.",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "weather set storm",
      "description": "A storm falls on the drilled holes. Bootstrap: weather has no UI control.",
      "interaction": [
        {
          "type": "command",
          "command": "weather set storm"
        }
      ],
      "role": "bootstrap",
      "expect": {
        "equals": {
          "weather": "storm"
        }
      }
    },
    {
      "command": "tick 100",
      "description": "Let the storm rain on the holes. Hand-measured pad: nothing observable can be polled for water that must not arrive; an untubed porous hole floods within a few ticks (wet-warning-fix waits at most 200).",
      "interaction": [
        {
          "type": "command",
          "command": "tick 100"
        }
      ],
      "role": "setup",
      "timeout": 60
    },
    {
      "command": "event choose 0",
      "description": "Dismiss an event the storm may have raised.",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "state",
      "description": "Both holes stay dry in the storm because they were tubed as they were drilled.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "weather": "storm",
          "holeCount": 2,
          "wetHoleCount": 0
        },
        "note": "#2269 -- no wet hole after a storm over a pattern drilled with the option on."
      }
    }
  ]
}
