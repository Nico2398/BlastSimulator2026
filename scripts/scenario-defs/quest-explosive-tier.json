{
  "name": "quest-explosive-tier",
  "description": "Quests (#2280): on a sandbox site the Progression panel lists the T2 and T3 explosive quests from the start, and the Charge step shows big_bada_boom locked behind the T2 quest it names (the console refuses it too). Two clean blasts with 100 kg detonated complete the quest on their own; the panel reads completed, the big_bada_boom card turns into a selectable one and a charge with it is ordered and loaded.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42 tier:3",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42 tier:3"
        }
      ],
      "description": "Progression site at grade 0 tier 3: the permit allows 130 kg and 290 m2 a blast, so two clean shots stay inside it (no fine, no inspection strike to muddy the streak). Quest state starts with the site.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "tier": 3,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "quest list",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "quest list"
        }
      ],
      "description": "Both explosive quests are listed from the start, available, every objective at zero."
    },
    {
      "command": "quest detail quest_explosive_t2",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"permits\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-role=\"quest\"][data-quest-id=\"quest_explosive_t2\"][data-state=\"available\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-role=\"quest\"][data-quest-id=\"quest_explosive_t3\"][data-state=\"available\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-quest-id=\"quest_explosive_t2\"] [data-role=\"quest-objective\"][data-kind=\"clean_blasts\"][data-met=\"false\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-quest-id=\"quest_explosive_t2\"] [data-role=\"quest-objective\"][data-kind=\"explosive_kg\"][data-met=\"false\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-permit-panel [data-quest-id=\"quest_explosive_t2\"] [data-role=\"quest-reward\"]"
        }
      ],
      "description": "Open the Progression panel from the tool rail: both quests are on the list from the start, available, with their objectives unmet and the reward named."
    },
    {
      "command": "quest list",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"permits\"]"
        }
      ],
      "description": "Close the Progression panel with the same rail button (central panels share the screen with the Blast Workshop)."
    },
    {
      "command": "charge hole:* explosive:big_bada_boom stemming:2",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"explosive-locked\"][data-explosive=\"big_bada_boom\"][data-quest=\"quest_explosive_t2\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"explosive-locked\"][data-explosive=\"obliviax\"][data-quest=\"quest_explosive_t3\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        }
      ],
      "description": "Charge step: big_bada_boom is a locked card naming the quest that opens it, obliviax names the T3 quest, tier-1 boomite stays a normal card. The console refuses the locked explosive the same way.",
      "commandOutcome": "refused"
    },
    {
      "command": "event choose 0",
      "role": "player",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
