{
  "name": "vehicle-3d-rendering-visual",
  "description": "Visual check: all 5 vehicle roles render distinct 3D shapes at spawn with correct positioning",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "description": "Plain new_game at the sandbox default. The `cash:200000` bump that used to sit here has moved to `campaign start` below, which is the step that actually decides this scenario's cash; keeping a second copy here would set a figure nothing reads.",
      "expect": {
        "equals": {
          "cash": 50000,
          "vehicleCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow cash:200000",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow cash:200000"
        }
      ],
      "role": "setup",
      "description": "campaign start replaces the whole GameState (createGameForLevel), cash included, so this is the only place a campaign scenario can fund itself -- hence `cash:` here rather than on new_game. $200,000 covers all 5 tier-1 roles ($25,000 + $50,000 + $35,000 + $30,000 + $32,000 = $172,000), which is exactly what this scenario's premise needs: 5 dealership rows all enabled, all clickable, all rendering a mesh.",
      "expect": {
        "equals": {
          "cash": 200000,
          "vehicleCount": 0
        },
        "note": "the cash: override replaces dusty_hollow's $50,000 default outright"
      }
    },
    {
      "command": "vehicle buy debris_hauler",
      "timeout": 15,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "description": "Opens the Fleet panel and buys the hauler by clicking its tier-1 dealership row. Every later buy reuses the open panel.",
      "expect": {
        "equals": {
          "cash": 175000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle buy rock_digger",
      "timeout": 15,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "description": "Real click on the rock_digger tier-1 row: $175,000 in hand against $50,000, so the row is enabled. awaitUsable is the affordability assertion -- FleetPanel disables a tier row on cash < purchaseCost, so an underfunded run fails here instead of buying anyway.",
      "expect": {
        "equals": {
          "cash": 125000,
          "vehicleCount": 2
        }
      }
    },
    {
      "command": "vehicle buy drill_rig",
      "timeout": 15,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "description": "Real click on the drill_rig tier-1 row: $125,000 in hand against $35,000.",
      "expect": {
        "equals": {
          "cash": 90000,
          "vehicleCount": 3
        }
      }
    },
    {
      "command": "vehicle buy building_destroyer",
      "timeout": 15,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"building_destroyer\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "description": "Real click on the building_destroyer tier-1 row: $90,000 in hand against $30,000.",
      "expect": {
        "equals": {
          "cash": 60000,
          "vehicleCount": 4
        }
      }
    },
    {
      "command": "vehicle buy rock_fragmenter",
      "timeout": 15,
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"rock_fragmenter\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"rock_fragmenter\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "description": "Real click on the rock_fragmenter tier-1 row: $60,000 in hand against $32,000. Fifth and last role, so the shots below capture one of every vehicle mesh with the balance still in the black.",
      "expect": {
        "equals": {
          "cash": 28000,
          "vehicleCount": 5
        }
      }
    },
    {
      "command": "vehicle list",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "vehicle list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "all-roles",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "top-down",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "side-view",
      "yaw": 90,
      "pitch": 15
    }
  ]
}
