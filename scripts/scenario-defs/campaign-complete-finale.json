{
  "name": "campaign-complete-finale",
  "description": "Issue #1320: finishing the 3 real campaign levels (tutorial untouched) completes the campaign; the final level-end screen is reachable and its BACK TO PORTFOLIO button returns to the Portfolio by a real click. Setup steps force-win each level; the player starts the campaign and leaves the finale.",
  "steps": [
    {
      "command": "state",
      "description": "Observe the fresh main menu: no level running. Command mode has no game yet, so `state` may be refused.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        }
      ],
      "role": "observe",
      "commandOutcome": "either"
    },
    {
      "command": "state",
      "description": "Player clicks New Campaign; Portfolio must offer Dusty Hollow's Start. Inert paired `state`.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-main-menu #bs-menu-new-campaign"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-world-map [data-action=\"start-level\"][data-level=\"dusty_hollow\"]"
        }
      ],
      "role": "player",
      "expect": {
        "usable": "#bs-world-map [data-action=\"start-level\"][data-level=\"dusty_hollow\"]",
        "changedBy": {
          "cash": 0
        }
      },
      "commandOutcome": "either"
    },
    {
      "command": "campaign start level:dusty_hollow staffed:false",
      "description": "Player starts Dusty Hollow from its Portfolio card.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-world-map [data-action=\"start-level\"][data-level=\"dusty_hollow\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-saveload-btn",
          "timeoutMs": 60000
        }
      ],
      "role": "player",
      "expect": {
        "usable": "#bs-saveload-btn",
        "equals": {
          "levelEnded": false
        }
      },
      "timeout": 120
    },
    {
      "command": "campaign complete level:dusty_hollow",
      "description": "Debug force-win (console-only): Dusty Hollow completed, unlocks Grumpstone Ridge.",
      "interaction": [
        {
          "type": "command",
          "command": "campaign complete level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "levelEnded": true,
          "levelEndReason": "completed"
        }
      }
    },
    {
      "command": "campaign complete level:grumpstone_ridge",
      "description": "Debug force-win: Grumpstone Ridge completed, unlocks Treranium Depths. The tutorial is never completed.",
      "interaction": [
        {
          "type": "command",
          "command": "campaign complete level:grumpstone_ridge"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "levelEnded": true,
          "levelEndReason": "completed"
        }
      }
    },
    {
      "command": "campaign start level:treranium_depths",
      "description": "Setup: open Treranium Depths (unlocked by the prior wins, campaign progress carried) so the finale level-end screen is built for the final level, not left over from Dusty Hollow.",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:treranium_depths"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "levelEnded": false
        }
      },
      "timeout": 120
    },
    {
      "command": "campaign complete level:treranium_depths",
      "description": "Debug force-win: the 3 real levels are done, so the campaign is complete without the tutorial (#1320).",
      "interaction": [
        {
          "type": "command",
          "command": "campaign complete level:treranium_depths"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "levelEnded": true,
          "levelEndReason": "completed"
        }
      }
    },
    {
      "command": "state",
      "description": "Gate: finale level-end screen shows its single continue button (BACK TO PORTFOLIO on the last level).",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-level-end-screen [data-action=\"continue\"]",
          "timeoutMs": 30000
        }
      ],
      "role": "observe",
      "timeout": 60,
      "expect": {
        "usable": "#bs-level-end-screen [data-action=\"continue\"]",
        "equals": {
          "levelEnded": true,
          "levelEndReason": "completed"
        }
      }
    },
    {
      "command": "state",
      "description": "Player clicks BACK TO PORTFOLIO on the finale screen; the screen closes and the Portfolio is reachable. Inert paired `state`.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-level-end-screen [data-action=\"continue\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-world-map [data-action=\"start-level\"][data-level=\"dusty_hollow\"]",
          "timeoutMs": 30000
        }
      ],
      "role": "player",
      "expect": {
        "usable": "#bs-world-map [data-action=\"start-level\"][data-level=\"dusty_hollow\"]",
        "blocked": "#bs-level-end-screen [data-action=\"continue\"]"
      },
      "timeout": 60,
      "commandOutcome": "either"
    }
  ]
}
