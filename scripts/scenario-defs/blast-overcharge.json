{
  "name": "blast-overcharge",
  "description": "Chapter 5: Maximum boomite charge (8kg) in unstemmed holes to trigger flyrock projections and degrade the blast rating away from perfect. Stemming is what keeps a big charge working on the rock instead of throwing it, so an overcharge only turns dangerous once the holes are left unstemmed.",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:5 depth:6 start:15,15",
      "description": "Two increment clicks on the spacing stepper (data-field=\"spacing\") raise it 3->5m (DEFAULT_SPACING_M, Drill.ts) before dragging, so the (15,15)-(20,20) rectangle computes the declared 2x2 instead of the default-spacing 3x3 (issue #479 follow-up, Finding #4). depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 4
        },
        "note": "2 rows x 2 cols = 4"
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:8 stemming:0.5",
      "description": "FINDING: stemming:0 (this file's original declared value, fully unstemmed) is not reachable by any click \u2014 Charge.ts's adjustStemming() floors at Math.max(0.5, ...), so a player can never leave a hole truly unstemmed, only reach 0.5m. The console command has no such floor, so command mode's version of this file (and every earlier interaction-mode run, which never touched these steppers and silently charged at the 5kg/2m panel defaults instead) tested a different, stronger-than-achievable unstemmed case that no player could reproduce. Corrected to the real UI-reachable extreme: 3 amount-stepper clicks (5->8kg, data-field=\"amount\") and 8 stemming-stepper clicks (2.0->0.5m, data-field=\"stemming\", clamped at the floor) \u2014 the strongest overcharge a real player can actually create.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 4
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 4
        }
      }
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        },
        "note": "a fired blast clears the plan back to zero"
      }
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 15,15,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 15,15,0"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ]
}
