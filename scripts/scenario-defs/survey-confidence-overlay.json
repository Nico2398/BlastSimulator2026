    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "seismic-focus",
      "yaw": 90,
      "pitch": 30
    },
    {
      "name": "core-sample-focus",
      "yaw": 180,
      "pitch": 45
    }
