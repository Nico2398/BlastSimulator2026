{
  "name": "skill-progression",
  "description": "Chapter 3: Hire driller, assign drilling skill, build five living quarters, and verify skill progression after 600 ticks of continuous work (#549: real completions include genuine collapse/rest cost, so the driller reaches excavator Level 3). #1431: one worker at constant work drives morale to 0, so five quarters keep the wellBeing score up and the level never ends in a worker revolt (#1313 freezes the mine at level end); the run stays solvent on its $200,000 start.",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow cash:200000",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow cash:200000"
        }
      ],
      "role": "setup",
      "expect": {
        "increased": [
          "worldSizeX"
        ]
      },
      "description": "Starts with extra cash ($200,000) so the five living quarters and the 700-tick run stay solvent."
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "employees"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -1000
        },
        "equals": {
          "employeeCount": 1
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:driving.excavator level:1",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.excavator level:1"
        }
      ],
      "description": "Test-only bootstrap, not a player action: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts, same for the UI hire button and this console command), so this only raises the level for the scenario's needs. No role tag -- there is no UI control for this and none should exist; the player-facing way to raise a skill is `employee train` at a training building. Command mode keeps running it unchanged; interaction mode keeps it as an unmarked (legacy) command step. (Also fixes a Finding #15-class bug: the original step used `id:1` for the employee id, but assign_skill's id argument is positional, not named -- it silently failed with the Usage message.)",
      "expect": {
        "equals": {
          "proficiencyTotal": 2
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "build living_quarters at:15,17",
      "description": "#1431: living quarters keep the lone driller rested and wellBeing up, so the level never ends in a worker revolt (#1313 freezes the mine at level end) and the run reaches its full tick budget.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 17
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
