      "command": "employee assign_skill 1 skill:driving.excavator level:1",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.excavator level:1"
        }
      ],
      "description": "Test-only bootstrap, not a player action: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts, same for the UI hire button and this console command), so this only raises the level for the scenario's needs. No role tag -- there is no UI control for this and none should exist; the player-facing way to raise a skill is `employee train` at a training building. Command mode keeps running it unchanged; interaction mode keeps it as an unmarked (legacy) command step. (Also fixes a Finding #15-class bug: the original step used `id:1` for the employee id, but assign_skill's id argument is positional, not named -- it silently failed with the Usage message.)",
      "expect": {
        "equals": {
          "proficiencyTotal": 2
        }
      },
      "role": "bootstrap"
    },
