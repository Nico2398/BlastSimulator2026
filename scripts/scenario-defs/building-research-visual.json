{
  "name": "building-research-visual",
  "description": "Visual check of research center building at all three tiers for technology advancement",
  "steps": [
    {
      "command": "new_game seed:42 cash:230000",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:230000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 230000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build research_center at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -25000
        },
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build research_center at:15,5 tier:2",
      "description": "role: guard (issue #515): selecting tier 2 in the catalog row's own tier dropdown is a real interaction; the Buy button is then genuinely disabled — `refreshCatalogButtons`'s `locked` check (BuildMenu.ts) is true since tier 2 is not researched.",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-tier-sel",
          "value": "2"
        }
      ],
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 1
        },
        "blocked": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn",
        "note": "rejected: tier 2 not yet researched"
      },
      "role": "guard"
    },
    {
      "command": "research queue type:research_center tier:2",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-tier-sel",
          "value": "2"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -5000
        }
      }
    },
    {
      "command": "research queue type:research_center tier:3",
      "description": "Rejected (conditions_not_met) — tier-2 research is queued but has not been processed by a tick yet, so its own tier-2 research is not yet 'completed'. Demonstrates the tier-ordering gate before the flow continues below to tick tier-2 to completion.",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-tier-sel",
          "value": "3"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": 0
        },
        "equals": {
          "buildingCount": 1
        },
        "note": "rejected: tier 2 research is only queued, not yet completed"
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build research_center at:15,5 tier:2",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-tier-sel",
          "value": "2"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 2
        },
        "note": "tier 2 now buildable — real unlock, not just a queued task. cash uses decreased not equals since this follows a tick step (Finding #12)"
      }
    },
    {
      "command": "research queue type:research_center tier:3",
      "interaction": [
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-tier-sel",
          "value": "3"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-research-btn"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "note": "now succeeds — tier 3's condition (tier 2 research completed) is satisfied"
      }
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build research_center at:25,5 tier:3",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 25,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 3
        },
        "note": "tier 3 now buildable — full T1→T2→T3 progression completes as this file's own description promises, unlike its sibling building-research-progression-visual.json (Finding #20)"
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "research-area",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "closeup",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
