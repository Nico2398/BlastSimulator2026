{
  "name": "blast-drill-plan-visual",
  "description": "Visual verification of drill plan UI: grid creation, hole markers, spacing parameters, and plan inspection across multiple camera angles",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:4 spacing:5 depth:6 start:20,20",
      "description": "The grid tool's spacing stepper defaults to 3m (DEFAULT_SPACING_M, Drill.ts); two increment clicks on the strip's spacing stepper (data-field=\"spacing\") raise it to 5 before dragging, so the (20,20)-(35,30) rectangle (15x10) computes the declared 4 cols x 3 rows instead of the default-spacing 6x4. depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 35,
          "z2": 30
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 12
        },
        "note": "3 rows x 4 cols = 12"
      }
    },
    {
      "command": "drill_plan show",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan show"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "holeCount": 12,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "inspect 20,20,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 20,20,0"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
