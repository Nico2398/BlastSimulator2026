{
  "name": "drill-grid-burden-staggered",
  "description": "Grid tool, burden and staggered rows: a player sets 4 m between the holes of a row and 3 m between rows, switches the layout to staggered and drags the pattern. Every other row is shifted half a spacing and loses its last hole, so 4 + 3 + 4 = 11 holes are ordered, each working a 4 x 3 m cell (132 m² against the 144 m² grade-0 permit); the Drill step then reads the mesh as 4 × 3 m.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site at grade 0: the permit allows 40 kg of charge and 144 m² of pattern per blast.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "No building order is pending.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:4 spacing:4 burden:3 pattern:staggered depth:6 start:36,30",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"burden\"]",
          "value": 3
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-action=\"grid-layout\"]"
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-param-strip [data-action=\"grid-layout\"]",
          "property": "textContent",
          "expectedValue": "Layout: staggered",
          "timeoutMs": 10000
        },
        {
          "type": "dragTiles",
          "x1": 36,
          "z1": 30,
          "x2": 48,
          "z2": 36
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Set the spacing to 4 m and the burden to 3 m on the grid strip, switch the layout to staggered, drag 12 x 6 m: 4 columns by 3 rows, the middle row shifted 2 m and one hole shorter. The readout above the strip prices the 11 holes (metres, rig work, cash) and their 132 m² of permit area.",
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 11
        }
      }
    },
    {
      "command": "drill_plan show",
      "interaction": [
        {
          "type": "waitForProperty",
          "selector": "#bs-blast-panel [data-role=\"drill-mesh\"]",
          "property": "textContent",
          "expectedValue": "4 × 3 m",
          "timeoutMs": 10000
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-blast-panel [data-role=\"permit-area\"]",
          "property": "textContent",
          "expectedValue": "132 / 144 m²",
          "timeoutMs": 10000
        },
        {
          "type": "screenshot"
        }
      ],
      "description": "The Drill step reads the mesh as spacing × burden and the plan's permit area: eleven 4 x 3 m cells, 132 of the 144 m² allowed.",
      "role": "observe"
    }
  ]
}
