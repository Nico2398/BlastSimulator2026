{
  "name": "hud-explain-links-visual",
  "description": "HUD explanations and entity links (#2169): a union-style lawsuit settlement raises a live work-stoppage chip under the top bar, a player hovers it with the real pointer and the explainable() tooltip shows its effect and end time as the game clock; then the player opens the activity log from the top bar and clicks the employee named by a crew entry which opens the inspector on that employee. All by real clicks.",
  "steps": [
    {
      "command": "new_game seed:42 cash:330000 staffed:true",
      "timeout": 40,
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:330000 staffed:true"
        }
      ],
      "expect": {
        "equals": {
          "cash": 330000,
          "holeCount": 0
        }
      },
      "description": "Staffed site with plenty of cash for the settlement."
    },
    {
      "command": "event fire lawsuit_superpowers",
      "timeout": 30,
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "event fire lawsuit_superpowers"
        }
      ],
      "description": "Test hook: `event fire` has no UI control and none is intended. Raises the lawsuit whose second option ends in a 12 hour work stoppage."
    },
    {
      "command": "event choose 1",
      "timeout": 40,
      "role": "player",
      "interaction": [
        {
          "type": "resolveEventIfPending",
          "option": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-dismiss",
          "timeoutMs": 3000
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "note": "Option 1 of lawsuit_superpowers costs money and starts a work stoppage modifier."
      },
      "description": "Answer the lawsuit by clicking its second option; the work stoppage becomes a chip in the strip under the top bar."
    },
    {
      "command": "state",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": ".bs-modifier-chip"
        },
        {
          "type": "hoverSelector",
          "selector": ".bs-modifier-chip"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": ".bs-modifier-chip",
        "note": "The chip receives pointer events although its strip is click-through; the tooltip names the effect and the end time."
      },
      "description": "Hover the work-stoppage chip with the real pointer; the explanation tooltip opens beside it and is screenshotted."
    },
    {
      "command": "build driving_center at:3,5",
      "timeout": 40,
      "role": "player",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"driving_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 3,
          "z": 5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Player builds a driving school through the build panel, so a course can finish and the crew raises a trained entry that names an employee.",
      "expect": {
        "decreased": [
          "cash"
        ],
        "note": "Confirming placement only queues a construction site (#556) — the next step waits for it to actually land before training depends on a real school existing."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:600",
      "timeout": 95,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 600,
          "timeoutMs": 90000
        }
      ],
      "description": "Let the crew finish the school."
    },
    {
      "command": "employee train 1 skill:driving.excavator",
      "timeout": 40,
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "employees"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel .bs-detail-toggle"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector[data-kind=\"employee\"] .bs-train-btn[data-skill=\"driving.excavator\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-inspector[data-kind=\"employee\"] .bs-train-btn[data-skill=\"driving.excavator\"]"
        }
      ],
      "description": "Player enrols an employee in the excavator course from the inspector.",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "wait_until field:trainingCount equals:1 max_ticks:600",
      "timeout": 95,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "trainingCount",
          "equals": 1,
          "maxTicks": 600,
          "timeoutMs": 90000
        }
      ],
      "description": "The employee walks to the school and starts the course."
    },
    {
      "command": "wait_until field:trainingCount equals:0 max_ticks:600",
      "timeout": 95,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "trainingCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 90000
        }
      ],
      "description": "The course completes; employee:trained lands in the activity log with an employee reference."
    },
    {
      "command": "state",
      "timeout": 40,
      "role": "player",
      "interaction": [
        {
          "type": "resolveEventIfPending",
          "option": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top bs-icon[name=\"bell\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-activity-log"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-activity-log button[data-select-kind=\"employee\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-activity-log",
        "note": "The trained entry names employee 1, so the employee link is present; the row shows the game clock."
      },
      "description": "Open the activity log from the top bar bell, screenshot the rows with their game-clock times, and click the employee link of the trained entry; the inspector opens on that employee."
    }
  ]
}
