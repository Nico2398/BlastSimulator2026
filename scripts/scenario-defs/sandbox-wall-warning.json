{
  "name": "sandbox-wall-warning",
  "description": "Wall warning (#1943): on a progression site the player plans a second bench against the first bench's edge (13 m straight wall over soft rock's 12 m safe height). They switch the geology wall overlay on, see the wall warning line in the blast preview step and the pre-flight check, fire anyway (it is a warning, not a block), and the predicted face slumps, raising wallSlumpCount.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site (kit:full): wall stability is on, soft desert rock holds a 12 m face.",
      "expect": {
        "equals": {
          "wallSlumpCount": 0
        }
      }
    },
    {
      "command": "build explosive_warehouse at:8,8",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front so charging needs no delivery wait.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "The explosive warehouse is built.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "buy explosive:boomite kg:100",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        }
      ],
      "description": "Buy enough boomite for every blast into the warehouse stock.",
      "expect": {
        "decreased": [
          "cash"
        ]
      },
      "role": "player"
    },
    {
      "command": "build_ramp start:20,26 end:42,26 depth:7 width:5",
      "role": "player",
      "description": "First bench: a 5 wide trench, 7 m deep at its lower end.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 7
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"width\"]",
          "value": 5
        },
        {
          "type": "focusTile",
          "x": 31,
          "z": 26,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 26,
          "x2": 42,
          "z2": 26
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "orderedRampSegmentCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedRampSegmentCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "First trench dug.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedRampSegmentCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 600000
        }
      ],
      "timeout": 630,
      "expect": {
        "equals": {
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "build_ramp start:20,30 end:42,30 depth:7 width:5",
      "role": "player",
      "description": "First bench: a second 5 wide trench alongside it, overlapping by one row, makes the bench 9 m wide (rows 24 to 32).",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 7
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"width\"]",
          "value": 5
        },
        {
          "type": "focusTile",
          "x": 31,
          "z": 30,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 30,
          "x2": 42,
          "z2": 30
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "orderedRampSegmentCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedRampSegmentCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "Second trench dug; the bench floor is a 9 m wide step.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedRampSegmentCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 600000
        }
      ],
      "timeout": 630,
      "expect": {
        "equals": {
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "weather set sunny",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "weather set sunny"
        }
      ],
      "description": "Dry weather: a shower between drilling and firing would fizzle the boomite in a wet hole and blast no crater.",
      "expect": {
        "equals": {
          "weather": "sunny"
        }
      }
    },
    {
      "command": "drill_plan add x:39 z:24 depth:7 diameter:89",
      "role": "player",
      "description": "Site A, second bench against the bench edge: 7 m hole at 39,24, so the crater reaches the original rim with no berm.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 7
        },
        {
          "type": "focusTile",
          "x": 39,
          "z": 24
        },
        {
          "type": "pickTile",
          "x": 39,
          "z": 24
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:3000",
      "role": "setup",
      "description": "Hole drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:8 stemming:2.5",
      "role": "player",
      "description": "Load the hole.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 8
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2.5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "Charge loaded.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "weather set sunny",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "weather set sunny"
        }
      ],
      "description": "Dry weather for the second shot, set right before firing: a shower in the ticks between drilling and firing would fizzle the boomite in a wet hole and blast no crater (interaction mode reaches the shot a few ticks later than command mode, enough for the weather to turn).",
      "expect": {
        "equals": {
          "weather": "sunny"
        }
      }
    },
    {
      "command": "wait_until field:wetHoleCount equals:0 max_ticks:200",
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "wetHoleCount",
          "equals": 0,
          "maxTicks": 200,
          "timeoutMs": 120000
        }
      ],
      "description": "Wait for the hole to run dry: a wet hole fizzles the boomite and blasts no crater, and when the rain lands relative to the shot differs between command and interaction mode.",
      "timeout": 130,
      "expect": {
        "equals": {
          "wetHoleCount": 0
        }
      }
    },
    {
      "command": "survey",
      "role": "player",
      "description": "Open the Survey panel and switch the wall overlay on: the planned shot's tall faces are tinted amber (80% of safe height or more) or red (at or over it) in the pit.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "survey"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-panel [data-role=\"wall-overlay-toggle\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "timeout": 60,
      "expect": {
        "usable": "#bs-survey-panel [data-role=\"wall-overlay-toggle\"]"
      },
      "commandOutcome": "either"
    },
    {
      "command": "blast_preview",
      "role": "player",
      "description": "Preview step lists the wall warning for the planned 13 m face in soft rock (safe 12 m): it may slump. The run-analysis control stays usable: the warning is not a gate.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 3
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"preview-wall-warning\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "timeout": 60,
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"run-analysis\"]"
      }
    },
    {
      "command": "blast detonate",
      "role": "player",
      "description": "Pre-flight check lists the same wall warning row; detonate stays usable.",
      "interaction": [
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay [data-role=\"preflight-wall-warning\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "timeout": 90,
      "expect": {
        "usable": "[data-action=\"preflight-detonate\"]"
      }
    },
    {
      "command": "blast detonate",
      "role": "player",
      "description": "Player fires anyway.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "timeout": 90,
      "commandOutcome": "either"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "Blast resolved: the warned face slumped, so every predicted slump matched the slump that happened.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "holeCount": 0
        },
        "increased": [
          "wallSlumpCount"
        ]
      }
    }
  ]
}
