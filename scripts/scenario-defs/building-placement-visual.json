{
  "name": "building-placement-visual",
  "description": "Visual check of building placement at different grid positions with list inspection after each. #556: ordering a building queues a construction site (blue ghost, no building yet) instead of placing it instantly -- every order step now asserts buildingCount unchanged + orderedBuildingCount:1, followed by a mid-build checkpoint tick and a waitUntil that drives the site to completion before the next order.",
  "steps": [
    {
      "command": "new_game seed:42 cash:300000 staffed:true",
      "description": "#558: cash bumped from the default 50000 so the file's final step (a building on ground well outside the site) is affordable on top of the four already here. #556: staffed:true so a free roster exists to actually walk to and work each ordered site -- without it every order below would queue forever and buildingCount would never reach 1. Bumped again to 300000 (from 150000) as part of the #556 visual-testing follow-up dispatch-livelock fix: the far (90,20) order now genuinely completes instead of stalling forever, but a small 5-person roster still burns real salary/upkeep across the ~150-170 ticks its travel and repeated need-driven rest cycles take, and 150000 ran the balance negative (briefly bankrupt) by the time it finished -- confirmed against the fixed dispatch path, not a symptom of the fix itself.",
      "timeout": 75,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:300000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 300000,
          "buildingCount": 0,
          "employeeCount": 5
        }
      }
    },
    {
      "command": "build living_quarters at:5,5",
      "description": "#556: order-time validation and charging are unchanged from a direct placement -- only the result differs: a construction site is queued (orderedBuildingCount:1) instead of the building existing immediately (buildingCount stays 0). This step's own auto-captured screenshot is the 'ghost appears at order' checkpoint.",
      "timeout": 70,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -10000
        },
        "equals": {
          "buildingCount": 0,
          "orderedBuildingCount": 1
        },
        "note": "Ordered, not placed: the site is queued for construction, no building exists yet."
      }
    },
    {
      "command": "tick 10",
      "description": "#556: mid-construction checkpoint -- an unskilled roster member has had time to walk to (5,5) and start work, but tier 1's 40-tick base duration is nowhere near spent yet. This step's own auto-captured screenshot is the mid-build checkpoint (ghost still present, no building).",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 0
        },
        "note": "Still under construction 10 ticks in -- proves this is a genuine mid-build snapshot, not an already-finished site."
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:300",
      "description": "Drive the living_quarters site to completion. This step's own auto-captured screenshot is the 'finished building' checkpoint.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        },
        "note": "living_quarters construction complete -- the site has landed as a real building."
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build blasting_academy at:10,10",
      "description": "#556: same order-then-build semantics as the first order above.",
      "timeout": 70,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"blasting_academy\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -15000
        },
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 1
        },
        "note": "living_quarters already stands from the previous order; blasting_academy is now queued, not yet built."
      }
    },
    {
      "command": "tick 10",
      "description": "#556: mid-construction checkpoint for blasting_academy.",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "wait_until field:buildingCount equals:2 max_ticks:300",
      "description": "Drive the blasting_academy site to completion.",
      "timeout": 95,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 2,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 2,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
