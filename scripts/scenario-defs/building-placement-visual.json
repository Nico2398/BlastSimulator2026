    {
      "command": "build management_office at:90,20",
      "description": "#558: targets ground well outside the default 64x64 site (chunk index for x=90 is 5, the site's own chunks only run 0-3) -- a real click through the tile picker onto ground the site does not yet own, proving the picker can raycast the landscape past the claimed edge and that the site actually grows to cover it. #556: land is claimed and cash charged at order time exactly as before (worldSizeX grows on this step); only the building itself is now a queued site rather than an instant placement.",
      "timeout": 100,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 90,
          "z": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -8000
        },
        "equals": {
          "buildingCount": 4,
          "orderedBuildingCount": 1
        },
        "increased": ["worldSizeX"]
      }
    },
    {
      "command": "wait_until field:buildingCount equals:5 max_ticks:600",
      "description": "Drive the far-off management_office site to completion -- longer travel distance from the roster's spawn point near the site origin needs a wider budget than the near-origin orders above.",
      "timeout": 155,
