{
  "name": "blast-breaks-nothing-warning",
  "description": "#2197: a minimum Pop-Rock charge in Gnarlite carries too little energy to break any rock. The Blast step's Fire checklist and the Pre-Flight Check modal both warn that nothing breaks, and DETONATE stays usable (a warning, not a gate). Replaces the weak-explosive Charge warning of #1358, which the explosive tier no longer drives. Player clicks only.",
  "steps": [
    {
      "command": "new_game seed:42 mine_type:tropical_karst cash:500000 staffed:true",
      "timeout": 30,
      "role": "setup",
      "description": "Staffed opening on tropical_karst, whose dominant rock is Gnarlite (tier 4); full explosive catalog.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 mine_type:tropical_karst cash:500000 staffed:true"
        }
      ],
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:2 depth:6 start:15,15 diameter:0.089",
      "timeout": 60,
      "role": "player",
      "description": "Plan a 3x3 grid by dragging (15,15)-(19,19) at 2m spacing.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 19,
          "z2": 19
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 9,
          "holeCount": 0
        }
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:600",
      "timeout": 125,
      "role": "setup",
      "description": "Drain the drill orders so the holes exist.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 120000
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 9
        }
      }
    },
    {
      "command": "charge hole:* explosive:pop_rock stemming:2.5",
      "timeout": 60,
      "role": "player",
      "description": "Load the weakest explosive, Pop-Rock, at its minimum charge into every hole.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"pop_rock\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2.5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:4500",
      "timeout": 330,
      "role": "setup",
      "description": "Drain the charge orders.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 4500,
          "timeoutMs": 300000
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 9,
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "player",
      "description": "The Fire step's Pre-Flight list warns that this shot breaks nothing at all (#2197), and FIRE stays usable: a warning, not a gate.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"breakout-check\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"execute\"]"
      }
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "player",
      "description": "FIRE opens the Pre-Flight Check, which carries the same breaks-nothing warning; DETONATE is not gated by it.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-role=\"preflight-breakout-warning\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "[data-action=\"preflight-detonate\"]"
      }
    }
  ]
}
