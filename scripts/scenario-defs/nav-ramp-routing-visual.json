{
  "name": "nav-ramp-routing-visual",
  "description": "Tests vehicle/employee NavGrid-aware movement and build_ramp construction on the same map. Note: generated 'desert' terrain at this seed is a single flat bench (see #407 code-review verification) — the ramp does not gate reachability of (8,20) here, but the scenario still exercises real A*-routed, tick-by-tick vehicle movement, employee movement, and ramp construction end to end.",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0,
          "vehicleCount": 0
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler",
      "description": "Purchase a vehicle before the ramp exists.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "description": "#947: canTickVehicle now requires a driver aboard to advance on tick at all, so hauler #1 needs a driver before either `vehicle move` step below can succeed. Hired first (employee #1) so the driller hired later becomes #2 -- see that step and the `employee dispatch` step's own note on the id shift.",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "employeeCount": 1
        }
      }
    },
    {
      "command": "vehicle driver 1 1",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle driver 1 1"
        }
      ],
      "role": "bootstrap"
    },
    {
      "command": "tick 20",
      "interaction": [
        {
          "type": "command",
          "command": "tick 20"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"]
      },
      "description": "Employee #1 and hauler #1 both spawn at the same default point -- confirmed live 20 ticks is enough to board (`vehicle list` shows driver:#1 afterward)."
    },
    {
      "command": "vehicle move 1 to:8,20",
      "description": "Real click path, pre-ramp: select hauler #1 in the 3D scene, rest the cursor on (8,20), press the selection bar's MOVE HERE, then Esc to drop the selection so the bottom-docked bar cannot sit over the ramp placement strip two steps later. The old description here claimed no UI drives this command and none should exist -- false since the SelectionBar gained `move_here` (G4), usable with a mouse since ScenePicking started latching `.aim` (47f4fef). cameraFocus sits at z=21.5, one tile past the target: at the default orbit the camera ray lands about a tile short of its focus point. Measured in a real browser until the dispatched command read `vehicle move 1 to:8,20`; never adjust it arithmetically.",
      "interaction": [
        {
          "type": "clickEntity",
          "kind": "vehicle",
          "id": 1
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "cameraFocus",
          "x": 8.5,
          "z": 21.5,
          "distance": 25
        },
        {
          "type": "mousemove",
          "x": 640,
          "y": 360
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "clickSelector",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "keypress",
          "key": "Escape"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"]
      }
    },
    {
      "command": "state full",
      "description": "Pre-ramp state dump — vehicle is mid-route toward (8,20), advancing at its own speed each tick rather than jumping straight there.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build_ramp origin:5,15 direction:south length:10 depth:8",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 5,
          "z1": 15,
          "x2": 5,
          "z2": 25
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "buildingCount": 0
        }
      }
    },
    {
      "command": "vehicle move 1 to:8,20",
      "description": "Same click path again, now that the ramp exists: re-select the hauler (it has moved, so clickEntity resolves its live position rather than a baked one) and re-aim at (8,20). The same z=21.5 focus offset was re-measured after the ramp changed the terrain and still lands on (8,20).",
      "interaction": [
        {
          "type": "clickEntity",
          "kind": "vehicle",
          "id": 1
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "cameraFocus",
          "x": 8.5,
          "z": 21.5,
          "distance": 25
        },
        {
          "type": "mousemove",
          "x": 640,
          "y": 360
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "clickSelector",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "keypress",
          "key": "Escape"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "description": "#947 hired a driver first (see that step) to board hauler #1, so this driller lands as employee #2, not #1 -- the `employee dispatch` step below targets #2 accordingly.",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "employeeCount": 2
        }
      }
    },
    {
      "command": "employee dispatch 2 x:8 z:20",
      "description": "Left unmarked: no UI control drives this exact command and none should exist -- employees.ts's own `dispatch` case comment: \"no console command currently creates one... which left the Bunkhouse shift-cycle unreachable from any player-facing flow\" -- a test hook by design, same class as `employee assign_skill`. Targets employee #2 (the driller) -- #947's driver hire above took id #1.",
      "interaction": [
        {
          "type": "command",
          "command": "employee dispatch 2 x:8 z:20"
        }
      ],
      "expect": {
        "changedBy": {
          "cash": 0
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 30",
      "description": "Both the vehicle and the driller route through the ramp toward (8,20) -- confirmed via direct trace neither ever goes stuck across the full budget.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 30"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "equals": {
          "stuckEmployeeCount": 0
        }
      }
    },
    {
      "command": "inspect 8,20,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 8,20,0"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
