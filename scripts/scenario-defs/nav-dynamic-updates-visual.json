{
  "name": "nav-dynamic-updates-visual",
  "description": "Tests NavGrid updates after blast execution changes terrain",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:1 depth:6 start:10,10",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 10,
          "z1": 10,
          "x2": 10,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 1
        }
      }
    },
    {
      "command": "charge hole:H1 explosive:boomite amount:8kg stemming:2m",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H1 explosive:boomite amount:8kg stemming:2m"
        }
      ],
      "description": "Left unmarked: Charge.ts's own header comment says per-hole charging isn't a UI feature -- Charge All (all holes, one shared amount/stemming) is the only commit. `charge hole:H1 ...` (one specific hole) has no click path at all (Finding #10's class).",
      "expect": {
        "equals": {
          "chargedCount": 1
        }
      }
    },
    {
      "command": "sequence auto",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 1
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle buy debris_hauler",
      "description": "Purchase a vehicle and send it across the grid — its position should advance tick by tick via the NavGrid-aware pathfinding stepper.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 25000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle move 1 to:15,15",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle move 1 to:15,15"
        }
      ],
      "description": "Left unmarked: no UI control drives this exact command and none should exist -- FleetPanel.ts only wires vehicle buy/driver/scrap to the console (grep confirms no `vehicle move`/`vehicle assign` call site anywhere in src/ui) -- vehicles move autonomously via task/haul assignment, never by a player teleporting one to a raw x,z.",
      "expect": {
        "equals": {
          "cash": 25000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "note": "vehicle list confirms real NavGrid-aware movement toward (15,15) — position advances from spawn each tick"
      }
    },
    {
      "command": "state full",
      "description": "Final state dump — vehicle should have advanced toward its destination along the NavGrid path.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
