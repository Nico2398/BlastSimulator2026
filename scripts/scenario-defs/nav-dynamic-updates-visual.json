{
  "name": "nav-dynamic-updates-visual",
  "description": "Tests NavGrid updates after blast execution changes terrain",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:1 depth:6 start:10,10",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 10,
          "z1": 10,
          "x2": 10,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 1
        }
      }
    },
    {
      "command": "charge hole:H1 explosive:boomite amount:8kg stemming:2m",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"][data-selected=\"true\"]"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "8 kg"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "2.0 m"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-hole=\"H1\"] [data-action=\"charge-hole\"]"
        }
      ],
      "description": "role: player (issue #515): the old \"no UI feature\" reasoning is stale \u2014 Charge.ts's own header comment records that per-hole charging (gap G3) got a real control, ChargeHoleList's `[data-hole=\"H1\"] [data-action=\"charge-hole\"]`, which commits the panel's current product/amount/stemming to one hole instead of all of them.",
      "expect": {
        "equals": {
          "chargedCount": 1
        }
      },
      "role": "player"
    },
    {
      "command": "sequence auto",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 1
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle buy debris_hauler",
      "description": "Purchase a vehicle and send it across the grid — its position should advance tick by tick via the NavGrid-aware pathfinding stepper.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 25000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle move 1 to:15,15",
      "interaction": [
        {
          "type": "clickEntity",
          "kind": "vehicle",
          "id": 1
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "cameraFocus",
          "x": 15.5,
          "z": 16.5,
          "distance": 25
        },
        {
          "type": "mousemove",
          "x": 640,
          "y": 360
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "clickSelector",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        }
      ],
      "description": "Real click path: select hauler #1 in the 3D scene, rest the cursor on the destination tile, then press the selection bar's MOVE HERE. The old description here claimed no UI drives this command and none should exist -- that is false since the SelectionBar gained `move_here` (G4), and it was only unusable with a mouse until ScenePicking started latching `.aim` separately from the live hover (47f4fef). cameraFocus sits at z=16.5, one tile past the target: at the default orbit the camera ray hits terrain about a tile short of its focus point, so the offset was calibrated in a real browser until the dispatched command read exactly `vehicle move 1 to:15,15`. Never adjust it arithmetically -- re-measure.",
      "role": "player",
      "expect": {
        "equals": {
          "cash": 25000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "note": "vehicle list confirms real NavGrid-aware movement toward (15,15) — position advances from spawn each tick"
      }
    },
    {
      "command": "state full",
      "description": "Final state dump — vehicle should have advanced toward its destination along the NavGrid path.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
