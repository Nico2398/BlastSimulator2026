{
  "name": "i18n-display-visual",
  "description": "Visual verification of internationalization (i18n) system: English text displays correctly throughout UI including HUD, menus, contract panel, event dialogs, and score labels. All fictional names (rocks, explosives, buildings, vehicles) display without unresolved i18n keys.",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "wellBeing": 50,
          "safety": 50,
          "ecology": 50,
          "nuisance": 50,
          "employeeCount": 0,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000
        }
      }
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "contract list",
      "interaction": [
        {
          "type": "command",
          "command": "contract list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "time status",
      "interaction": [
        {
          "type": "command",
          "command": "time status"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 15,15,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 15,15,0"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "cash": 50000,
          "wellBeing": 50,
          "safety": 50,
          "ecology": 50,
          "nuisance": 50,
          "employeeCount": 0,
          "buildingCount": 0
        },
        "note": "this whole file is read-only (scores/finances/contract list/time status/employee list/build list/inspect) -- nothing in state ever moves between the setup and this final check, since its purpose is visual i18n text verification, not gameplay"
      }
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "hud-text",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "panel-text",
      "yaw": 45,
      "pitch": 30
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
