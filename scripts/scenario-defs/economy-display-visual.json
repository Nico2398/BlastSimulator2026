{
  "name": "economy-display-visual",
  "description": "Visual verification of the economy display: cash balance in HUD top bar, income/expenses in financial summary, contract income reflection, building maintenance costs, employee salaries, and vehicle maintenance costs.",
  "steps": [
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000
        }
      }
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1
        }
      }
    },
    {
      "command": "employee hire role:blaster",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 2
        }
      }
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 3
        }
      }
    },
    {
      "command": "tick 10",
      "description": "Payroll and the three hiring costs together drive the expense breakdown this file exists to demonstrate.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "wellBeing"
        ]
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons. Decides whether an event is pending from authoritative game state, not from whether the modal has rendered -- a DOM-only probe silently missed events on a no-GPU runner where a frame costs ~6s, leaving them pending so later ticks halted and the run diverged while still passing command mode.",
      "role": "player"
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle buy debris_hauler",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "build freight_warehouse at:25,25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 25,
          "z": 25
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "tick 10",
      "description": "Maintenance and vehicle fuel/upkeep join payroll in the expense breakdown from here on.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "wellBeing"
        ]
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons. Decides whether an event is pending from authoritative game state, not from whether the modal has rendered -- a DOM-only probe silently missed events on a no-GPU runner where a frame costs ~6s, leaving them pending so later ticks halted and the run diverged while still passing command mode.",
      "role": "player"
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "contract list",
      "interaction": [
        {
          "type": "command",
          "command": "contract list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "contract accept 1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"contracts\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-contract-panel .bs-contract-accept"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "activeContractCount": 1
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "wellBeing"
        ],
        "equals": {
          "activeContractCount": 1
        }
      }
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "employeeCount": 3,
          "vehicleCount": 1,
          "buildingCount": 1,
          "activeContractCount": 1
        }
      }
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "hud-closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "finances-panel",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "contracts-view",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
