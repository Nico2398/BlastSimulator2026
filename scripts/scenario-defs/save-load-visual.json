{
  "name": "save-load-visual",
  "description": "Visual verification of the save/load UI: multiple save slots, auto-save indicator, save/load buttons, export/import options, slot metadata display (date, level, cash, playtime), and IndexedDB backend for web persistence.",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup"
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup"
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup"
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "command",
          "command": "event choose 0"
        }
      ],
      "description": "event choose 0 -- follows a bare tick, so whether an event is pending is a random roll; there may be no dialog on screen. Deliberately left unmarked (Finding #15)."
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup"
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "command",
          "command": "event choose 0"
        }
      ],
      "description": "event choose 0 -- follows a bare tick, so whether an event is pending is a random roll; there may be no dialog on screen. Deliberately left unmarked (Finding #15)."
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "save slot:quicksave",
      "description": "Left unmarked: \"quicksave\" isn't a real UI slot -- SavesModal.ts only exposes 'auto' and numbered 'slot_N' (SAVE_SLOT_COUNT) slots. The real UI flow is demonstrated for real below (steps 10/11/16, clicking #bs-saveload-btn and a numbered slot), just under a different slot name than this console-only quicksave.",
      "interaction": [
        {
          "type": "command",
          "command": "save slot:quicksave"
        }
      ]
    },
    {
      "command": "state",
      "description": "Open the Save/Load panel (multiple slots, auto-save row, export/import, slot metadata) via its top-bar button.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-saveload-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-saves-modal"
        }
      ],
      "role": "player"
    },
    {
      "command": "state",
      "description": "SavesModal.ts's saveToSlot() re-renders the slot list but never calls hide() (unlike loadFromSlot(), which does) -- the modal stays open after a save and its .bs-confirm-overlay tier covers the toolbar underneath, blocking the next step's click. Closes it explicitly via the header's close button.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"save-here\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "clickSelector",
          "selector": "#bs-saves-modal > div > div:first-child button"
        }
      ],
      "role": "player"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:3 depth:4 start:15,15",
      "description": "Drill a small plan after slot 1 was saved, so the blast below craters terrain the saved slot does not know about.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 18,
          "z2": 18
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "blast",
      "description": "Blast a crater into the live scene after slot 1's save, so the load step below must actually regenerate terrain (not just leave the cratered grid on screen) to prove itself.",
      "timeout": 15,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "state",
      "description": "Load back slot 1 by clicking the Saves modal's own Load button (SavesModal.ts, main.ts's setOnLoad handler) — not a raw console command — so this step exercises the click-driven path that must regenerate the grid, replacing the post-blast crater above with clean terrain matching the saved state. The command field stays the inert `state` read (rather than `load slot:...`) so command mode does not pre-clear the crater itself and mask a regression in the click path.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-saveload-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-saves-modal"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"load\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player"
    },
    {
      "command": "campaign status",
      "interaction": [
        {
          "type": "command",
          "command": "campaign status"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "game-state",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "hud-detail",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
