{
  "name": "building-research-progression-visual",
  "description": "Visual check of the research tier-gate: Tier 1 Research Center placed, a direct Tier 2 attempt rejected, Tier 2 researched instantly (cost-only), an early Tier 3 attempt rejected by the conditions gate, then Tier 3 progresses over ticks and becomes buildable once its own Tier 2 research has completed",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup"
    },
    {
      "command": "build research_center at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"research_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build research_center at:15,5 tier:2",
      "description": "Left unmarked: at this point the button is genuinely disabled (tier not yet researched / affordable, or the target id doesn't exist), so a real player could not click it either -- this step deliberately demonstrates the rejection command mode shows via the same disabled-button rule that gates the UI. Not converted to a click; the console command reproduces the same no-op the disabled button would.",
      "interaction": [
        {
          "type": "command",
          "command": "build research_center at:15,5 tier:2"
        }
      ]
    },
    {
      "command": "build list",
