{
  "name": "building-destruction-visual",
  "description": "Visual check of building destruction via blast: drill, charge, sequence, and detonate near warehouses",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build explosive_warehouse at:20,20",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 20,
          "z": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 30000,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build freight_warehouse at:25,25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 25,
          "z": 25
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 15000,
          "buildingCount": 2
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:5 depth:6 start:15,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 25,
          "z2": 25
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 9
        }
      },
      "description": "depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged."
    },
    {
        "command": "charge hole:* explosive:boomite amount:8 stemming:1",
        "interaction": [
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-step=\"2\"]"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-btn:last-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-btn:first-child"
          },
          {
            "type": "assert",
            "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"][data-selected=\"true\"]"
          },
          {
            "type": "assert",
            "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-value",
            "property": "textContent",
            "expectedValue": "8 kg"
          },
          {
            "type": "assert",
            "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-value",
            "property": "textContent",
            "expectedValue": "1.0 m"
          },
          {
            "type": "clickSelector",
            "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
          }
        ],
        "description": "role: player (issue #515): the Charge step's amount/stemming steppers and product-card explosive selector are real controls \u2014 this reaches the declared explosive/amount/stemming via clicks instead of Charge All using whatever the panel's fields already showed.",
        "expect": {
          "equals": {
            "chargedCount": 9
          }
        },
        "role": "player"
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      }
    },
    {
      "command": "blast",
      "timeout": 20,
      "frames": 6,
      "interval": 50,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0,
          "buildingCount": 0
        },
        "note": "both warehouses (200/150 max HP) are within the blast's damage radius and get destroyed \u2014 the file's own stated purpose, confirmed via a real dump (blast rating CATASTROPHIC, 'Buildings destroyed: explosive_warehouse #1, freight_warehouse #2')"
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "pre-blast",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "post-blast",
      "yaw": 45,
      "pitch": 30
    },
    {
      "name": "destruction-closeup",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
