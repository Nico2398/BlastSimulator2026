{
  "name": "survey-panel-visual",
  "description": "Redesign P7: SurveyPanel wired into UIManager in place of SurveyUI.ts — method cards, PICK TARGET IN SCENE, and a real result render through the actual toolbar click.",
  "steps": [
    {
      "command": "new_game seed:42 size:24",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:24"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "employeeCount": 0,
          "cash": 50000
        }
      }
    },
    {
      "command": "employee hire role:surveyor",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ],
      "role": "player",
      "expect": {
        "increased": ["employeeCount"],
        "equals": {
          "cash": 48800
        }
      }
    },
    {
      "command": "survey seismic x:40 z:10",
      "description": "#558: targets ground outside the 24x24 site this scenario started with (chunk (2,0) at x:32-47 does not touch the site's own chunks (0,0)/(1,0)) -- a real click through PICK TARGET IN SCENE, proving both that the picker can raycast past the claimed edge (fence 1) and that the site actually grows to cover it.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"survey\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-panel [data-method=\"seismic\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-survey-run"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 40,
          "z": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "increased": ["worldSizeX"],
        "decreased": ["cash"]
      }
    }
  ]
}
