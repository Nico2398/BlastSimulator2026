{
  "name": "survey-panel-visual",
  "description": "Redesign P7: SurveyPanel wired into UIManager in place of SurveyUI.ts — method cards, PICK TARGET IN SCENE, and a real result render through the actual toolbar click.",
  "steps": [
    {
      "command": "new_game seed:42 size:24",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:24"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "employeeCount": 0,
          "cash": 50000
        }
      }
    },
    {
      "command": "employee hire role:surveyor",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ],
      "role": "player",
      "expect": {
        "increased": ["employeeCount"],
        "equals": {
          "cash": 48800
        }
      }
    }
  ]
}
