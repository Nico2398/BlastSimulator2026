      "interaction": [
        {
          "type": "command",
          "command": "needs"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 50",
      "interaction": [
        {
          "type": "command",
          "command": "tick 50"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash",
          "minFatigue"
        ],
        "note": "all 3 employees show identical, uniform gauge values by this point (no dispatched work to differentiate them), matching the file's own claimed color-coding demonstration"
      }
    },
