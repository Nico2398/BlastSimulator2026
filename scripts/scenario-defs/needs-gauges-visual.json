{
  "name": "needs-gauges-visual",
  "description": "Visual check of need gauge display: hire 3 employees, advance ticks to drain the fatigue gauge, then verify needs command shows a decreasing fatigue value per employee with color-coding thresholds (green >50, yellow 30-50, red <30) (#928 — fatigue is the sole gauge; hunger and breakNeed were removed)",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 30,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "employeeCount": 0
        }
      }
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "employeeCount": 1
        },
        "changedBy": {
          "cash": -1000
        }
      }
    },
    {
      "command": "employee hire role:blaster",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "employeeCount": 2
        },
        "changedBy": {
          "cash": -1500
        }
      }
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "employeeCount": 3
        },
        "changedBy": {
          "cash": -800
        }
      }
    },
    {
      "command": "needs",
      "interaction": [
        {
          "type": "command",
          "command": "needs"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "minFatigue"
        ],
        "note": "5 ticks isn't enough to cross a payroll cycle yet, so cash doesn't move — only minFatigue is safe to assert here"
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons. Decides whether an event is pending from authoritative game state, not from whether the modal has rendered -- a DOM-only probe silently missed events on a no-GPU runner where a frame costs ~6s, leaving them pending so later ticks halted and the run diverged while still passing command mode.",
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "needs",
      "interaction": [
        {
          "type": "command",
          "command": "needs"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 15",
      "interaction": [
        {
          "type": "command",
          "command": "tick 15"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash",
          "minFatigue"
        ]
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons. Decides whether an event is pending from authoritative game state, not from whether the modal has rendered -- a DOM-only probe silently missed events on a no-GPU runner where a frame costs ~6s, leaving them pending so later ticks halted and the run diverged while still passing command mode.",
      "role": "player",
      "commandOutcome": "either"
