{
  "name": "blast-debris-stranded-pip",
  "description": "Stranded debris summary pip (#1302): after the single-hole blast, with warehouse, hauler and driver in place but no ramp, the topbar shows one neutral \"N OUT OF REACH\" pip instead of per-action warn toasts.",
  "steps": [
    {
      "command": "campaign start level:tutorial_pit cash:2000000",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:tutorial_pit cash:2000000"
        }
      ],
      "description": "Open tutorial_pit with a large purse: the crew draws wages across the long haul, and the ramp order below must stay affordable.",
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 2000000
        }
      }
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1
        }
      },
      "description": "Hire the driller who will drill and charge the single blast hole."
    },
    {
      "command": "employee assign_skill 1 skill:blasting level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:blasting level:5"
        }
      ],
      "description": "Bootstrap blasting proficiency so the driller can charge.",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "vehicle buy drill_rig",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy the drill rig.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:driving.drill_rig level:1",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.drill_rig level:1"
        }
      ],
      "description": "Licence the driller for the drill rig.",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:6 start:18,10 diameter:0.089",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 18,
          "z1": 10,
          "x2": 18,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 1,
          "holeCount": 0
        }
      },
      "description": "A single hole at (18,10). With charge amount:3 stemming:2 this blast leaves the three cells (18,9), (19,10), (18,10) in a pocket the ground crew cannot reach (traced in tests/integration/blast-debris-reachability.integration.test.ts). Stranded debris is a normal outcome the player owns (#1302), not a defect: the blast physics decides where debris lands."
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:600",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 120000
        }
      ],
      "description": "Wait for the driller to drill the ordered hole.",
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 1
        }
      },
      "timeout": 125
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Defensive: a `tick N` step silently completes fewer ticks than requested if a random event fires mid-wait, and every subsequent tick then refuses until the event is resolved. No-op when nothing is pending.",
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "charge hole:* explosive:boomite amount:3 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 3
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"boomite\"][data-selected=\"true\"]"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"amount\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "3 kg"
        },
        {
          "type": "assert",
          "selector": "#bs-blast-panel [data-field=\"stemming\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "2.0 m"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "Charge the hole: boomite 3 kg, stemming 2 m.",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "role": "player"
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "timeout": 125,
      "description": "#554: drain the charge order(s) queued by the step above (charging is real work, not instant) before continuing.",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"8\"]"
        },
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 1,
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "sequence auto",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 1
        }
      },
      "description": "Sequence the single hole."
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      },
      "description": "Fire the blast. Debris lands wherever physics puts it; part of it ends up in a pocket nobody can drive to. No reachability check touches fragment placement (#1302)."
    },
    {
      "command": "build freight_warehouse at:1,8",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 1,
          "z": 8
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedBuildingCount": 1
        }
      },
      "description": "Order the freight warehouse at (1,8): it anchors the ground-crew reachable set."
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "description": "Hire the driver who will crew the rock digger.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 2
        }
      }
    },
    {
      "command": "employee assign_skill 2 skill:driving.excavator level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 2 skill:driving.excavator level:5"
        }
      ],
      "description": "Bootstrap the excavator licence for the digger driver.",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "vehicle buy rock_digger",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy the rock digger that will carve the ramp.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "vehicle driver 2 2",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle driver 2 2"
        }
      ],
      "description": "Crew the rock digger (vehicle 2) with driver 2.",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:400",
      "description": "Wait for the warehouse to be built.",
      "timeout": 130,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 400,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "description": "Hire the driver for the debris hauler.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 3
        }
      }
    },
    {
      "command": "employee assign_skill 3 skill:driving.truck level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 3 skill:driving.truck level:5"
        }
      ],
      "description": "Licence the hauler driver.",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "vehicle buy debris_hauler",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy the debris hauler while the pocket is still cut off.",
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "vehicle driver 3 3",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle driver 3 3"
        }
      ],
      "description": "Crew the hauler with the truck-licensed driver.",
      "role": "bootstrap",
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "tick 30",
      "description": "Capture the pip screenshot for visual inspection: hauler and driver are ready but the pocket is cut off, so the topbar should show the neutral OUT OF REACH pip and no per-piece warn toasts. The expect asserts only that wages ran (cash decreased).",
      "interaction": [
        {
          "type": "command",
          "command": "tick 30"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    }
  ]
}
