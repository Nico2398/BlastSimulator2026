{
  "name": "workshop-explain-visual",
  "description": "Blast workshop explanations (#2168): a player hovers a Drill-step hole status chip and the stat-strip Spacing label with the real pointer, then clicks a hole row, which opens that hole's inspector.",
  "steps": [
    {
      "command": "new_game seed:42 staffed:true cash:320000",
      "timeout": 30,
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 staffed:true cash:320000"
        }
      ],
      "expect": {
        "equals": {
          "cash": 320000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:4 depth:6 start:15,15",
      "timeout": 30,
      "role": "setup",
      "description": "Orders four holes so the Drill step lists rows with an ORDERED chip.",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan grid rows:2 cols:2 spacing:4 depth:6 start:15,15"
        }
      ]
    },
    {
      "command": "state",
      "timeout": 40,
      "role": "player",
      "description": "Open the Blast Workshop Drill step and hover a hole row's status chip; its explanation tooltip is screenshotted.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel .bsx-chip[data-explain]"
        },
        {
          "type": "hoverSelector",
          "selector": "#bs-blast-panel .bsx-chip[data-explain]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel .bsx-chip[data-explain]"
      }
    },
    {
      "command": "state",
      "timeout": 40,
      "role": "player",
      "description": "Click the first hole row; the hole inspector opens on that hole.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-select-kind=\"hole\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector[data-kind=\"hole\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "usable": "#bs-inspector[data-kind=\"hole\"]"
      }
    }
  ]
}
