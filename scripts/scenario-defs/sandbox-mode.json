{
  "name": "sandbox-mode",
  "description": "Sandbox mode: a site built from biome/difficulty/seed starts from nothing, honours the seed, and is fully playable through to a blast (#504: 3-control setup).",
  "steps": [
    {
      "command": "sandbox start biome:alpine_granite difficulty:hard seed:777",
      "description": "No new_game first — a sandbox site is created from nothing, which is the point of the mode.",
      "interaction": [
        { "type": "command", "command": "sandbox start biome:alpine_granite difficulty:hard seed:777" }
      ],
      "role": "setup"
    },
    {
      "command": "terrain_info",
      "description": "Biome and seed should match what was asked for. Grid extents are the fixed 64x32x64 default regardless of request (#504).",
      "interaction": [
        {
          "type": "command",
          "command": "terrain_info"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "seed": 777,
          "worldSizeX": 64,
          "worldSizeZ": 64,
          "mineType": "alpine_granite"
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:6 start:20,20",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-toolbar [data-panel=\"blast\"]" },
        { "type": "clickSelector", "selector": "#bs-blast-panel [data-action=\"grid-tool\"]" },
        { "type": "waitForSelector", "selector": "#bs-tile-select-confirm" },
        { "type": "clickSelector", "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child" },
        { "type": "dragTiles", "x1": 20, "z1": 20, "x2": 28, "z2": 28 },
        { "type": "clickSelector", "selector": "#bs-tile-select-confirm" }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 9,
          "cash": 50000
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-blast-panel [data-action=\"charge-all\"]" }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 9,
          "cash": 50000
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]" }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      }
    },
    {
      "command": "blast",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-blast-panel [data-action=\"execute\"]" },
        { "type": "waitForSelector", "selector": ".bs-confirm-overlay .bs-btn-danger" },
        { "type": "clickSelector", "selector": ".bs-confirm-overlay .bs-btn-danger" },
        { "type": "waitForSelector", "selector": "[data-action=\"report-close\"]" },
        { "type": "clickSelector", "selector": "[data-action=\"report-close\"]" }
      ],
      "timeout": 30,
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0,
          "cash": 50000
        }
      }
    },
    {
      "command": "sandbox start biome:tropical_karst difficulty:easy seed:31337",
      "description": "A second site with a different biome, difficulty and seed, to confirm the mode can be re-entered.",
      "interaction": [
        { "type": "command", "command": "sandbox start biome:tropical_karst difficulty:easy seed:31337" }
      ],
      "expect": {
        "equals": {
          "cash": 250000,
          "seed": 31337,
          "worldSizeX": 64,
          "worldSizeZ": 64,
          "mineType": "tropical_karst",
          "holeCount": 0
        },
        "note": "difficulty:easy starts at $250,000 (SANDBOX_DIFFICULTIES.easy.startingCash, Sandbox.ts) -- grid extents stay the fixed 64x32x64 default (#504) regardless of biome/difficulty, same as the first site."
      },
      "role": "setup"
    }
  ]
}
