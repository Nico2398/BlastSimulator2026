{
  "name": "blast-drill-plan-ui",
  "description": "Visual verification of drill plan UI: grid creation, hole markers, camera orbit, replace grid",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup"
    },
    {
      "command": "drill_plan grid rows:3 cols:4 spacing:5 depth:6 start:12,12",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 12,
          "z1": 12,
          "x2": 27,
          "z2": 22
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "drill_plan show",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan show"
        }
      ],
      "role": "observe"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:8 depth:10 start:20,20",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 28,
          "z2": 28
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "description": "drill_plan grid rows:2 cols:2 spacing:8 depth:10 start:20,20 BlastWorkshop auto-advances Drill -> Charge once holes exist, so re-using the grid tool needs an explicit click back to the Drill tab ([data-step=\"1\"]) first."
    },
    {
      "command": "drill_plan show",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan show"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "side",
      "yaw": 180,
      "pitch": 30
    },
    {
      "name": "xray-underground",
      "yaw": 45,
      "pitch": -20
    }
  ]
}
