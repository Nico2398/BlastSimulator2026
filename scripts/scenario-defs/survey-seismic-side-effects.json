{
  "name": "survey-seismic-side-effects",
  "description": "Validates seismic survey side effects: run a seismic survey and verify that it triggers vibration, disturbs nearby employees, and potentially causes minor events. The overlay should show the seismic coverage radius. Requires the survey overlay to be wired into syncFromContext().",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "increased": [
          "worldSizeX"
        ]
      }
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "employee hire role:surveyor",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"surveyor\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "employeeCount": 1
        },
        "changedBy": {
          "cash": -1200
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:geology level:5",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:geology level:5"
        }
      ],
      "description": "Test-only bootstrap, not a player action: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts, same for the UI hire button and this console command), so this only raises the level for the scenario's needs. No role tag -- there is no UI control for this and none should exist; the player-facing way to raise a skill is `employee train` at a training building. Command mode keeps running it unchanged; interaction mode keeps it as an unmarked (legacy) command step.",
      "expect": {
        "equals": {
          "proficiencyTotal": 5
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "employeeCount": 2
        },
        "changedBy": {
          "cash": -800
        }
      }
    },
    {
      "command": "employee assign_skill 2 skill:driving.truck level:3",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 2 skill:driving.truck level:3"
        }
      ],
      "description": "Test-only bootstrap — see the assign_skill step above for why this stays an unmarked (legacy) command step in interaction mode too. Category fixed from the bare 'driving' typo (not a valid SkillCategory — VALID_SKILL_CATEGORIES only has 'driving.truck'/'driving.digger'/etc.) to 'driving.truck', matching the driver role's own default qualification (issue #585).",
      "expect": {
        "equals": {
          "proficiencyTotal": 8
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "build living_quarters at:22,20",
