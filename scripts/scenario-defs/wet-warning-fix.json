{
  "name": "wet-warning-fix",
  "description": "#2267: a storm floods a charged hole in porous rock. On the Fire step the player fixes it from the warning row itself, by clicks alone: the row says tubing comes first and shows Drain disabled with that reason, Buy tubing and Tube make the hole drainable, Drain empties it, the warning clears and cash drops by the drain cost.",
  "steps": [
    {
      "command": "new_game seed:42 size:31 staffed:true cash:150000",
      "description": "Staffed opening on a 31-cell desert site: a driller with blasting + drill_rig licence and an unmanned drill_rig come free at game-open. Seed 42 puts hole (15,15) on porous rock (porosity 0.35), so a wet hole there cannot be drained until it is tubed.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:31 staffed:true cash:150000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 150000,
          "holeCount": 0
        }
      },
      "timeout": 30
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:5 depth:6 start:15,15",
      "description": "One hole by real clicks: a zero-size drag over tile (15,15) is a 1x1 grid, so one drain or tube click is one console command.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 15,
          "z2": 15
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 1,
          "holeCount": 0
        }
      }
    },
    {
      "command": "wait_until field:holeCount equals:1 max_ticks:400",
      "description": "The staffed driller lands the hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 1,
          "maxTicks": 400,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "holeCount": 1,
          "orderedHoleCount": 0
        }
      },
      "timeout": 125
    },
    {
      "command": "event choose 0",
      "description": "Dismiss an event that may have fired during the wait.",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "charge hole:* explosive:boomite stemming:2m",
      "description": "Charge the hole with boomite (water-sensitive) by real clicks: boomite, 5 kg and 2 m stemming are the panel's own defaults, asserted rather than assumed.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "timeout": 60
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "description": "The blaster loads the charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 380000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 1,
          "orderedChargeCount": 0
        }
      },
      "timeout": 410
    },
    {
      "command": "weather set storm",
      "description": "A storm falls on the untubed, charged hole. Bootstrap: weather has no UI control.",
      "interaction": [
        {
          "type": "command",
          "command": "weather set storm"
        }
      ],
      "role": "bootstrap",
      "expect": {
        "equals": {
          "weather": "storm"
        }
      }
    },
    {
      "command": "wait_until field:wetHoleCount equals:1 max_ticks:200",
      "description": "Rain floods the bare hole within a few ticks.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "wetHoleCount",
          "equals": 1,
          "maxTicks": 200,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "wetHoleCount": 1
        }
      },
      "timeout": 125
    },
    {
      "command": "time pause",
      "description": "Freeze the clock so cash only moves by what the player clicks.",
      "interaction": [
        {
          "type": "command",
          "command": "time pause"
        }
      ],
      "role": "setup"
    },
    {
      "command": "event choose 0",
      "description": "Dismiss an event the storm may have raised before the Fire step is read.",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "drain_hole hole:H1",
      "description": "Fire step, wet row: the flooded hole sits in porous rock, so the warning says tubing comes first and its Drain action is shown disabled with that reason instead of being hidden. The console refuses the same drain.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-role=\"water-fixes\"] [data-role=\"water-tube-first\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "guard",
      "expect": {
        "equals": {
          "wetHoleCount": 1
        },
        "changedBy": {
          "cash": 0
        },
        "blocked": "#bs-blast-panel [data-action=\"water-drain\"]",
        "note": "#2267 -- porous untubed hole: drain is disabled, tubing first."
      },
      "commandOutcome": "refused",
      "timeout": 60
    },
    {
      "command": "buy amount:10",
      "description": "No tubing in stock, so the row offers Buy tubing. One click buys ten units ($500) and the Tube action becomes usable.",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"water-buy-tubing\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"water-buy-tubing\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"water-tube\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -500
        },
        "usable": "#bs-blast-panel [data-action=\"water-tube\"]"
      },
      "timeout": 60
    },
    {
      "command": "install_tubing hole:H1",
      "description": "Tube action on the warning row: tubing the flooded hole keeps new water out but does not remove the water already in it, and unblocks draining.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"water-tube\"]"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"water-drain\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "wetHoleCount": 1
        },
        "usable": "#bs-blast-panel [data-action=\"water-drain\"]"
      },
      "timeout": 60
    },
    {
      "command": "drain_hole hole:H1",
      "description": "Drain action on the same row: the hole is emptied for the per-hole drain cost, and the wet warning with its fixes leaves the Fire step.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"water-drain\"]"
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-blast-panel:not(:has([data-role=\"water-fixes\"]))",
          "property": "id",
          "expectedValue": "bs-blast-panel",
          "timeoutMs": 10000
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -20
        },
        "equals": {
          "wetHoleCount": 0
        },
        "usable": "#bs-blast-panel [data-action=\"execute\"]",
        "note": "The waitForProperty above proves the water-fixes block is gone from the Fire step."
      },
      "timeout": 60
    }
  ]
}
