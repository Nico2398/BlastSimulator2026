{
  "name": "sandbox-second-bench-buried",
  "description": "Buried holes (#1937): after the first blast, a hole planned on the crater floor sits under on-ground rubble. It stays queued and undrilled while the rubble lies there, then is drilled once the haulers have cleared it. A ramp gives the haulers and rig a way into the crater; a small blast keeps the rubble within the freight warehouse.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site (kit:full): tier-1 drill rig only, so only 89 mm holes can be drilled at first.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "build explosive_warehouse at:8,8",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front so charging needs no delivery wait.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "The explosive warehouse is built.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "buy explosive:boomite kg:100",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        }
      ],
      "description": "Buy enough krackle for both blasts into the warehouse stock.",
      "expect": {
        "decreased": [
          "cash"
        ]
      },
      "role": "player"
    },
    {
      "command": "drill_plan add x:36 z:31 depth:2 diameter:89",
      "role": "player",
      "description": "Order one 89 mm, 2 m hole on the virgin bench; it will be blasted away.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "build_ramp start:27,31 end:35,31 depth:2",
      "role": "player",
      "description": "Dig a ramp into the bench so the haulers and the drill rig can reach the crater floor once it is blasted. 8 m long for a 2 m depth is 14.0 degrees, inside the 20 degree limit every vehicle shares (#2045); the ramp tool refuses anything steeper.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 32,
          "z": 31,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 27,
          "z1": 31,
          "x2": 35,
          "z2": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "orderedRampSegmentCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "The 89 mm hole is drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "wait_until field:builtRampCount equals:1 max_ticks:800",
      "role": "setup",
      "description": "The ramp is dug.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "builtRampCount",
          "equals": 1,
          "maxTicks": 800,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "builtRampCount": 1,
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "tick 30",
      "role": "setup",
      "description": "The ramp crew clears off the bench before the charge goes in.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 30"
        }
      ]
    },
    {
      "command": "charge hole:* explosive:boomite amount:2 stemming:1",
      "role": "player",
      "description": "Load 2 kg into the hole.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 1
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "The charge is loaded.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "blast detonate",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 120000
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "description": "The hole is consumed and rubble lies where it stood.",
      "timeout": 90,
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "Blast the first bench; the broken rock lies on the new crater floor as on-ground rubble.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan add x:36 z:31 depth:2 diameter:89",
      "role": "player",
      "description": "Second bench: plan a hole on the crater floor, under the fresh rubble. The order is accepted (planning is never refused).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "tick 40",
      "role": "setup",
      "description": "40 ticks is longer than an unobstructed rig needs to drill a 2 m hole, yet too short to haul the rubble off: a hole under rubble cannot be claimed (#1937), so the order stays queued (buried_under_rubble) and undrilled while the rubble lies there.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 40"
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 1,
          "holeCount": 0
        }
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "role": "setup",
      "description": "Haulers clear the buried-hole rubble first (#1937 haul priority); once uncovered the hole is drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 600000
        }
      ],
      "timeout": 630,
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 1
        }
      }
    }
  ]
}
