{
  "name": "sandbox-wide-holes",
  "description": "Hole diameter (#1934): with only a tier-1 rig a 127 mm grid is refused and 16 kg will not load into an 89 mm, 8 m hole. After buying a tier-2 rig the player steps the Drill diameter to 127 mm, drills two 8 m holes, loads 16 kg into each (about 4.07 kg/m instead of 2) and fires.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42 grade:4",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42 grade:4"
        }
      ],
      "description": "Progression site (kit:full): tier-1 drill rig only, so only 89 mm holes can be drilled at first.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 4,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "build explosive_warehouse at:8,8",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front so charging needs no delivery wait.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "The explosive warehouse is built.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "buy explosive:boomite kg:100",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        }
      ],
      "description": "Buy enough krackle for both blasts into the warehouse stock.",
      "expect": {
        "decreased": [
          "cash"
        ]
      },
      "role": "player"
    },
    {
      "command": "drill_plan add x:36 z:30 depth:8 diameter:89",
      "role": "player",
      "description": "Order one 89 mm hole, 8 m deep, on the kit's tier-1 rig. Stepper stays on its 89 mm default.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 8
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 30
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 30
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "The 89 mm hole is drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:H1 explosive:boomite amount:16 stemming:2",
      "role": "guard",
      "commandOutcome": "refused",
      "description": "16 kg with 2 m stemming needs a 8 m column; an 89 mm hole (2 kg/m) in an 8 m hole holds 12 kg at most, so the charge is refused.",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H1 explosive:boomite amount:16 stemming:2"
        }
      ],
      "expect": {
        "blocked": "#bs-blast-panel [data-action=\"charge-all\"]",
        "equals": {
          "orderedChargeCount": 0
        },
        "note": "the Charge step cannot order a 16 kg load into an 89 mm, 8 m hole (interaction mode only)"
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:2 spacing:4 depth:8 diameter:127 start:36,30",
      "role": "player",
      "commandOutcome": "refused",
      "description": "With only a tier-1 rig, a 127 mm grid is refused (command mode); in the browser the player opens the Drill strip and its diameter stepper reads 89 mm, the only size the fleet can bore.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-param-strip [data-field=\"diameter\"]"
        },
        {
          "type": "assert",
          "selector": "#bs-param-strip [data-field=\"diameter\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "89 mm"
        },
        {
          "type": "assert",
          "selector": "#bs-param-strip [data-field=\"diameter\"] .bsx-stepper-value",
          "property": "textContent",
          "expectedValue": "89 mm"
        }
      ],
      "expect": {
        "usable": "#bs-param-strip [data-field=\"diameter\"] .bsx-stepper-btn:last-child",
        "equals": {
          "orderedHoleCount": 0
        },
        "note": "the diameter stepper reads 89 mm without a tier-2 rig (interaction mode only)"
      }
    },
    {
      "command": "vehicle buy drill_rig tier:2",
      "role": "player",
      "description": "Buy a tier-2 drill rig (#6): it bores 127 mm holes.",
      "interaction": [
        {
          "type": "keypress",
          "key": "Escape"
        },
        {
          "type": "ensurePanel",
          "panel": "vehicles"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"2\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 6
        }
      }
    },
    {
      "command": "employee assign_skill 1 skill:driving.drill_rig level:1 licence:2",
      "role": "bootstrap",
      "description": "Licence driller #1 for tier-2 rigs (the player-facing path is a driving school).",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:driving.drill_rig level:1 licence:2"
        }
      ],
      "expect": {
        "changedBy": {
          "cash": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:2 spacing:4 depth:8 diameter:127 start:36,30 confirm:true",
      "role": "player",
      "description": "Order two 127 mm holes, 8 m deep: the stepper now steps up to 127 mm. Replaces the drilled 89 mm hole (confirmed).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 8
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"diameter\"]",
          "value": 127
        },
        {
          "type": "dragTiles",
          "x1": 36,
          "z1": 30,
          "x2": 41,
          "z2": 30
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickIfPresent",
          "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]",
          "timeoutMs": 2000
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 2
        }
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:2500",
      "role": "setup",
      "description": "The tier-2 rig lands both 127 mm holes.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 2500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:16 stemming:2",
      "role": "player",
      "description": "16 kg per hole: refused at 89 mm, fits a 127 mm hole 8 m deep (about 4.07 kg/m, boomite limit scaled to about 16.3 kg).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 16
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "The blaster loads both 16 kg charges.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "blast detonate",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "description": "Blast 1: arm the sequence; the crew evacuates the pattern before it fires, so nobody is lost.",
      "timeout": 90,
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "The sequence fires; the 127 mm holes are consumed.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    }
  ]
}
