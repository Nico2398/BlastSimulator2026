{
  "name": "nav-move-costs-visual",
  "description": "Tests move cost visualization showing different cell types with varying costs",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:3 spacing:4 depth:6 start:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 5,
          "z1": 5,
          "x2": 13,
          "z2": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 3
        }
      }
    },
    {
      "command": "build management_office at:2,2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 2
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 42000,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler",
      "description": "Buy a vehicle and send it moving across cells of different NavGrid cost (walkable, drill_hole) so per-tick progress is visible.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 17000,
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle move 1 to:5,9",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle move 1 to:5,9"
        }
      ],
      "description": "Left unmarked: no UI control drives this exact command and none should exist -- FleetPanel.ts only wires vehicle buy/driver/scrap to the console (grep confirms no `vehicle move`/`vehicle assign` call site anywhere in src/ui) -- vehicles move autonomously via task/haul assignment, never by a player teleporting one to a raw x,z.",
      "expect": {
        "equals": {
          "cash": 17000
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "note": "vehicle list confirms real per-tick progress toward (5,9), crossing the drill_hole row's different NavGrid cost"
      }
    },
    {
      "command": "state full",
      "description": "Final state dump — vehicle x/z should have advanced toward (5,9) across the drill_hole row.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
