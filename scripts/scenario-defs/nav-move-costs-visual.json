{
  "name": "nav-move-costs-visual",
  "description": "Tests move cost visualization showing different cell types with varying costs",
  "steps": [
    {
      "command": "new_game seed:42 cash:80000 staffed:true",
      "description": "Staffed opening (#551): a driller with blasting + drill_rig licence, plus an unmanned drill_rig, are hired/purchased for free at game-open — #553's automatic drill dispatch needs both to ever land an ordered hole. Cash bumped from the default $50,000 to $80,000 so the debris_hauler purchase below ($25,000) stays affordable after the wait and the office (no income anywhere in this file).",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:80000 staffed:true"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 80000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:3 spacing:4 depth:6 start:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 5,
          "z1": 5,
          "x2": 13,
          "z2": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 3,
          "holeCount": 0
        }
      }
    },
    {
      "command": "tick 90",
      "description": "#553: drain the ordered plan so the NavGrid actually has 'drill_hole' cost cells to visualize (NavGrid.ts only marks that cell type from a real, drilled state.drillHoles entry) — sandbox-measured landing at tick 12 for H1, well inside this pad for all 3.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 90"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 3
        }
      }
    },
    {
      "command": "build management_office at:2,2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 2
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 46092,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler",
      "description": "Buy a vehicle and send it moving across cells of different NavGrid cost (walkable, drill_hole) so per-tick progress is visible. #553: staffed:true's fleet (drill_rig/debris_hauler/rock_digger/rock_fragmenter, ids 1-4) means this purchase is the fleet's 5th vehicle, not its 1st.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 21092,
          "vehicleCount": 5
        }
      }
    },
    {
      "command": "vehicle move 5 to:5,9",
      "interaction": [
        {
          "type": "clickEntity",
          "kind": "vehicle",
          "id": 5
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        },
        {
          "type": "cameraFocus",
          "x": 5.5,
          "z": 9.5,
          "distance": 25
        },
        {
          "type": "mousemove",
          "x": 640,
          "y": 360
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "clickSelector",
          "selector": "#bs-selection-bar [data-action=\"move_here\"]"
        }
      ],
      "description": "Real click path: select hauler #5 in the 3D scene (#553: the just-bought debris_hauler is the fleet's 5th vehicle under staffed:true, not its 1st), rest the cursor on (5,9), then press the selection bar's MOVE HERE. The old description here claimed no UI drives this command and none should exist -- false since the SelectionBar gained `move_here` (G4), usable with a mouse since ScenePicking started latching `.aim` (47f4fef). The focus point is the tile centre here, which is where the camera ray lands on this flat stretch; it was measured in a real browser (dispatched command read `vehicle move 5 to:5,9`), not assumed -- other tiles need an offset, so re-measure rather than copy.",
      "role": "player",
      "expect": {
        "equals": {
          "cash": 21092
        }
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": ["cash"],
        "note": "vehicle list confirms real per-tick progress toward (5,9), crossing the drill_hole row's different NavGrid cost"
      }
    },
    {
      "command": "state full",
      "description": "Final state dump — vehicle x/z should have advanced toward (5,9) across the drill_hole row.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
