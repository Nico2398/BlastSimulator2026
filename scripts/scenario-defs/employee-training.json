{
  "name": "employee-training",
  "description": "Chapter 3: hire an employee, obtain a licence no role starts with (driving.excavator) and promote an already-held one (blasting) via real click-driven training -- the two proofs playtests/training.json's beats require -- then complete a blast task",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000
        }
      }
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1,
          "qualificationCount": 1,
          "proficiencyTotal": 1
        }
      }
    },
    {
      "command": "build driving_center at:5,5",
      "description": "Real UI training gap (parity with playtests/training.json, #479): driving.excavator belongs to no hiring role (ROLE_STARTING_QUALIFICATION), so a driving_center -- the only school that teaches it -- is the sole in-game path to ever holding it. Placed away from the drill grid below (15,15)-(20,20).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"driving_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 1
        }
      }
    },
    {
      "command": "employee train 1 skill:driving.excavator",
      "description": "Real click path: open the employee detail panel, confirm the excavator course is genuinely offered and clickable (#479's own concern -- \"if this control is missing or disabled with a school standing, the licence belongs to nobody\"), then enrol.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel .bs-detail-toggle"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel .bs-train-btn[data-skill=\"driving.excavator\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel .bs-train-btn[data-skill=\"driving.excavator\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "trainingCount": 1
        }
      }
    },
    {
      "command": "tick 20",
      "description": "TRAINING_BASE_TICKS(20) * TRAINING_LEVEL_COST_MULTIPLIER[1](1) * TRAINING_TIER_SPEED[1](1) -- the exact course length for a Tier-1 driving_center's first level.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 20"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "trainingCount": 0,
          "qualificationCount": 2
        },
        "note": "the excavator licence is genuinely obtained -- no role starts with it, so this is the only way anyone on the roster ever holds it"
      }
    },
    {
      "command": "employee assign_skill 1 skill:geology level:2",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 1 skill:geology level:2"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`.",
      "expect": {
        "equals": {
          "cash": 33240,
          "qualificationCount": 3,
          "proficiencyTotal": 4
        }
      },
      "role": "bootstrap"
    },
    {
      "command": "build blasting_academy at:7,5",
      "description": "The second half of #479's parity gap: prove a promotion (raising an already-held qualification above Rookie) is obtainable via real clicks too, not just a brand-new licence. Placed beside the driving_center, away from the drill grid.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"blasting_academy\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 7,
          "z": 5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "buildingCount": 2
        }
      }
    },
    {
      "command": "employee train 1 skill:blasting",
      "description": "Chuck Miner already holds blasting at Rookie (a driller's own ROLE_STARTING_QUALIFICATION) -- this course promotes it, the same control used for a brand-new licence above.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel .bs-train-btn[data-skill=\"blasting\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel .bs-train-btn[data-skill=\"blasting\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "trainingCount": 1
        }
      }
    },
    {
      "command": "tick 32",
      "description": "TRAINING_BASE_TICKS(20) * TRAINING_LEVEL_COST_MULTIPLIER[2](1.6) * TRAINING_TIER_SPEED[1](1) = 32 -- the exact course length to promote level 1 to 2.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 32"
        }
      ],
      "role": "setup",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "trainingCount": 0,
          "qualificationCount": 3,
          "proficiencyTotal": 5
        },
        "note": "a promotion raises the level of a held qualification rather than adding a second copy of it -- qualificationCount unchanged, proficiencyTotal +1"
      }
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:3 depth:6 start:15,15",
      "description": "Corrected from the original rows:2 cols:2 spacing:5 (which command mode ran literally, producing 4 holes): the click drags the (15,15)-(20,20) rectangle at the Drill panel's own default spacing (DEFAULT_SPACING_M=3), computing cols/rows as round(size/spacing)+1 = 3x3 = 9 holes for that same rectangle -- the command and the click were silently testing two different grids, the same class of bug already fixed in nav-cell-types-visual.json. Caught by adding expect.equals.holeCount; fixed by describing what the click actually produces. depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 9
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 9
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      }
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "qualificationCount": 3,
          "proficiencyTotal": 5
        }
      }
    }
  ]
}
