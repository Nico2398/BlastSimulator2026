{
  "name": "employee-training",
  "description": "Chapter 3: Hire generalist employee, train drilling and geology skills, then complete a blast task",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup"
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup"
    },
    {
      "command": "time resume",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ],
      "role": "setup"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "employee assign_skill id:1 skill:driving.excavator level:3",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill id:1 skill:driving.excavator level:3"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`."
    },
    {
      "command": "employee assign_skill id:1 skill:geology level:2",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill id:1 skill:geology level:2"
        }
      ],
      "description": "Left unmarked: hiring already grants the Rookie starting qualification (ROLE_STARTING_QUALIFICATION in Employee.ts); this only raises the level for the scenario's needs -- the player-facing path is `employee train`."
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:5 depth:8 start:15,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "fragments",
      "interaction": [
