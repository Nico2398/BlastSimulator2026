    {
      "command": "wait_until field:orderedRampSegmentCount equals:0 max_ticks:800",
      "timeout": 250,
      "description": "Drain every queued dig_ramp_segment layer: the ramp is carved end to end and now connects the pocket.",
      "interaction": [
