      "description": "Order the ramp into the stranded pocket (10 m from (27,9) down to the crater at (17,9), depth 5) before anyone can dig. Accepted and charged; every layer ghost is RED because the roster holds no excavator driver and the fleet no rock_digger. Ghosts are never blocked at order time, only coloured.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 5
        },
        {
          "type": "focusTile",
          "x": 22,
          "z": 9,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 27,
          "z1": 9,
          "x2": 17,
          "z2": 9
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "unreachableGhostCount"
        ]
      }
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
