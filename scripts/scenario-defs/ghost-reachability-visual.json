        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        }
      ],
      "description": "Buy the rock digger. The excavator-licensed driver and a rock_digger now both exist, so the ramp's layers turn BLUE with no tick (the purchase happens while paused).",
      "role": "player",
