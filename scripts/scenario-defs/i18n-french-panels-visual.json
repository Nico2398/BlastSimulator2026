      "command": "wait_until field:levelEndReason equals:fired max_ticks:200",
      "timeout": 60,
      "role": "setup",
      "description": "",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "levelEndReason",
          "equals": "fired",
          "maxTicks": 200,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "observe",
      "description": "Level-end in French",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-level-end-screen",
