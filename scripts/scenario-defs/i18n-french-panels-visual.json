{
  "name": "i18n-french-panels-visual",
  "description": "#2236: Crew, Fleet, Contracts, Build, Operations, Blast panels and the level-end screen in French, screenshotted to check for truncation/overflow.",
  "steps": [
    {
      "command": "new_game seed:42 size:32 staffed:true cash:200000",
      "timeout": 60,
      "role": "setup",
      "description": "Staffed game",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:32 staffed:true cash:200000"
        }
      ]
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "observe",
      "description": "Switch to French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"settings\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-settings-panel"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-settings-panel [data-lang=\"fr\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ]
    },
    {
      "command": "state",
      "timeout": 60,
      "role": "observe",
      "description": "employees panel in French",
      "interaction": [
        {
