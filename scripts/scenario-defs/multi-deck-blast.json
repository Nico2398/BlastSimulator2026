      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:6 depth:6 start:20,20",
      "description": "The grid tool's spacing stepper defaults to 3m (DEFAULT_SPACING_M, Drill.ts); three increment clicks on the strip's spacing stepper (data-field=\"spacing\") raise it 3->6m before dragging, so the (20,20)-(26,26) rectangle (6x6) computes the declared 2x2 instead of the default-spacing 3x3 (issue #479 follow-up, Finding #4). depth:6 matches the grid tool's own default (DEFAULT_DEPTH_M, Drill.ts) -- this step's interaction array never clicks the depth stepper (data-field=\"depth\"), so the real drag always produces 6m regardless of what's declared (Ground rule #15/Finding #42's class); the file originally declared depth:20 for 'deep fracture' flavor, but a real interaction-mode run at the true 6m depth still produces the exact same PERFECT/0-projections outcome this file's premise describes, confirmed empirically rather than assumed -- so the fix here is only correcting the declared metadata to match reality, no downstream behavior changes.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 26,
          "z2": 26
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 4
        },
        "note": "2 rows x 2 cols = 4"
