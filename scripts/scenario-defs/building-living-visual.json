{
  "name": "building-living-visual",
  "description": "Visual check of living quarters tiers and employee needs display with hunger and fatigue gauges",
  "steps": [
    {
      "command": "new_game seed:42 cash:210000",
      "description": "40s is not enough headroom for a level load plus this file's 4 multi-angle `shots` on a GPU-less renderer (~6-10s/frame, #475) \u2014 pre-existing on main, not introduced by #1010, but it was blocking this scenario's own interaction-mode run so fixed here rather than filed separately.",
      "timeout": 90,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:210000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 210000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "set_policy mode:continuous fatigue:0",
      "description": "#1379: the default site policy (shift_8h, rest at fatigue <= 60) is always in force, so a staffed crew would be force-rested mid-task. This scenario is not about shift or rest policy; continuous mode with a zero threshold never forces a rest, keeping the timing this file was authored against.",
      "interaction": [
        {
          "type": "command",
          "command": "set_policy mode:continuous fatigue:0"
        }
      ],
      "role": "bootstrap"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 1
        }
      },
      "description": "Hired ahead of the orders below rather than after them (#556): a build order is queued work now, so the sites need someone on the roster to walk over and build them. Keeping this file\u2019s own hires as the builders \u2014 rather than reaching for staffed:true \u2014 is what leaves the roster and proficiency counts it asserts where they were."
    },
    {
      "command": "employee hire role:blaster",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 2
        }
      },
      "description": "Hired ahead of the orders below rather than after them (#556): a build order is queued work now, so the sites need someone on the roster to walk over and build them. Keeping this file\u2019s own hires as the builders \u2014 rather than reaching for staffed:true \u2014 is what leaves the roster and proficiency counts it asserts where they were."
    },
    {
      "command": "employee hire role:driver",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driver\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 3
        }
      },
      "description": "Hired ahead of the orders below rather than after them (#556): a build order is queued work now, so the sites need someone on the roster to walk over and build them. Keeping this file\u2019s own hires as the builders \u2014 rather than reaching for staffed:true \u2014 is what leaves the roster and proficiency counts it asserts where they were."
    },
    {
      "command": "build living_quarters at:2,6 tier:1",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 6
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedBuildingCount": 1,
          "buildingCount": 0
        },
        "changedBy": {
          "cash": -10000
        }
      }
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:400",
      "description": "Let the queued construction site(s) be walked to and built out (#556): ordering a building no longer places it, so everything below that needs a standing building waits here first. #1010: the trailing focusTile+screenshot below frames the just-completed tier-1 living quarters at the camera distance the game actually plays at, for visual inspection of the model. Added as a step-scoped action here rather than as a global `shots` entry, since every `shots` entry re-captures on every step in the file (including step 0, before any building exists) and this file's per-step timeouts already run close to the per-frame cost of a GPU-less renderer (#475) \u2014 a 5th global shot would only add cost with nothing to show this early.",
      "timeout": 130,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 400,
          "timeoutMs": 120000
        },
        {
          "type": "focusTile",
          "x": 5,
          "z": 5,
          "distance": 16
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build living_quarters at:13,0 tier:2",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-tier-sel",
          "value": "2"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 13,
          "z": 0
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedBuildingCount": 1,
          "buildingCount": 1
        },
        "note": "cash uses decreased, not equals, because the exact balance depends on wages paid while the crew built the earlier sites"
      }
    },
    {
      "command": "wait_until field:buildingCount equals:2 max_ticks:400",
      "description": "Let the queued construction site(s) be walked to and built out (#556): ordering a building no longer places it, so everything below that needs a standing building waits here first.",
      "timeout": 130,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 2,
          "maxTicks": 400,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 2,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build living_quarters at:16,17 tier:3",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "set",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-tier-sel",
          "value": "3"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"living_quarters\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "focusTile",
          "x": 16,
          "z": 17
        },
        {
          "type": "pickTile",
          "x": 16,
          "z": 17
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "orderedBuildingCount": 1,
          "buildingCount": 2
        }
      }
    },
    {
      "command": "wait_until field:buildingCount equals:3 max_ticks:400",
      "description": "Let the queued construction site(s) be walked to and built out (#556): ordering a building no longer places it, so everything below that needs a standing building waits here first.",
      "timeout": 130,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 3,
          "maxTicks": 400,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 3,
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "needs",
      "interaction": [
        {
          "type": "command",
          "command": "needs"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 20",
      "description": "#1384: fixed-duration actions (build) now scale by proficiency/fatigue/Living Quarters, so builds finish at different ticks and the fatigue trajectory shifted. At this step minFatigue starts at 23.9 (Stan, drained) and a rest/collapse-recovery in flight completes inside the 20-tick window, so minFatigue nets UPWARD (23.9 -> 74.5, re-derived live) rather than the earlier downward net. Direction is the claim: someone recovering in a living_quarters raises the minimum.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 20"
        }
      ],
      "role": "setup",
      "expect": {
        "note": "#1384: minFatigue rises (23.9 -> 74.5) because the lowest-fatigue employee is mid-rest in a living_quarters during this window.",
        "increased": [
          "minFatigue"
        ]
      }
    },
    {
      "command": "needs",
      "interaction": [
        {
          "type": "command",
          "command": "needs"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "tier-comparison",
      "yaw": 90,
      "pitch": 15
    },
    {
      "name": "needs-display",
      "yaw": 45,
      "pitch": 30
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
