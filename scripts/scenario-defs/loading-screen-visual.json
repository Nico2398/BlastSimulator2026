{
  "name": "loading-screen-visual",
  "description": "Visual verification of the level loading screen: clicking a world-map level start puts the overlay on screen with its caption and progress bar BEFORE the several seconds of synchronous terrain generation and meshing begin, and the overlay is gone once the site is playable. The point of the screen is that it paints during the block rather than after it, so the wait reads as a load and not as a hang.",
  "steps": [
    {
      "command": "help",
      "description": "Initial load — the main menu is the only thing on screen and no loading overlay is showing.",
      "interaction": [
        {
          "type": "command",
          "command": "help"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-main-menu"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": false
        }
      ],
      "role": "observe"
    },
    {
      "command": "state",
      "description": "Click New Campaign to reach the world map, where Dusty Hollow offers a Start Level button.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-main-menu #bs-menu-new-campaign"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-main-menu"
        }
      ],
      "role": "observe"
    },
    {
      "command": "new_game seed:1138 size:24",
      "description": "A base game must exist before a campaign level can start. In the browser the world-map Start button does this itself as the load's first phase; command mode needs it spelled out.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:1138 size:24"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "buildingCount": 0,
          "worldSizeX": 24
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow",
      "description": "Start the level through the console so the scenario's command mode exercises the same load, then confirm the site is playable and the overlay has been dismissed.",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        },
        {
          "type": "wait",
          "durationMs": 500
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": false
        }
      ],
      "role": "setup",
      "expect": {
        "increased": ["worldSizeX"],
        "equals": {
          "cash": 50000
        },
        "note": "24 (the seed-1138 base game) replaced by dusty_hollow's own 96x96 terrain (Level.ts gridX/gridZ)"
      }
    },
    {
      "command": "terrain_info",
      "description": "The loaded site reports the level's own grid, proving the load completed rather than merely hiding the overlay.",
      "interaction": [
        {
          "type": "command",
          "command": "terrain_info"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "worldSizeX": 96,
          "worldSizeZ": 96
        },
        "note": "exact match to dusty_hollow's gridX/gridZ (Level.ts) — proves the level's own terrain generated at the right size, not merely that some terrain exists"
      }
    },
    {
      "command": "state",
      "description": "Debug-preview a level load (bypassing terrain generation) to verify the eyebrow, subtitle, briefing, and tip blocks are all on screen (#493). Command mode has no equivalent for a debug-only bridge, so it falls back to a plain state dump.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "loadingScreenDebug",
          "action": "preview",
          "kind": "level"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": true
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-eyebrow"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-subtitle"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-briefing"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-stage-label"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-tip-text"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state",
      "description": "Click NEXT on the tip block mid-preview and confirm the overlay is still showing — proves the tip cycling control does not tear down the debug preview.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-loading-tip-next"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": true
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state",
      "description": "Debug-preview a sandbox load — the eyebrow should read the sandbox wording rather than a numbered site.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "loadingScreenDebug",
          "action": "preview",
          "kind": "sandbox"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": true
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-eyebrow"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state",
      "description": "Debug-preview a level load under the FR locale — every block (eyebrow, subtitle, briefing, stage row, TIP/NEXT) must retranslate with no clipped or overflowing text (#493).",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "loadingScreenDebug",
          "action": "preview",
          "kind": "level",
          "locale": "fr"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": true
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-eyebrow"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-loading-tip-text"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state",
      "description": "Dismiss the debug preview — the overlay must come back down without a real level ever loading.",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        },
        {
          "type": "loadingScreenDebug",
          "action": "hide"
        },
        {
          "type": "assert",
          "selector": "#bs-loading-screen",
          "property": "visible",
          "expectedValue": false
        }
      ],
      "role": "observe"
    }
  ]
}
