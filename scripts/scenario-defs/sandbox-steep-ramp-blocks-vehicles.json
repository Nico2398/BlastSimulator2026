{
  "name": "sandbox-steep-ramp-blocks-vehicles",
  "description": "One 20 degree slope limit for every vehicle on a progression site (#2045). The ramp tool will not cut a ramp vehicles cannot drive: a 10 m ramp for a 5 m depth (26.6 degrees, which a vehicle could once climb by zigzagging) is refused, Confirm is disabled and nothing is ordered. An 8 m ramp for a 2 m depth (14.0 degrees) is accepted and dug; the first blast leaves rubble in the crater it serves, and the haulers carry it out up that ramp, so the hole planned under the rubble is drilled once it is cleared. The player then clicks the ramp: the inspector opens on it and offers Widen.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site (kit:full): tier-1 drill rig only, so only 89 mm holes can be drilled at first.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "build explosive_warehouse at:8,8",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front so charging needs no delivery wait.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "The explosive warehouse is built.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "buy explosive:boomite kg:100",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        }
      ],
      "description": "Buy enough krackle for both blasts into the warehouse stock.",
      "expect": {
        "decreased": [
          "cash"
        ]
      },
      "role": "player"
    },
    {
      "command": "drill_plan add x:36 z:31 depth:2 diameter:89",
      "role": "player",
      "description": "Order one 89 mm, 2 m hole on the virgin bench; it will be blasted away.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "build_ramp start:22,31 end:32,31 depth:5",
      "commandOutcome": "refused",
      "role": "guard",
      "timeout": 60,
      "description": "Player arms the ramp tool and draws a 10 m ramp for a 5 m depth: 26.6 degrees, steeper than the 20 degree limit every vehicle shares (a vehicle used to climb it by zigzagging diagonally across the 3-wide ramp). The strip refuses, Confirm is disabled and no ramp segment is ordered.",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 5
        },
        {
          "type": "focusTile",
          "x": 27,
          "z": 31,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 22,
          "z1": 31,
          "x2": 32,
          "z2": 31
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "blocked": "#bs-tile-select-confirm",
        "equals": {
          "orderedRampSegmentCount": 0,
          "builtRampCount": 0
        }
      }
    },
    {
      "command": "build_ramp start:27,31 end:35,31 depth:2",
      "role": "player",
      "description": "Dig the ramp the tool accepts: 8 m long for a 2 m depth is 14.0 degrees, under the 20 degree limit every vehicle shares, so the haulers can drive out of the crater it serves.",
      "interaction": [
        {
          "type": "keypress",
          "key": "Escape"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 32,
          "z": 31,
          "distance": 30,
          "pitch": 75
        },
        {
          "type": "dragTiles",
          "x1": 27,
          "z1": 31,
          "x2": 35,
          "z2": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "increased": [
          "orderedRampSegmentCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:1500",
      "role": "setup",
      "description": "The 89 mm hole is drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 1500,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "wait_until field:builtRampCount equals:1 max_ticks:800",
      "role": "setup",
      "description": "The ramp is dug.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "builtRampCount",
          "equals": 1,
          "maxTicks": 800,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "builtRampCount": 1,
          "orderedRampSegmentCount": 0
        }
      }
    },
    {
      "command": "tick 30",
      "role": "setup",
      "description": "The ramp crew clears off the bench before the charge goes in.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 30"
        }
      ]
    },
    {
      "command": "charge hole:* explosive:boomite amount:2 stemming:1",
      "role": "player",
      "description": "Load 2 kg into the hole.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 1
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3400",
      "role": "setup",
      "description": "The charge is loaded.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "blast detonate",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "description": "The hole is consumed and rubble lies where it stood.",
      "timeout": 90,
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "Blast the first bench; the broken rock lies on the new crater floor as on-ground rubble.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 0,
          "maxTicks": 600,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan add x:36 z:31 depth:2 diameter:89",
      "role": "player",
      "description": "Second bench: plan a hole on the crater floor, under the fresh rubble. The order is accepted (planning is never refused).",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 2
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "tick 40",
      "role": "setup",
      "description": "40 ticks is longer than an unobstructed rig needs to drill a 2 m hole, yet too short to haul the rubble off: a hole under rubble cannot be claimed (#1937), so the order stays queued (buried_under_rubble) and undrilled while the rubble lies there.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 40"
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 1,
          "holeCount": 0
        }
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "role": "setup",
      "description": "Haulers clear the buried-hole rubble first (#1937 haul priority); once uncovered the hole is drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 600000
        }
      ],
      "timeout": 630,
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 1
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 90,
      "description": "Player clicks the ramp in the scene: the inspector opens on it and offers Widen. Its detail line carries the ramp grade and one line saying vehicles can climb it (max 20 degrees), no vehicle tiers (text asserted in describeRamp.test.ts).",
      "interaction": [
        {
          "type": "focusTile",
          "x": 32,
          "z": 31,
          "distance": 16,
          "pitch": 80
        },
        {
          "type": "click",
          "x": 640,
          "y": 360
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-inspector [data-action=\"widen\"]",
          "timeout": 60000
        }
      ],
      "expect": {
        "usable": "#bs-inspector [data-action=\"widen\"]"
      }
    },
    {
      "command": "state full",
      "role": "observe",
      "description": "Final state dump.",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ]
    }
  ]
}
