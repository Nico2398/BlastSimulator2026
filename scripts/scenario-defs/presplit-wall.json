{
  "name": "presplit-wall",
  "description": "Chapter 5: Presplit row plus production drill holes for zero back-break wall control",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:5 depth:12 start:20,20",
      "description": "Production grid drilled first (Finding #8: drill_plan grid replaces the whole plan and resets hole ids to H1 — see finding log — so the production grid must land before anything else, not after). The spacing stepper defaults to 3m (DEFAULT_SPACING_M) and depth to 6m (DEFAULT_DEPTH_M, Drill.ts); two increment clicks on spacing (3->5) and six on depth (6->12) before dragging the (20,20)-(30,30) rectangle (10x10) so it computes the declared 3x3 instead of the default-spacing 3x3-at-wrong-depth (issue #479 follow-up, Finding #4).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 30,
          "z2": 30
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 9
        },
        "note": "3 rows x 3 cols = 9 — the presplit row is added next, appended without wiping this grid (drill_plan add, unlike drill_plan grid)"
      }
    },
    {
      "command": "drill_plan add x:10 z:20 depth:10",
      "description": "First presplit-row hole: the add-hole tool (data-action=\"add-hole-tool\", Drill.ts) — a real UI control distinct from the rect grid tool, point-shaped placement. Its depth stepper shares Drill.ts's single gridDepth field with the grid tool above, still sitting at 12m from the production grid; two decrement clicks bring it to the presplit row's declared 10m before placing this and every hole after it (the field persists across arm/disarm, Finding #4's class again).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"depth\"] .bsx-stepper-btn:first-child"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 10
        }
      }
    },
    {
      "command": "drill_plan add x:13 z:20 depth:10",
      "description": "Second presplit-row hole.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 13,
          "z": 20
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 11
        }
      }
    },
    {
      "command": "drill_plan add x:16 z:20 depth:10",
      "description": "Third presplit-row hole.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 16,
          "z": 20
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 12
        }
      }
    },
    {
      "command": "drill_plan add x:19 z:20 depth:10",
      "description": "Fourth presplit-row hole.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 19,
          "z": 20
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 13
        }
      }
    },
    {
      "command": "drill_plan add x:22 z:20 depth:10",
      "description": "Fifth and last presplit-row hole — the full presplit line now runs (10,20)-(22,20), parallel to and clear of the production grid at (20,20)-(30,30).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 22,
          "z": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "wait",
          "durationMs": 300
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 14
        },
        "note": "9 production + 5 presplit = 14"
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 14
        },
        "note": "Charge All reaches every hole that exists by this point — all 14, production and presplit alike, with boomite. The presplit row's real explosive is applied next, one hole at a time, overwriting these 5 with pop_rock — chargedCount stays 14 throughout, only the per-hole explosiveId changes"
      }
    },
    {
      "command": "charge hole:H10 explosive:pop_rock amount:2 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H10 explosive:pop_rock amount:2 stemming:3"
        }
      ],
      "description": "charge hole:H10 explosive:pop_rock amount:2 stemming:3 — no per-hole charging in the UI by design (Charge.ts's own header: \"per-hole charging isn't a feature here anyway\"); only Charge All exists. Left as a command (Finding #10). Finding #7 class: the file previously charged bare-numeric hole:1..hole:5 with a fictional explosive:presplit id that doesn't exist in ExplosiveCatalog.ts (8 real products, none named presplit) — every charge silently failed on BOTH counts (bad hole id, then would have failed again on the unknown explosive even with a correct id) and chargedCount for these holes stayed 0 through this file's entire history. Fixed by using the real hole id (H10, drill_plan add's own numbering, continuing from the production grid's H1-H9) and pop_rock — the catalog's lowest-energy, lowest-projection-risk, lowest-vibration product (energyPerKg 200 vs boomite's 340, projectionRiskMod 0.5 vs 0.8), the real product that actually matches a presplit line's job: a small controlled charge, not a production blast."
    },
    {
      "command": "charge hole:H11 explosive:pop_rock amount:2 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H11 explosive:pop_rock amount:2 stemming:3"
        }
      ],
      "description": "charge hole:H11 explosive:pop_rock amount:2 stemming:3 — no per-hole charging in the UI by design (Charge.ts's own header: \"per-hole charging isn't a feature here anyway\"); only Charge All exists. Left as a command (Finding #10)."
    },
    {
      "command": "charge hole:H12 explosive:pop_rock amount:2 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H12 explosive:pop_rock amount:2 stemming:3"
        }
      ],
      "description": "charge hole:H12 explosive:pop_rock amount:2 stemming:3 — no per-hole charging in the UI by design (Charge.ts's own header: \"per-hole charging isn't a feature here anyway\"); only Charge All exists. Left as a command (Finding #10)."
    },
    {
      "command": "charge hole:H13 explosive:pop_rock amount:2 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H13 explosive:pop_rock amount:2 stemming:3"
        }
      ],
      "description": "charge hole:H13 explosive:pop_rock amount:2 stemming:3 — no per-hole charging in the UI by design (Charge.ts's own header: \"per-hole charging isn't a feature here anyway\"); only Charge All exists. Left as a command (Finding #10)."
    },
    {
      "command": "charge hole:H14 explosive:pop_rock amount:2 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H14 explosive:pop_rock amount:2 stemming:3"
        }
      ],
      "description": "charge hole:H14 explosive:pop_rock amount:2 stemming:3 — no per-hole charging in the UI by design (Charge.ts's own header: \"per-hole charging isn't a feature here anyway\"); only Charge All exists. Left as a command (Finding #10).",
      "expect": {
        "equals": {
          "chargedCount": 14
        },
        "note": "all 5 presplit holes now carry pop_rock alongside the 9 production holes' boomite"
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 14
        }
      }
    },
    {
      "command": "blast",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"5\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        },
        "note": "a fired blast clears the plan back to zero — all 14 holes (both explosives) detonate together in one plan, proving the presplit row and production grid actually coexist now (Finding #8), unlike every previous run of this file"
      }
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ]
}
