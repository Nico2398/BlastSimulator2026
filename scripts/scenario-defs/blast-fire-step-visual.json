{
  "name": "blast-fire-step-visual",
  "description": "Redesign P4/#26: the Blast Workshop's Fire step (danger zone, Sound the Horn, pre-flight checklist) and the real fire flow — FIRE opens PreflightModal, DETONATE fires and closes it, BlastReportModal auto-opens with the real report, CLOSE dismisses it.",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45,
      "target": [
        10,
        10
      ],
      "distance": 15
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 size:32",
      "timeout": 30,
      "description": "Setup: a fresh site",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:32"
        }
      ],
      "role": "setup"
    },
    {
      "command": "drill_plan grid origin:10,10 rows:1 cols:1 spacing:3 depth:6",
      "timeout": 30,
      "description": "Setup: a single hole, charged and sequenced — a complete, valid plan — bundled fixture setup; `sequence set` on the one hole isn't reachable as a precise click (Finding #9).",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan grid origin:10,10 rows:1 cols:1 spacing:3 depth:6"
        },
        {
          "type": "command",
          "command": "charge hole:* explosive:boomite amount:5kg stemming:2m"
        },
        {
          "type": "command",
          "command": "sequence set hole:H1 delay:0ms"
        }
      ]
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Opening the Blast Workshop auto-lands on step 5 (Fire) since the plan is complete — the danger zone shows clear (nobody nearby), Sound the Horn is disabled, and the pre-flight checklist reads all-clear",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-action=\"sound-horn\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player"
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "FIRE opens PreflightModal — real plan stats, the 'run analysis' hint (no preview has run), and the all-clear warnings",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player"
    },
    {
      "command": "blast",
      "timeout": 30,
      "description": "DETONATE fires the blast, closes PreflightModal, and BlastReportModal auto-opens with the real report (rating, cleared/cracked/fragments, ore value)",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "wait",
          "durationMs": 400
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player"
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "CLOSE dismisses the report",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player"
    }
  ]
}
