{
  "name": "building-training-visual",
  "description": "Visual check of training buildings: driving center, blasting academy, management office, and geology lab",
  "steps": [
    {
      "command": "new_game seed:42 cash:60000",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:60000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 60000,
          "buildingCount": 0
        }
      }
    },
    {
      "command": "build driving_center at:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"driving_center\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 5,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 48000,
          "buildingCount": 1
        }
      }
    },
    {
      "command": "build blasting_academy at:10,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"blasting_academy\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 10,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 33000,
          "buildingCount": 2
        }
      }
    },
    {
      "command": "build management_office at:15,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 15,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 25000,
          "buildingCount": 3
        }
      }
    },
    {
      "command": "build geology_lab at:20,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"geology_lab\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 20,
          "z": 5
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 13000,
          "buildingCount": 4
        }
      }
    },
    {
      "command": "build list",
      "interaction": [
        {
          "type": "command",
          "command": "build list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee hire role:driller",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 12000,
          "employeeCount": 1
        }
      }
    },
    {
      "command": "employee hire role:blaster",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"blaster\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 10500,
          "employeeCount": 2
        }
      }
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "employee train 1 skill:driving.excavator building:1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-employee-id=\"1\"] .bs-detail-toggle"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-employee-id=\"1\"] .bs-train-btn[data-skill=\"driving.excavator\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-employee-id=\"1\"] .bs-train-btn[data-skill=\"driving.excavator\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 8000,
          "trainingCount": 1
        }
      }
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "trainingCount": 1
        },
        "note": "training takes 20 ticks — still in progress at 10"
      }
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 25",
      "interaction": [
        {
          "type": "command",
          "command": "tick 25"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "trainingCount": 0,
          "proficiencyTotal": 3
        },
        "note": "35 ticks total now past the 20-tick training duration — driving.excavator gained (proficiencyTotal 2→3), training slot freed"
      }
    },
    {
      "command": "employee list",
      "interaction": [
        {
          "type": "command",
          "command": "employee list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "training-area",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "closeup",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
