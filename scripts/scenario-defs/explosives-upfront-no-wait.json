{
  "name": "explosives-upfront-no-wait",
  "description": "An order without warehouse stock charges cash immediately, then finishes loading within 150 ticks without a delivery wait.",
  "steps": [
    {
      "command": "new_game seed:42 staffed:true cash:150000",
      "description": "Staffed opening, no warehouse.",
      "timeout": 30,
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 staffed:true cash:150000"
        }
      ],
      "expect": {
        "equals": {
          "buildingCount": 0,
          "chargedCount": 0
        },
        "note": "No warehouse or prepaid explosives."
      }
    },
    {
      "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:8 diameter:0.089 start:15,15",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan grid rows:1 cols:1 spacing:3 depth:8 diameter:0.089 start:15,15"
        }
      ]
    },
    {
      "command": "wait_until field:holeCount equals:1 max_ticks:300",
      "timeout": 130,
      "role": "setup",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 1,
          "maxTicks": 300,
          "timeoutMs": 120000
        }
      ],
      "expect": {
        "equals": {
          "holeCount": 1
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "description": "Order a charge with no stock: paid from cash and available immediately.",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:* explosive:boomite amount:5 stemming:2"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "chargedCount": 0
        },
        "note": "Explosives are paid for at order time; loading remains real work."
      }
    },
    {
      "command": "wait_until field:chargedCount equals:1 max_ticks:150",
      "description": "The truck and blaster finish loading well before the former 400-tick delivery delay.",
      "role": "observe",
      "timeout": 130,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 1,
          "maxTicks": 150,
          "timeoutMs": 120000
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 1
        }
      }
    },
    {
      "command": "state",
      "description": "The Charge step shows the paid-from line with no delivery wait.",
      "role": "observe",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel [data-info=\"paid-from\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "expect": {
        "equals": {
          "chargedCount": 1
        },
        "note": "Loaded charge and order-time payment summary remain visible; no delivery countdown."
      }
    }
  ]
}
