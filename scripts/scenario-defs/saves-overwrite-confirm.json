{
  "name": "saves-overwrite-confirm",
  "description": "Issue #1325: a filled manual save slot offers OVERWRITE, and OVERWRITE and Delete both ask for confirmation through the shared confirm modal before touching the slot. Saves slot 1 with SAVE HERE, reopens the Saves modal, overwrites with a confirm, then deletes with a confirm and checks the card is empty again. Every step after the setup is a real click: only interaction mode proves the buttons exist and the confirm modal is reachable above the Saves modal.",
  "steps": [
    {
      "command": "new_game seed:42 cash:120000",
      "interaction": [
        { "type": "command", "command": "new_game seed:42 cash:120000" }
      ],
      "role": "setup",
      "expect": { "equals": { "holeCount": 0 } },
      "description": "Opening game to save."
    },
    {
      "command": "state",
      "description": "Open the Saves modal from the top bar. `state` is the inert paired command for this UI-only step.",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-saveload-btn" },
        { "type": "waitForSelector", "selector": "#bs-saves-modal" }
      ],
      "role": "player",
      "expect": { "changedBy": { "cash": 0 } }
    },
    {
      "command": "state",
      "description": "SAVE HERE on the empty slot 1 writes without any confirm; the modal closes itself once the save completes.",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"save-here\"]" },
        { "type": "awaitUsable", "selector": "#bs-saveload-btn" }
      ],
      "role": "player",
      "expect": {
        "changedBy": { "cash": 0 },
        "blocked": ".bs-confirm-overlay [data-action=\"confirm-yes\"]",
        "note": "an empty slot never asks to confirm"
      }
    },
    {
      "command": "state",
      "description": "Reopen the Saves modal; slot 1 is now filled, so it offers OVERWRITE. Clicking it raises the confirm modal instead of writing.",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-saveload-btn" },
        { "type": "waitForSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"overwrite\"]" },
        { "type": "clickSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"overwrite\"]" },
        { "type": "waitForSelector", "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]" }
      ],
      "role": "player",
      "expect": {
        "changedBy": { "cash": 0 },
        "usable": ".bs-confirm-overlay [data-action=\"confirm-yes\"]",
        "note": "the confirm modal is visible and reachable above the Saves modal"
      }
    },
    {
      "command": "state",
      "description": "Confirm the overwrite; the slot is rewritten and the Saves modal closes.",
      "interaction": [
        { "type": "clickSelector", "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]" },
        { "type": "awaitUsable", "selector": "#bs-saveload-btn" }
      ],
      "role": "player",
      "expect": {
        "changedBy": { "cash": 0 },
        "usable": "#bs-saveload-btn",
        "blocked": ".bs-confirm-overlay [data-action=\"confirm-yes\"]"
      }
    },
    {
      "command": "state",
      "description": "Reopen the Saves modal, click Delete on slot 1 and confirm. The card goes back to the empty SAVE HERE state.",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-saveload-btn" },
        { "type": "waitForSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"delete\"]" },
        { "type": "clickSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"delete\"]" },
        { "type": "waitForSelector", "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]" },
        { "type": "clickSelector", "selector": ".bs-confirm-overlay [data-action=\"confirm-yes\"]" },
        { "type": "waitForSelector", "selector": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"save-here\"]" }
      ],
      "role": "player",
      "expect": {
        "changedBy": { "cash": 0 },
        "usable": "#bs-saves-modal [data-slot=\"slot_1\"] [data-action=\"save-here\"]",
        "note": "slot 1 is empty again: SAVE HERE offered in place of OVERWRITE"
      }
    }
  ],
  "shots": [
    { "name": "overview", "yaw": 0, "pitch": 45 }
  ]
}
