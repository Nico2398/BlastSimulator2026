{
  "name": "blast-visual-full",
  "description": "Comprehensive visual pipeline test covering all 7 blast system areas: drill plan, charge/sequence, software preview tiers, detonation execution, post-blast report, and voxel fragmentation with multi-angle screenshots at every stage",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:4 spacing:5 depth:8 start:20,20",
      "description": "Two increment clicks on the spacing stepper (data-field=\"spacing\") raise it 3->5m (DEFAULT_SPACING_M, Drill.ts) before dragging, so the (20,20)-(35,30) rectangle computes the declared 4x3 instead of the default-spacing 6x4 (issue #479 follow-up, Finding #4).",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 35,
          "z2": 30
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 12
        },
        "note": "3 rows x 4 cols = 12"
      }
    },
    {
      "command": "drill_plan show",
      "interaction": [
        {
          "type": "command",
          "command": "drill_plan show"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 12
        }
      }
    },
    {
      "command": "charge hole:H1 explosive:boomite amount:8 stemming:3",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H1 explosive:boomite amount:8 stemming:3"
        }
      ],
      "description": "charge hole:H1 explosive:boomite amount:8 stemming:3 — no per-hole charging in the UI by design (Finding #10). Left as a command."
    },
    {
      "command": "charge hole:H2 explosive:boomite amount:3 stemming:1",
      "interaction": [
        {
          "type": "command",
          "command": "charge hole:H2 explosive:boomite amount:3 stemming:1"
        }
      ],
      "description": "charge hole:H2 explosive:boomite amount:3 stemming:1 — no per-hole charging in the UI by design (Finding #10). Left as a command."
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 12
        }
      }
    },
    {
      "command": "sequence set hole:H1 delay:0",
      "interaction": [
        {
          "type": "command",
          "command": "sequence set hole:H1 delay:0"
        }
      ],
      "description": "sequence set hole:H1 delay:0 — per-hole delay only reachable via relative +/- steppers, not a set-to-value click (Finding #9). Left as a command."
    },
    {
      "command": "sequence set hole:H6 delay:100",
      "interaction": [
        {
          "type": "command",
          "command": "sequence set hole:H6 delay:100"
        }
      ],
      "description": "sequence set hole:H6 delay:100 — per-hole delay only reachable via relative +/- steppers, not a set-to-value click (Finding #9). Left as a command."
    },
    {
      "command": "sequence show",
      "interaction": [
        {
          "type": "command",
          "command": "sequence show"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast_preview",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"run-analysis\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "buy_software tier:1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"1\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 49500
        }
      }
    },
    {
      "command": "preview energy",
      "interaction": [
        {
          "type": "command",
          "command": "preview energy"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"2\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 47500
        }
      }
    },
    {
      "command": "preview fragments",
      "interaction": [
        {
          "type": "command",
          "command": "preview fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:3",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"3\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 42500
        }
      }
    },
    {
      "command": "preview projections",
      "interaction": [
        {
          "type": "command",
          "command": "preview projections"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:4",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"4\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 30500
        }
      }
    },
    {
      "command": "preview vibrations",
      "interaction": [
        {
          "type": "command",
          "command": "preview vibrations"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast_preview",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"run-analysis\"]"
        }
      ],
      "role": "player"
    },
    {
      "command": "blast",
      "timeout": 20,
      "frames": 6,
      "interval": 50,
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"5\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        },
        "note": "a fired blast clears the plan back to zero"
      }
    },
    {
      "command": "fragments",
      "interaction": [
        {
          "type": "command",
          "command": "fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "inspect 20,20,0",
      "interaction": [
        {
          "type": "command",
          "command": "inspect 20,20,0"
        }
      ],
      "role": "observe"
    },
    {
      "command": "finances",
      "interaction": [
        {
          "type": "command",
          "command": "finances"
        }
      ],
      "role": "observe"
    },
    {
      "command": "scores",
      "interaction": [
        {
          "type": "command",
          "command": "scores"
        }
      ],
      "role": "observe"
    },
    {
      "command": "stats",
      "interaction": [
        {
          "type": "command",
          "command": "stats"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 45,
      "pitch": 30
    }
  ]
}
