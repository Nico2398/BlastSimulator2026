{
  "name": "level1-win-conservative",
  "description": "Level 1 (Dusty Hollow) won genuinely (#1363): one small 2x3 blast after clearing the blast zone, selling the rock afterwards, then waiting for operating profit to reach the target. No cash override, no staffed flag, no campaign complete.",
  "steps": [
    {
      "command": "campaign start level:dusty_hollow",
      "role": "setup",
      "timeout": 60,
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "description": "The level exactly as the UI starts it: no cash override, no staffed flag. It opens with a driller, a blaster, a driver, a drill rig, a debris hauler and a freight warehouse (#1363).",
      "expect": {
        "equals": {
          "cash": 50000,
          "tickCount": 0,
          "employeeCount": 3,
          "holeCount": 0
        }
      }
    },
    {
      "command": "time resume",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ]
    },
    {
      "command": "time speed 8",
      "role": "setup",
      "description": "Speed up the waits below.",
      "interaction": [
        {
          "type": "command",
          "command": "time speed 8"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:2 cols:3 spacing:3 depth:6 start:15,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 3
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 22,
          "z2": 19
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 6
        },
        "note": "6 holes ordered with the level's own crew and rig."
      },
      "description": "Order a drill grid with the crew and rig the level opens with: nothing was hired or bought."
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "description": "Cycle 1: the driller lands every ordered hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "role": "player",
      "interaction": [
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "description": "Cycle 1: the blaster loads every charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "zone clear x1:-1 y1:-1 x2:40 y2:40",
      "role": "player",
      "timeout": 90,
      "description": "Sound the Horn: everyone walks out of the blast radius before the shot, or the crew dies in it.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"sound-horn\"]"
        }
      ]
    },
    {
      "command": "wait_until field:dangerZoneClear equals:true max_ticks:300",
      "role": "setup",
      "description": "Wait for the walkout to finish.",
      "timeout": 330,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "dangerZoneClear",
          "equals": true,
          "maxTicks": 300,
          "timeoutMs": 300000
        }
      ],
      "expect": {
        "equals": {
          "dangerZoneClear": true
        }
      }
    },
    {
      "command": "blast",
      "timeout": 60,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0
        }
      }
    },
    {
      "command": "tick 20",
      "role": "setup",
      "description": "Let the hauler start clearing the blasted rock before selling it.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 20"
        }
      ]
    },
    {
      "command": "event choose 0",
      "role": "player",
      "commandOutcome": "either",
      "description": "Resolved through the event dialog's own buttons, only when one is pending.",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ]
    },
    {
      "command": "tick 6",
      "role": "setup",
      "description": "Let the hauler start clearing the blasted rock before selling it.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 6"
        }
      ]
    },
    {
      "command": "contract accept type:ore_sale fillable:true",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Accept an ore sale the store covers in full.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"][data-contract-fillable=\"true\"] .bs-contract-accept"
        }
      ]
    },
    {
      "command": "contract deliver type:ore_sale amount:100000",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Deliver the ore in store against it.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"] .bs-contract-deliver"
        }
      ]
    },
    {
