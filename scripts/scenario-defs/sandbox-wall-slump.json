          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        }
      ],
      "description": "Fire the bench.",
      "timeout": 90,
      "role": "player"
    },
    {
      "command": "wait_until field:holeCount equals:0 max_ticks:600",
      "role": "setup",
      "description": "Blast resolved.",
      "interaction": [
        {
          "type": "waitUntil",
