{
  "name": "sandbox-wall-slump",
  "description": "Wall stability (#1941): on a progression site a face taller than the rock's safe height slumps after a blast. Two 7 m benches blasted straight down (14 m wall in soft desert rock, safe height 12 m) slump and raise wallSlumpCount; the same depth with a 4 m berm left on the floor (second bench is one hole mid-crater) does not.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site (kit:full): wall stability is on, soft desert rock holds a 12 m face.",
      "expect": {
        "equals": {
          "wallSlumpCount": 0
        }
      }
    },
    {
      "command": "build explosive_warehouse at:8,8",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"explosive_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front so charging needs no delivery wait.",
      "role": "player"
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "description": "The explosive warehouse is built.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "buy explosive:boomite kg:100",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"stock-buy\"]"
        }
      ],
      "description": "Buy enough boomite for every blast into the warehouse stock.",
      "expect": {
        "decreased": [
          "cash"
        ]
      },
      "role": "player"
    },
    {
      "command": "drill_plan add x:36 z:31 depth:7 diameter:89",
      "role": "player",
      "description": "Bench 1 (site A): 7 m hole at 36,31.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"add-hole-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 7
        },
        {
          "type": "focusTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "pickTile",
          "x": 36,
          "z": 31
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:3000",
      "role": "setup",
      "description": "Holes drilled.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2.5",
      "role": "player",
      "description": "Load the holes.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2.5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
