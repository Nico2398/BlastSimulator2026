{
  "name": "blast-preview-tiers-visual",
  "description": "Visual verification of blast preview overlays across 4 software tiers: tier 0 blind, tier 1 energy heatmap, tier 2 fragment distribution, tier 3 projection zones, tier 4 vibration propagation",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:5 depth:6 start:15,15",
      "description": "The grid tool's spacing stepper defaults to 3m (DEFAULT_SPACING_M, Drill.ts); one increment click on the strip's spacing stepper (data-field=\"spacing\") raises it to 4 before dragging, so the (15,15)-(20,20) rectangle (5x5) computes the declared 2x2 instead of the default-spacing 3x3 (issue #479 follow-up, Finding #4). depth corrected from 8 to 6 (Ground rule #15/Finding #42's class, the whole-suite audit before Phase 3): this step never clicks the grid tool's depth stepper (data-field=\"depth\"), so the real drag always produces the panel's own 6m default regardless of what's declared. This file's own expect blocks only assert hole/charge/sequence counts around the affected blast (depth-insensitive), so this is a metadata-only correction -- verified both modes still pass unchanged.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-param-strip [data-field=\"spacing\"] .bsx-stepper-btn:last-child"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 4
        },
        "note": "2 rows x 2 cols = 4"
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "chargedCount": 4
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "sequencedCount": 4
        }
      }
    },
    {
      "command": "blast_preview",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"run-analysis\"]"
        }
      ],
      "role": "player",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"run-analysis\"]"
      }
    },
    {
      "command": "preview energy",
      "interaction": [
        {
          "type": "command",
          "command": "preview energy"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:1",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"1\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 49500
        }
      }
    },
    {
      "command": "preview energy",
      "interaction": [
        {
          "type": "command",
          "command": "preview energy"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"2\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 47500
        }
      }
    },
    {
      "command": "preview fragments",
      "interaction": [
        {
          "type": "command",
          "command": "preview fragments"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:3",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"3\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 42500
        }
      }
    },
    {
      "command": "preview projections",
      "interaction": [
        {
          "type": "command",
          "command": "preview projections"
        }
      ],
      "role": "observe"
    },
    {
      "command": "buy_software tier:4",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"4\"] [data-action=\"buy-tier\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 30500
        }
      }
    },
    {
      "command": "preview vibrations",
      "interaction": [
        {
          "type": "command",
          "command": "preview vibrations"
        }
      ],
      "role": "observe"
    },
    {
      "command": "blast_preview",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"run-analysis\"]"
        }
      ],
      "role": "player",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"run-analysis\"]",
        "note": "regression guard (#24): a fully-grown Predicted list must not push Run Analysis below the panel's fold, all 4 tiers owned"
      }
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    }
  ]
}
