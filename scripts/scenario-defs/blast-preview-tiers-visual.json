{
  "name": "blast-preview-tiers-visual",
  "description": "Visual verification of blast preview overlays across 4 software tiers: tier 0 blind, tier 1 energy heatmap, tier 2 fragment distribution, tier 3 projection zones, tier 4 vibration propagation",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 10,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:5 depth:8 start:15,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 20,
          "z2": 20
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
