{
  "name": "time-management-visual",
  "description": "Visual verification of time management controls: speed buttons (1x, 2x, 4x, 8x), pause/resume toggle, current speed indicator in HUD, tick count display, and auto-pause behavior during events. Originally console-only despite its own description promising real button clicks (issue #479 follow-up) -- pause/resume and every speed change now go through the real HUD controls.",
  "steps": [
    {
      "command": "new_game seed:42",
      "timeout": 15,
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000,
          "isPaused": false,
          "timeScale": 1,
          "tickCount": 0
        }
      }
    },
    {
      "command": "campaign start level:dusty_hollow",
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 50000
        }
      }
    },
    {
      "command": "time status",
      "interaction": [
        {
          "type": "command",
          "command": "time status"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "isPaused": false,
          "timeScale": 1
        }
      }
    },
    {
      "command": "time pause",
      "description": "The pause/resume control is a single toggle button (TopBar.ts) with no separate pause vs. resume element -- one click alternates it, matching togglePause()'s own `isPaused ? 'time resume' : 'time pause'` logic.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top [data-action=\"pause-toggle\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "isPaused": true
        }
      }
    },
    {
      "command": "time status",
      "interaction": [
        {
          "type": "command",
          "command": "time status"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "isPaused": true
        }
      }
    },
    {
      "command": "time resume",
      "description": "Same toggle button as the pause step above -- clicking it again alternates back.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top [data-action=\"pause-toggle\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "isPaused": false
        }
      }
    },
    {
      "command": "time speed 2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"2\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "timeScale": 2
        }
      }
    },
    {
      "command": "time status",
      "interaction": [
        {
          "type": "command",
          "command": "time status"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "timeScale": 2
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "tickCount": 5
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-choice",
          "timeoutMs": 500
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-dismiss",
          "timeoutMs": 500
        }
      ],
      "description": "Answered through the event dialog's own buttons (EventModal). clickIfPresent, not clickSelector: this step follows a bare tick, so whether an event fired is a random roll and the dialog may not be on screen at all -- the console command it replaced no-ops in exactly that case. When a dialog IS up, a real click has to work, and the usability gate is the same one clickSelector uses, so an inert control still counts as unclickable. Second click dismisses the outcome panel the choice opens.",
      "role": "player"
    },
    {
      "command": "time speed 4",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-hud-top .bs-speed-btn button[data-speed=\"4\"]"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "timeScale": 4
        }
      }
    },
    {
      "command": "time status",
      "interaction": [
        {
          "type": "command",
          "command": "time status"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "timeScale": 4
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "tickCount": 10
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-choice",
          "timeoutMs": 500
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-dismiss",
          "timeoutMs": 500
        }
      ],
      "description": "Answered through the event dialog's own buttons (EventModal). clickIfPresent, not clickSelector: this step follows a bare tick, so whether an event fired is a random roll and the dialog may not be on screen at all -- the console command it replaced no-ops in exactly that case. When a dialog IS up, a real click has to work, and the usability gate is the same one clickSelector uses, so an inert control still counts as unclickable. Second click dismisses the outcome panel the choice opens.",
      "role": "player"
    },
