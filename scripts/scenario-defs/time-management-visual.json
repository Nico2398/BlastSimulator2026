          "command": "time status"
        }
      ],
      "role": "observe",
      "expect": {
        "equals": {
          "timeScale": 8
        }
      }
    },
    {
      "command": "tick 5",
      "interaction": [
        {
          "type": "command",
          "command": "tick 5"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "tickCount": 15
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-event-dialog .bs-event-choice",
          "timeoutMs": 500
        },
        {
          "type": "clickIfPresent",
