{
  "name": "sandbox-starter-survey",
  "description": "Free starter survey (#2148): on a fresh menu-default sandbox a player plans and charges a pattern on the starter deposit without hiring a surveyor or ordering a survey, and the Blast Workshop footer already values the ore (no 'survey the area' hint).",
  "steps": [
    {
      "command": "sandbox start",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start"
        }
      ],
      "description": "Setup: the menu-default sandbox (desert_badlands, digger kit, seed 12345). It opens with a free seismic survey over the starter deposit; nobody is hired and no survey is ordered.",
      "expect": {
        "equals": {
          "surveyCount": 1,
          "holeCount": 0
        }
      }
    },
    {
      "command": "wait_until field:orderedBuildingCount equals:0 max_ticks:400",
      "role": "setup",
      "timeout": 330,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedBuildingCount",
          "equals": 0,
          "maxTicks": 400,
          "timeoutMs": 300000
        }
      ],
      "description": "Let any opening building orders finish.",
      "expect": {
        "equals": {
          "orderedBuildingCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:5 start:14,17",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 1
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 5
        },
        {
          "type": "dragTiles",
          "x1": 14,
          "z1": 17,
          "x2": 22,
          "z2": 25
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Plan a 3x3 pattern, 4 m apart and 5 m deep, centred on the starter deposit at (18, 21).",
      "expect": {
        "increased": [
          "orderedHoleCount"
        ]
      }
    },
    {
      "command": "event choose 0",
      "role": "player",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either"
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:2500",
      "role": "setup",
      "timeout": 330,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 2500,
          "timeoutMs": 300000
        }
      ],
      "description": "The driller lands every ordered hole.",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 9
        }
      }
    },
    {
      "command": "charge hole:* explosive:krackle stemming:2.5",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"select-explosive\"][data-explosive=\"krackle\"]"
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2.5
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "description": "Charge every hole with 4 kg of Krackle.",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "event choose 0",
      "role": "player",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Clear an event if one is pending (nondeterministic beat); a pending event halts the clock.",
      "commandOutcome": "either"
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:4500",
      "role": "setup",
      "timeout": 330,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 4500,
          "timeoutMs": 300000
        }
      ],
      "description": "The blaster loads every charge.",
      "expect": {
        "equals": {
          "orderedChargeCount": 0,
          "chargedCount": 9
        }
      }
    },
    {
      "command": "state",
      "role": "player",
      "timeout": 90,
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-blast-panel #bs-blast-fire"
        },
        {
          "type": "waitForProperty",
          "selector": "#bs-blast-panel div:has(> #bs-blast-fire) > div:nth-child(2)",
          "property": "offsetParent",
          "expectedValue": null,
          "timeoutMs": 10000
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "screenshot"
        }
      ],
      "description": "No survey was ordered and nobody was hired, yet the Blast Workshop footer prices the pattern: the 'survey the area to value this blast' hint under EST. ORE VALUE is hidden (its offsetParent is null; the footer has no data-role on that line to select by) and FIRE is usable.",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"execute\"]",
        "equals": {
          "surveyCount": 1
        }
      }
    }
  ]
}
