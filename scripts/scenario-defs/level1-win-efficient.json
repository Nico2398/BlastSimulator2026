{
  "name": "level1-win-efficient",
  "description": "Level 1 (Dusty Hollow) won genuinely (#1363): two large 3x3 deep blasts, selling the rock after each, then waiting for operating profit to reach the target. No cash override, no staffed flag, no campaign complete.",
  "steps": [
    {
      "command": "campaign start level:dusty_hollow",
      "role": "setup",
      "timeout": 60,
      "interaction": [
        {
          "type": "command",
          "command": "campaign start level:dusty_hollow"
        }
      ],
      "description": "The level exactly as the UI starts it: no cash override, no staffed flag. It opens with a driller, a blaster, a driver, a drill rig, a debris hauler and a freight warehouse (#1363).",
      "expect": {
        "equals": {
          "cash": 50000,
          "tickCount": 0,
          "employeeCount": 3,
          "holeCount": 0
        }
      }
    },
    {
      "command": "time resume",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "time resume"
        }
      ]
    },
    {
      "command": "time speed 8",
      "role": "setup",
      "description": "Speed up the waits below.",
      "interaction": [
        {
          "type": "command",
          "command": "time speed 8"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:8 start:15,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 8
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 23,
          "z2": 23
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 9
        },
        "note": "9 holes ordered with the level's own crew and rig."
      },
      "description": "Order a drill grid with the crew and rig the level opens with: nothing was hired or bought."
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "description": "Cycle 1: the driller lands every ordered hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "role": "player",
      "interaction": [
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "description": "Cycle 1: the blaster loads every charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      }
    },
    {
      "command": "blast",
      "timeout": 60,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      }
    },
    {
      "command": "tick 40",
      "role": "setup",
      "description": "Let the hauler start clearing the blasted rock before selling it.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 40"
        }
      ]
    },
    {
      "command": "contract accept fillable:true",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Accept an offer the site can fill in full; either outcome passes because whether one is on the board depends on how much rock has been hauled so far.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"][data-contract-fillable=\"true\"] .bs-contract-accept, #bs-contract-panel [data-contract-type=\"rubble_disposal\"][data-contract-fillable=\"true\"] .bs-contract-accept"
        }
      ]
    },
    {
      "command": "contract deliver fillable:true amount:100000",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Deliver what is in store against the accepted contract.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"] .bs-contract-deliver, #bs-contract-panel [data-contract-type=\"rubble_disposal\"] .bs-contract-deliver"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:3 cols:3 spacing:4 depth:8 start:29,15",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 8
        },
        {
          "type": "dragTiles",
          "x1": 29,
          "z1": 15,
          "x2": 37,
          "z2": 23
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 9
        },
        "note": "9 holes ordered with the level's own crew and rig."
      },
      "description": "Order a drill grid with the crew and rig the level opens with: nothing was hired or bought.",
      "skipWhenLevelEnded": true
    },
    {
      "command": "wait_until field:orderedHoleCount equals:0 max_ticks:900",
      "description": "Cycle 2: the driller lands every ordered hole.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedHoleCount",
          "equals": 0,
          "maxTicks": 900,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "role": "player",
      "interaction": [
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      },
      "skipWhenLevelEnded": true
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "description": "Cycle 2: the blaster loads every charge.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 300000
        }
      ],
      "timeout": 330,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "expect": {
        "equals": {
          "sequencedCount": 9
        }
      },
      "skipWhenLevelEnded": true
    },
    {
      "command": "blast",
      "timeout": 60,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-confirm-overlay .bs-btn-danger"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ],
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        }
      },
      "skipWhenLevelEnded": true
    },
    {
      "command": "tick 40",
      "role": "setup",
      "description": "Let the hauler start clearing the blasted rock before selling it.",
      "interaction": [
        {
          "type": "command",
          "command": "tick 40"
        }
      ]
    },
    {
      "command": "contract accept fillable:true",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Accept an offer the site can fill in full; either outcome passes because whether one is on the board depends on how much rock has been hauled so far.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"][data-contract-fillable=\"true\"] .bs-contract-accept, #bs-contract-panel [data-contract-type=\"rubble_disposal\"][data-contract-fillable=\"true\"] .bs-contract-accept"
        }
      ],
      "skipWhenLevelEnded": true
    },
    {
      "command": "contract deliver fillable:true amount:100000",
      "role": "player",
      "commandOutcome": "either",
      "timeout": 120,
      "description": "Deliver what is in store against the accepted contract.",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "contracts"
        },
        {
          "type": "clickIfPresent",
          "selector": "#bs-contract-panel [data-contract-type=\"ore_sale\"] .bs-contract-deliver, #bs-contract-panel [data-contract-type=\"rubble_disposal\"] .bs-contract-deliver"
        }
      ],
      "skipWhenLevelEnded": true
    },
    {
      "command": "wait_until field:levelEnded equals:true max_ticks:6000",
      "role": "setup",
      "timeout": 1260,
      "description": "Keep selling the blasted rock; the level ends on its own once operating profit reaches the $80,000 target.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "levelEnded",
          "equals": true,
          "maxTicks": 6000,
          "timeoutMs": 600000
        }
      ],
      "expect": {
        "equals": {
          "levelEnded": true
        }
      }
    },
    {
      "command": "state",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "state"
        }
      ],
      "description": "Terminal outcome: a genuine win, reached with no `campaign complete` and no cash override.",
      "expect": {
        "equals": {
          "levelEnded": true,
          "levelEndReason": "completed"
        }
      }
    }
  ]
}
