{
  "name": "vehicle-purchase-tier-ui-visual",
  "description": "Visual check: vehicle purchase menu shows all roles with cost stats and purchase buttons for tier comparison",
  "steps": [
    {
      "command": "new_game seed:42 cash:300000",
      "timeout": 10,
      "description": "Bumped cash from 100k to 300k: the file's 4 purchases (25k+50k+50k+140k=265k) overdraw command mode past 100k before the tier:2/tier:3 buys, which would leave those buy buttons disabled for a real click -- exactly what this file's own name (tier UI) needs to demonstrate.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 cash:300000"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 300000,
          "vehicleCount": 0
        }
      }
    },
    {
      "command": "vehicle list",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle buy debris_hauler",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -25000
        },
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "vehicle list",
      "description": "The pre-existing interaction here clicked [data-vtype=\"rock_fragmenter\"][data-tier=\"2\"] despite the step's command being the read-only `vehicle list` -- vehicle buy buttons purchase immediately on click (no confirm step, unlike buildings), so that stray click silently bought an unrecorded vehicle every interaction-mode run. Dropped as a latent bug in the pre-#479 hand content, not preserved.",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "vehicle buy rock_digger",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"rock_digger\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -50000
        },
        "equals": {
          "vehicleCount": 2
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler tier:2",
      "description": "Tier-2 purchase via the new `tier:` arg (#411), dual-played identically in both modes through the console.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"debris_hauler\"][data-tier=\"2\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -50000
        },
        "equals": {
          "vehicleCount": 3
        }
      }
    },
    {
      "command": "vehicle buy drill_rig tier:3",
      "description": "Tier-3 purchase via the new `tier:` arg (#411), dual-played identically in both modes through the console.",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel [data-vtype=\"drill_rig\"][data-tier=\"3\"]"
        }
      ],
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -140000
        },
        "equals": {
          "vehicleCount": 4
        }
      }
    },
    {
      "command": "vehicle list",
      "interaction": [
        {
          "type": "command",
          "command": "vehicle list"
        }
      ],
      "role": "observe"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    }
  ],
  "shots": [
    {
      "name": "purchase-menu",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "fleet-after-purchase",
      "yaw": 45,
      "pitch": 30
    },
    {
      "name": "panel-detail",
      "yaw": 90,
      "pitch": 10
    }
  ]
}
