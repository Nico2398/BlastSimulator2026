{
  "name": "blast-workshop-french-visual",
  "description": "Redesign P4/#28: the Blast Workshop panel (all 5 steps) rendered in French — French strings run noticeably longer than English in several spots (tier names, checklist lines), so this checks for real layout breakage, not just that check-i18n-parity's key-set/value-diff scan passes. Plan origin is (5,5), not (10,10): a 2x2 grid at (10,10) on this same seed hits a pre-existing terrain-remesh crash ('edgeVerts[e] is not iterable') unrelated to French or this panel — reproduces from pure console commands with no UI involved. Filed as a known issue, not fixed here. Setup split so the blast pipeline steps are individually role-marked and clicked for real (issue #479).",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45,
      "target": [
        5,
        5
      ],
      "distance": 15
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 size:32 staffed:true",
      "timeout": 30,
      "role": "setup",
      "description": "Staffed opening (#551): a driller with blasting + drill_rig licence, plus an unmanned drill_rig, are hired/purchased for free at game-open — #553's automatic drill dispatch needs both to ever land an ordered hole.",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:32 staffed:true"
        }
      ],
      "expect": {
        "equals": {
          "cash": 50000,
          "holeCount": 0
        }
      }
    },
    {
      "command": "drill_plan grid origin:5,5 rows:2 cols:2 spacing:3 depth:6",
      "timeout": 60,
      "role": "player",
      "description": "Split out of the original bundled setup step (issue #479). Drag (5,5)-(8,8) is 3x3 at the panel's own default spacing (DEFAULT_SPACING_M=3, Drill.ts) — matches the declared spacing:3 exactly, no stepper click needed (unlike most other blast-* grid steps, Finding #4). #553: confirming the grid queues 4 drill_hole PendingActions and pushes 4 PlannedHoles into plannedDrillHoles — none drilled yet, so holeCount stays 0 right after confirm.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 5,
          "z1": 5,
          "x2": 8,
          "z2": 8
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "expect": {
        "equals": {
          "orderedHoleCount": 4,
          "holeCount": 0
        },
        "note": "2 rows x 2 cols = 4 holes ordered (ghosts), none drilled yet (#553)"
      }
    },
    {
      "command": "tick 45",
      "description": "#553: drain the ordered plan — the staffed driller/drill_rig lands all 4 holes well inside this pad (sandbox-measured landing at tick 35).",
      "interaction": [
        {
          "type": "command",
          "command": "tick 45"
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 4
        }
      }
    },
    {
      "command": "charge hole:* explosive:boomite amount:5kg stemming:2m",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:orderedChargeCount equals:0 max_ticks:3000",
      "description": "#554: drain the charge order(s) queued by the step above (charging is real work, not instant) before continuing.",
      "interaction": [
        {
          "type": "waitUntil",
          "field": "orderedChargeCount",
          "equals": 0,
          "maxTicks": 3000,
          "timeoutMs": 120000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 4,
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "sequence auto delay_step:25",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"auto-sequence\"]"
        }
      ],
      "expect": {
        "equals": {
          "sequencedCount": 4
        }
      }
    },
    {
      "command": "buy_software",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-tier=\"1\"] [data-action=\"buy-tier\"]"
        }
      ],
      "expect": {
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "blast_preview",
      "timeout": 30,
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"run-analysis\"]"
        }
      ],
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"run-analysis\"]"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Switch to French from Settings",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"settings\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-settings-panel [data-lang=\"fr\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-settings-panel",
        "note": "panel stays alive after switching locale in place (i18n-live-locale-switch.json's Bug 1 regression pattern) — the actual French text is verified visually via screenshot, not state, since expect has no text-content field"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Drill step in French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"1\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"grid-tool\"]",
        "note": "the panel must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Charge step in French — product cards and the tubing block are the longest French strings in the whole panel",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"2\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"charge-all\"]",
        "note": "the panel must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Sequence step in French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"3\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"auto-sequence\"]",
        "note": "the panel must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Preview step in French — tier names run long (Prévision de fragmentation, Cône de risque de projection)",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"4\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"run-analysis\"]",
        "note": "the panel must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Fire step in French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-step=\"5\"]"
        },
        {
          "type": "wait",
          "durationMs": 200
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "#bs-blast-panel [data-action=\"execute\"]",
        "note": "the panel must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "PreflightModal in French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "wait",
          "durationMs": 300
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "observe",
      "expect": {
        "usable": "[data-action=\"preflight-detonate\"]",
        "note": "the modal must still be alive and clickable rendered in French, actual text verified via screenshot"
      }
    },
    {
      "command": "blast",
      "timeout": 30,
      "description": "BlastReportModal in French",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "wait",
          "durationMs": 400
        },
        {
          "type": "screenshot"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0,
          "sequencedCount": 0
        },
        "note": "a fired blast clears the plan back to zero — BlastReportModal auto-opens with the real report rendered in French, verified visually via screenshot"
      }
    }
  ]
}
