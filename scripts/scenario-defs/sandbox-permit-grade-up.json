{
  "name": "sandbox-permit-grade-up",
  "description": "Mine grades (#1921): a sandbox site starts at grade 0, refuses an application before its targets are met, then after 5 t of ore delivered and 2 blasts fired, `permit apply` books the $20,000 fee and 48 ticks later the site is a Hobby Quarry (grade 1). The state dump's `mineGrade` field carries the grade.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:full seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:full seed:42"
        }
      ],
      "description": "Progression site: the sandbox opens with a permit ladder at grade 0.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "permit status",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "permit status"
        }
      ],
      "description": "Backyard Dig Permit with the grade-1 targets (5 t ore, 2 blasts) unmet."
    },
    {
      "command": "permit apply",
      "role": "bootstrap",
      "interaction": [
        {
          "type": "command",
          "command": "permit apply"
        }
      ],
      "description": "Applying before the targets are met is refused.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "pendingTicksLeft": null
          }
        }
      },
      "commandOutcome": "refused"
    },
    {
      "command": "build explosive_warehouse at:8,8",
