        },
        {
          "type": "pickTile",
          "x": 8,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "description": "Stock explosives up front: the crew idles on payroll during a 400-tick delivery wait, which the starting cash cannot pay for twice.",
      "role": "player"
    },
