{
  "name": "freight-warehouse-contents-visual",
  "description": "Freight Warehouse contents in the entity inspector (#1757), by real clicks: the player drills and charges a pattern, builds a freight warehouse, fires the blast, lets the haulers store ore, then clicks the warehouse in the scene. The inspector shows the stored/capacity gauge and one localized row per ore; the rows and gauge refresh in place as more loads arrive.",
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    }
  ],
  "steps": [
    {
      "command": "new_game seed:42 size:31 staffed:true cash:300000",
      "description": "Staffed opening: drill rig, charging truck, debris hauler and crew for free. No warehouse, no stock.",
      "timeout": 30,
      "role": "setup",
      "expect": {
        "equals": {
          "cash": 300000,
          "holeCount": 0,
          "buildingCount": 0
        }
      },
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42 size:31 staffed:true cash:300000"
        }
      ]
    },
    {
      "command": "drill_plan grid rows:2 cols:3 spacing:4 depth:6 start:15,15",
      "description": "Order the 2x3 pattern by real clicks, as in blast-charge-visual.",
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 6,
          "holeCount": 0
        }
      },
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 4
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 15,
          "z1": 15,
          "x2": 23,
          "z2": 19
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ]
    },
    {
      "command": "wait_until field:holeCount equals:6 max_ticks:300",
      "description": "The crew drills all six holes.",
      "timeout": 125,
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 6
        }
      },
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 6,
          "maxTicks": 300,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "command": "build freight_warehouse at:3,8",
      "description": "The player orders the tier-1 Freight Warehouse from the Build panel.",
      "role": "player",
      "expect": {
        "changedBy": {
          "cash": -15000
        },
        "equals": {
          "orderedBuildingCount": 1
        }
      },
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"freight_warehouse\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 3,
          "z": 8
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ]
    },
    {
      "command": "wait_until field:buildingCount equals:1 max_ticks:400",
      "description": "Let the crew build the warehouse out.",
      "timeout": 130,
      "role": "setup",
      "expect": {
        "equals": {
          "buildingCount": 1,
          "orderedBuildingCount": 0
        }
      },
      "interaction": [
        {
          "type": "waitUntil",
          "field": "buildingCount",
          "equals": 1,
          "maxTicks": 400,
          "timeoutMs": 120000
        }
      ]
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "description": "Charge all six holes by real clicks. Boomite is bought per charge at cash price: no explosive stock is held.",
      "role": "player",
      "expect": {
        "equals": {
          "orderedChargeCount": 6
        }
      },
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "blast"
        },
        {
          "type": "ensureStep",
          "step": 2
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ]
    },
    {
      "command": "time speed 8",
      "description": "Speed up the loading wait.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "time speed 8"
        }
      ]
    },
    {
      "command": "wait_until field:chargedCount equals:6 max_ticks:6400",
      "timeout": 325,
      "description": "The charging crew loads all six holes.",
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 6
        }
      },
      "interaction": [
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 6,
          "maxTicks": 6400,
          "timeoutMs": 320000
        }
      ]
    },
    {
      "command": "time speed 1",
      "description": "Restore normal speed.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "time speed 1"
        }
      ]
    },
    {
      "command": "blast detonate",
      "timeout": 60,
      "description": "FIRE opens the Preflight modal; DETONATE arms the sequence. On a 31-cell map the crew near the pattern cannot evacuate, so the modal offers Fire anyway (same path as blast-fire-step-visual).",
      "role": "player",
      "expect": {
        "usable": "[data-action=\"preflight-fire-anyway\"]"
      },
      "interaction": [
        {
          "type": "ensureStep",
          "step": 4
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"execute\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "clickSelector",
          "selector": "[data-action=\"preflight-detonate\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"preflight-fire-anyway\"]"
        }
      ]
    },
    {
      "command": "blast",
      "timeout": 30,
      "description": "Fire anyway: the blast fires and the report opens.",
      "role": "player",
      "expect": {
        "equals": {
          "holeCount": 0,
          "chargedCount": 0
        }
      },
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"preflight-fire-anyway\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ]
    },
    {
      "command": "state",
      "description": "Close the report.",
      "role": "player",
      "expect": {
        "blocked": "[data-action=\"report-close\"]"
      },
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "[data-action=\"report-close\"]"
        }
      ]
    },
    {
      "command": "tick 10",
      "timeout": 130,
      "description": "#1907: union events run on their own cooldown clock, so the Drills Realistic event now lands at tick 310, three ticks into this batch, and halts it. Advance to it here so the next step resolves it and the hauling window below runs in full.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ]
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "description": "Resolved through the event dialog's own buttons; decides whether an event is pending from authoritative game state, not from whether the modal has rendered.",
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "tick 60",
      "timeout": 130,
      "description": "Let the haulers carry the first ore into the warehouse.",
      "role": "setup",
      "expect": {
        "increased": [
          "storedMassKg"
        ]
      },
      "interaction": [
        {
          "type": "command",
          "command": "tick 60"
        }
      ]
    },
    {
      "command": "state",
      "description": "The player selects the Freight Warehouse (the first building placed, id 1) from its row in the Build panel. The inspector's contents section shows the stored/capacity gauge and at least one per-ore row. Selecting through the panel, not a scene click, keeps the step independent of whichever hauler or crew member is standing in front of the warehouse mesh at that moment (a scene ray picks the nearest entity; CI selected that entity instead, #1761).",
      "timeout": 90,
      "role": "player",
      "expect": {
        "usable": "#bs-inspector [data-live=\"gauge\"]"
      },
      "interaction": [
        {
          "type": "clickIfPresent",
          "selector": "#bs-inspector [data-panel-close]",
          "timeoutMs": 0
        },
        {
          "type": "ensurePanel",
          "panel": "build"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-build-panel .bs-build-placed-row div"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-placed-row div"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-inspector[data-kind=\"building\"][data-id=\"1\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-inspector [data-live=\"gauge\"]",
          "timeout": 30000
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-inspector [data-live^=\"ore-row-\"]",
          "timeout": 30000
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "command": "tick 150",
      "timeout": 130,
      "description": "Haulers keep unloading with the inspector open; the gauge and per-ore rows refresh in place as loads arrive, so the stored mass grows. #1895/#1907 merge: a spontaneous event (union clock, #1907) can land in the first ticks of this window and halt it before any load reaches the warehouse, now that the delivery wait puts the hauling window past tick ~600; the storedMassKg increase is asserted by the next full-length hauling step, after the event is cleared.",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "tick 150"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-inspector [data-live^=\"ore-row-\"]"
        },
        {
          "type": "screenshot"
        }
      ]
    },
    {
      "command": "state full",
      "role": "observe",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ]
    }
  ]
}
