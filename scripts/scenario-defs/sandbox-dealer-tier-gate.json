{
  "name": "sandbox-dealer-tier-gate",
  "description": "Dealer tier gate (#2282): on a progression site the equipment dealer refuses a tier-2 debris hauler until the tier-2 fleet quest is done (console refuses, Fleet panel button is greyed with a lock line naming the quest); once it is done the same purchase succeeds whatever the grade, and tier 3 stays locked until its own quest.",
  "steps": [
    {
      "command": "sandbox start biome:desert_badlands kit:digger seed:42",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "sandbox start biome:desert_badlands kit:digger seed:42"
        }
      ],
      "description": "Progression site with the digger kit; the quests are open.",
      "expect": {
        "equals": {
          "mineGrade": {
            "grade": 0,
            "tier": 1,
            "pendingTicksLeft": null
          }
        }
      }
    },
    {
      "command": "vehicle list",
      "role": "player",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"2\"]"
        }
      ],
      "description": "Open the Fleet panel; the dealership lists the hauler tiers.",
      "expect": {
        "usable": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"1\"]"
      }
    },
    {
      "command": "vehicle buy debris_hauler tier:2",
      "role": "guard",
      "commandOutcome": "refused",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"2\"] .bs-fleet-tier-lock"
        }
      ],
      "description": "Tier-2 quest open: the hauler button is greyed out with a lock line and the console refuses the same purchase.",
      "expect": {
        "blocked": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"2\"]",
        "changedBy": {
          "vehicleCount": 0,
          "cash": 0
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler tier:3",
      "role": "guard",
      "commandOutcome": "refused",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"3\"] .bs-fleet-tier-lock"
        }
      ],
      "description": "Tier 3 is locked as well.",
      "expect": {
        "blocked": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"3\"]",
        "changedBy": {
          "vehicleCount": 0
        }
      }
    },
    {
      "command": "quest complete quest_vehicle_t2",
      "role": "setup",
      "interaction": [
        {
          "type": "command",
          "command": "quest complete quest_vehicle_t2"
        }
      ],
      "description": "Complete the tier-2 fleet quest (scenario shortcut for playing the objectives).",
      "expect": {
        "changedBy": {
          "vehicleCount": 0
        }
      }
    },
    {
      "command": "vehicle buy debris_hauler tier:2",
      "role": "player",
      "interaction": [
        {
          "type": "ensurePanel",
          "panel": "vehicles"
        },
        {
          "type": "awaitUsable",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"2\"]"
        },
        {
          "type": "clickSelector",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"2\"]"
        }
      ],
      "description": "Quest done: the tier-2 hauler is on sale at the usual price and the purchase succeeds, whatever the grade.",
      "expect": {
        "changedBy": {
          "vehicleCount": 1
        },
        "decreased": [
          "cash"
        ]
      }
    },
    {
      "command": "vehicle buy debris_hauler tier:3",
      "role": "guard",
      "commandOutcome": "refused",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"3\"] .bs-fleet-tier-lock"
        }
      ],
      "description": "The tier-2 quest does not unlock tier 3.",
      "expect": {
        "blocked": ".bs-fleet-tier-btn[data-role=\"debris_hauler\"][data-tier=\"3\"]",
        "changedBy": {
          "vehicleCount": 0
        }
      }
    }
  ]
}
