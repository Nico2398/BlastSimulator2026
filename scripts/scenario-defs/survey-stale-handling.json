    {
      "command": "employee hire role:driller",
      "description": "#553: drill_hole is now a queued, vehicle-gated action -- a driller physically drives a drill_rig to each hole -- so this file (which pre-#553 never needed a driller at all) now needs one. campaign start has no staffed:true equivalent, so this is a manual hire + purchase, same pattern as survey-then-blast.json. Employee #3 -- #1 and #2 are the two surveyors hired above.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"employees\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-employee-panel [data-role=\"driller\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "employeeCount": 2
        }
      }
    },
    {
      "command": "vehicle buy drill_rig",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"vehicles\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-vehicle-panel .bs-fleet-tier-btn[data-vtype=\"drill_rig\"][data-tier=\"1\"]"
        }
      ],
      "role": "player",
      "expect": {
        "decreased": [
          "cash"
        ],
        "equals": {
          "vehicleCount": 1
        }
      }
    },
    {
      "command": "employee assign_skill 2 skill:driving.drill_rig level:1",
      "description": "Left unmarked: hiring already grants blasting at Rookie (ROLE_STARTING_QUALIFICATION), but no role starts with driving.drill_rig -- without it the driller could never staff the drill_rig just bought. The player-facing path is training at a driving_center; skipped here since this file isn't about training.",
      "interaction": [
        {
          "type": "command",
          "command": "employee assign_skill 2 skill:driving.drill_rig level:1"
        }
      ],
      "role": "bootstrap"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:3 depth:6 start:20,20",
      "description": "Corrected spacing from 4 to 3 to match the drag (#1072): no stepper click precedes the drag, so the grid tool's spacing stays at its default 3m (DRILL_GRID_DEFAULT_SPACING_M, balance.ts). The (20,20)-(24,24) rectangle (4x4) computes round(4/3)+1=2 per axis, matching the declared 2x2. #553: confirming the grid queues 4 drill_hole PendingActions and pushes 4 PlannedHoles into plannedDrillHoles — none drilled yet, so holeCount stays 0 right after confirm.",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"spacing\"]",
          "value": 3
        },
        {
          "type": "setStepper",
          "selector": "#bs-param-strip [data-field=\"depth\"]",
          "value": 6
        },
        {
          "type": "dragTiles",
          "x1": 20,
          "z1": 20,
          "x2": 24,
          "z2": 24
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "orderedHoleCount": 4,
          "holeCount": 0
        },
        "note": "2 rows x 2 cols = 4 holes ordered (ghosts), none drilled yet (#553)"
      }
    },
    {
      "command": "wait_until field:holeCount equals:4 max_ticks:400",
      "description": "#1261: collapsed the 3-chunk fixed `tick 50`/`tick 50`/`tick 30` drilling pad into a single wait_until on holeCount. Structurally verified only (occupancy is not actually active yet in command mode -- see the campaign start step's own note).",
      "timeout": 100,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "holeCount",
          "equals": 4,
          "maxTicks": 400,
          "timeoutMs": 100000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "orderedHoleCount": 0,
          "holeCount": 4
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
    },
    {
      "command": "charge hole:* explosive:boomite amount:5 stemming:2",
      "interaction": [
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"amount\"]",
          "value": 5
        },
        {
          "type": "setStepper",
          "selector": "#bs-blast-panel [data-field=\"stemming\"]",
          "value": 2
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"charge-all\"]"
        }
      ],
      "role": "player",
      "expect": {
        "increased": [
          "orderedChargeCount"
        ]
      }
    },
    {
      "command": "wait_until field:chargedCount equals:4 max_ticks:300",
      "description": "#1261: collapsed the 4-chunk fixed `tick 15` charging pad into a single wait_until on chargedCount, same reasoning as the drilling wait above.",
      "timeout": 90,
      "interaction": [
        {
          "type": "waitUntil",
          "field": "chargedCount",
          "equals": 4,
          "maxTicks": 300,
          "timeoutMs": 90000
        }
      ],
      "role": "setup",
      "expect": {
        "equals": {
          "chargedCount": 4,
          "orderedChargeCount": 0
        }
      }
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "resolveEventIfPending"
        }
      ],
      "role": "player",
      "commandOutcome": "either"
