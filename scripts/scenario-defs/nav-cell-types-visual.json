{
  "name": "nav-cell-types-visual",
  "description": "Tests the 4 console-reachable NavCell types (walkable, blocked, drill_hole, ramp) render on the overlay",
  "steps": [
    {
      "command": "new_game seed:42",
      "interaction": [
        {
          "type": "command",
          "command": "new_game seed:42"
        },
        {
          "type": "keypress",
          "key": "KeyN"
        }
      ],
      "role": "setup"
    },
    {
      "command": "drill_plan grid rows:2 cols:2 spacing:5 depth:6 start:5,5",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"blast\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-blast-panel [data-action=\"grid-tool\"]"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 5,
          "z1": 5,
          "x2": 10,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "build management_office at:2,2",
      "interaction": [
        {
          "type": "clickSelector",
          "selector": "#bs-toolbar [data-panel=\"build\"]"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel [data-build-type=\"management_office\"] .bs-build-buy-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "pickTile",
          "x": 2,
          "z": 2
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "build_ramp origin:1,20 direction:south length:10 depth:8",
      "interaction": [
        {
          "type": "waitForSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-build-panel .bs-build-ramp-btn"
        },
        {
          "type": "waitForSelector",
          "selector": "#bs-tile-select-confirm"
        },
        {
          "type": "dragTiles",
          "x1": 1,
          "z1": 20,
          "x2": 1,
          "z2": 10
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-tile-select-confirm"
        }
      ],
      "role": "player"
    },
    {
      "command": "state full",
      "interaction": [
        {
          "type": "command",
          "command": "state full"
        }
      ],
      "role": "observe"
    },
    {
      "command": "tick 10",
      "interaction": [
        {
          "type": "command",
          "command": "tick 10"
        }
      ],
      "role": "setup"
    }
  ],
  "shots": [
    {
      "name": "overview",
      "yaw": 0,
      "pitch": 45
    },
    {
      "name": "closeup",
      "yaw": 90,
      "pitch": 10
    },
    {
      "name": "birdseye",
      "yaw": 0,
      "pitch": 80
    },
    {
      "name": "angled",
      "yaw": 135,
      "pitch": 30
    }
  ]
}
