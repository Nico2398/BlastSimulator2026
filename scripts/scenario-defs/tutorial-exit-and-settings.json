{
  "name": "tutorial-exit-and-settings",
  "description": "#1332: mid-tutorial the player can always reach Settings session controls (language pill) and can leave the tutorial through its Exit button behind a confirm. Afterwards the rails are lifted: a Crew-panel hire button that was inert while the card pointed at the first hire is usable. Returning to the menu mid-tutorial suspends it and menu Resume restores the same step (#1599). Every beat after setup is a real click.",
  "steps": [
    {
      "command": "campaign start level:tutorial_pit",
      "timeout": 30,
      "description": "Setup: load Tutorial Pit.",
      "role": "setup",
      "interaction": [{ "type": "command", "command": "campaign start level:tutorial_pit" }]
    },
    {
      "command": "tutorial_start",
      "timeout": 30,
      "description": "Setup: start the tutorial; the card points at hiring a surveyor.",
      "role": "setup",
      "interaction": [
        { "type": "command", "command": "tutorial_start" },
        { "type": "waitForSelector", "selector": "#bs-tutorial-overlay" },
        { "type": "waitForTutorialStep", "stepId": "hire-surveyor" }
      ],
      "expect": { "tutorialStep": "hire-surveyor" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Player opens Settings mid-tutorial (panel navigation is always allowed).",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-toolbar [data-panel=\"settings\"]" },
        { "type": "awaitUsable", "selector": "#bs-settings-panel [data-lang=\"fr\"]" }
      ],
      "expect": { "usable": "#bs-settings-panel [data-lang=\"fr\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Player clicks the fr language pill; session controls are reachable at every tutorial step. The Return to Menu button stays usable too.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-settings-panel [data-lang=\"fr\"]" },
        { "type": "awaitUsable", "selector": "#bs-settings-panel [data-action=\"return-to-menu\"]" }
      ],
      "expect": { "usable": "#bs-settings-panel [data-action=\"return-to-menu\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1599: with Settings still open, player clicks Return to Menu (confirming if asked); the tutorial is suspended, not abandoned.",
      "role": "player",
      "interaction": [
        {"type": "awaitUsable", "selector": "#bs-settings-panel [data-action=\"return-to-menu\"]"},
        {"type": "clickSelector", "selector": "#bs-settings-panel [data-action=\"return-to-menu\"]"},
        {"type": "awaitUsable", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]"},
        {"type": "clickSelector", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]"},
        {"type": "awaitUsable", "selector": "#bs-menu-resume"}
      ],
      "expect": {"usable": "#bs-menu-resume"}
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1599: player clicks Resume on the main menu; the tutorial is back on the same step with a usable Exit control.",
      "role": "player",
      "interaction": [
        {"type": "clickSelector", "selector": "#bs-menu-resume"},
        {"type": "awaitUsable", "selector": "#bs-tutorial-overlay [data-action=\"tutorial-exit\"]"}
      ],
      "expect": {"tutorialStep": "hire-surveyor", "usable": "#bs-tutorial-overlay [data-action=\"tutorial-exit\"]"}
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Player clicks the card's Exit control; a confirm opens and the tutorial is still running.",
      "role": "player",
      "interaction": [
        { "type": "awaitUsable", "selector": "#bs-tutorial-overlay [data-action=\"tutorial-exit\"]" },
        { "type": "clickSelector", "selector": "#bs-tutorial-overlay [data-action=\"tutorial-exit\"]" },
        { "type": "awaitUsable", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" }
      ],
      "expect": { "usable": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]", "tutorialStep": "hire-surveyor" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Player confirms; the tutorial overlay is gone.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" }
      ],
      "expect": { "blocked": "#bs-tutorial-overlay [data-action=\"tutorial-exit\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "Rails lifted: the Crew panel's Driller hire button (inert while the card pointed at the surveyor) is now usable.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-toolbar [data-panel=\"employees\"]" },
        { "type": "awaitUsable", "selector": "#bs-employee-panel [data-role=\"driller\"]" }
      ],
      "expect": { "usable": "#bs-employee-panel [data-role=\"driller\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1634: live game, player opens Settings and clicks Return to Main Menu (confirm); the main menu shows a usable Resume.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-toolbar [data-panel=\"settings\"]" },
        { "type": "awaitUsable", "selector": "#bs-settings-panel [data-action=\"return-to-menu\"]" },
        { "type": "clickSelector", "selector": "#bs-settings-panel [data-action=\"return-to-menu\"]" },
        { "type": "awaitUsable", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" },
        { "type": "clickSelector", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" },
        { "type": "awaitUsable", "selector": "#bs-menu-resume" }
      ],
      "expect": { "usable": "#bs-menu-resume" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1634: with a live game behind the menu, clicking TUTORIAL asks for confirmation instead of starting; Resume is still offered.",
      "role": "player",
      "interaction": [
        { "type": "awaitUsable", "selector": "#bs-main-menu #bs-menu-tutorial" },
        { "type": "clickSelector", "selector": "#bs-main-menu #bs-menu-tutorial" },
        { "type": "awaitUsable", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" }
      ],
      "expect": { "usable": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1634: the confirm is modal; Resume is still on the menu underneath but covered until the player answers.",
      "role": "guard",
      "interaction": [
        { "type": "waitForSelector", "selector": "#bs-menu-resume" }
      ],
      "expect": { "blocked": "#bs-menu-resume" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1634: player cancels; the confirm is gone and Resume is still usable.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-cancel\"]" },
        { "type": "awaitUsable", "selector": "#bs-menu-resume" }
      ],
      "expect": { "usable": "#bs-menu-resume", "blocked": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" }
    },
    {
      "command": "state",
      "timeout": 30,
      "description": "#1634: player clicks TUTORIAL again and confirms; the tutorial restarts at its first step.",
      "role": "player",
      "interaction": [
        { "type": "clickSelector", "selector": "#bs-main-menu #bs-menu-tutorial" },
        { "type": "awaitUsable", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" },
        { "type": "clickSelector", "selector": ".bs-confirm-overlay:not(#bs-event-dialog) [data-action=\"confirm-yes\"]" },
        { "type": "waitForSelector", "selector": "#bs-tutorial-overlay" },
        { "type": "waitForTutorialStep", "stepId": "hire-surveyor" }
      ],
      "expect": { "tutorialStep": "hire-surveyor" }
    }
  ]
}
