          "type": "command",
          "command": "event fire union_coffee_uprising"
        }
      ],
      "description": "event fire union_coffee_uprising \u2014 test hook: `event fire` has no UI control and none is intended (a player cannot summon an event on demand). Left unmarked (legacy/unconstrained) rather than mislabelled."
    },
    {
      "command": "event choose 0",
      "interaction": [
        {
          "type": "awaitUsable",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "type": "screenshot"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-choice"
        },
        {
          "type": "awaitUsable",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        },
        {
          "type": "clickSelector",
          "selector": "#bs-event-dialog .bs-event-dismiss"
        }
      ],
      "role": "player",
      "expect": {
        "equals": {
          "cash": 42000
        },
        "increased": [
          "wellBeing"
        ],
        "note": "real click resolves union_coffee_uprising option 0 -- Lost $8000, wellBeing +12, matching the command-mode consequence text exactly"
      }
    },
    {
      "command": "tick 8",
