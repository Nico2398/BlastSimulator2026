{
 "spec": {
  "sample_rate": 44100,
  "trim_threshold_db": -55,
  "lead_ms": 2,
  "tail_ms": 8,
  "fade_in_ms": 2,
  "target_rms_db": -18,
  "gate_db": -50,
  "peak_ceiling_db": -1,
  "limiter_knee_db": -6,
  "max_overshoot_db": 6,
  "mp3": {
   "vbr_quality": 2
  }
 },
